# Per-host shell setup for agentsrv, sourced by jibin.bashrc.positron.dev.
# Rootless podman-static 5.8.4 for the claude-dev container (see
# ~/claude-container/claude-box, which exports the same variables itself).
# Kept off the shared PATH on purpose: alpha and sw-dev-01 use their own podman.
PODMAN_STATIC="$HOME/.local/opt/podman-static-5.8.4"
export PATH="$PODMAN_STATIC/usr/local/bin:$PATH"
export CONTAINERS_STORAGE_CONF="$HOME/.config/containers/storage-agentsrv.conf"
export CONTAINERS_CONF="$HOME/.config/containers/containers-agentsrv.conf"
export CONTAINERS_REGISTRIES_CONF="$PODMAN_STATIC/etc/containers/registries.conf"

# Ask once per interactive login shell whether to start the container and
# herdr. The question is deferred to just before the first prompt via
# PROMPT_COMMAND, so every startup file (and PATH) is complete before the
# user can press Ctrl-C. A Ctrl-C at a read inside a startup file would make
# bash abandon the rest of .bashrc and .profile (seen 2026-10-03).
if [[ $- == *i* && -t 0 && ${_HERDR_ASK_PID:-} != "$$" ]] && shopt -q login_shell; then
    _HERDR_ASK_PID=$$
    _herdr_ask() {
        # Disarm first so a Ctrl-C inside read cannot re-trigger the question.
        PROMPT_COMMAND=${PROMPT_COMMAND//_herdr_ask;/}
        PROMPT_COMMAND=${PROMPT_COMMAND//_herdr_ask/}
        unset -f _herdr_ask
        local reply
        read -r -p 'run claude-dev to start container and start herdr? Y/* ' reply || return 0
        if [[ $reply == [yY] ]]; then
            "$HOME/claude-container/claude-box" start && podman exec -it -e IS_SANDBOX=1 -w /home/jhan claude-dev bash -lic 'herdr --session "$(hostname)"; exec bash -l'
        fi
        return 0
    }
    PROMPT_COMMAND="_herdr_ask${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi
