# Per-host shell setup for agentsrv, sourced by jibin.bashrc.positron.dev.
# Rootless podman-static 5.8.4 for the claude-dev container (see
# ~/claude-container/claude-box, which exports the same variables itself).
# Kept off the shared PATH on purpose: alpha and sw-dev-01 use their own podman.
PODMAN_STATIC="$HOME/.local/opt/podman-static-5.8.4"
export PATH="$PODMAN_STATIC/usr/local/bin:$PATH"
export CONTAINERS_STORAGE_CONF="$HOME/.config/containers/storage-agentsrv.conf"
export CONTAINERS_CONF="$HOME/.config/containers/containers-agentsrv.conf"
export CONTAINERS_REGISTRIES_CONF="$PODMAN_STATIC/etc/containers/registries.conf"

if [[ $- == *i* && -t 0 && ${_HERDR_LOGIN_PID:-} != "$$" ]] && shopt -q login_shell; then
    _HERDR_LOGIN_PID=$$
    read -r -p 'run claude-dev to start container and start herdr? Y/* ' _herdr_reply
    [[ $_herdr_reply == [yY] ]] && "$HOME/claude-container/claude-box" start && podman exec -it -e IS_SANDBOX=1 -w /home/jhan claude-dev bash -lic 'herdr --session "$(hostname)"; exec bash -l'
    unset _herdr_reply
fi
