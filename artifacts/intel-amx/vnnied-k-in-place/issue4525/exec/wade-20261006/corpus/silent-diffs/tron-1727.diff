@@ -7,7 +7,7 @@ PERFETTO_HOME=$HOME/perfetto
 SELF_DIR=$(dirname "${BASH_SOURCE[0]}")
 
 # Where the alderaan repo lives. Assumes binaries are in a "gen" directory.
-ALDERAAN_HOME=$(dirname $SELF_DIR)
+ALDERAAN_HOME=$(dirname "$SELF_DIR")
 
 # Where the perfetto binaries live. These should not need to be changed.
 PERFETTO=$PERFETTO_HOME/out/linux/perfetto
@@ -23,13 +23,65 @@ RUNTRON=$ALDERAAN_HOME/gen/runtron
 # Where to put the final trace file. Change this to wherever you want.
 OUTPUT=$HOME/runtron.trace
 
+usage() {
+  printf '%s\n' \
+    "Usage: perfetto/tronperf [--output-file FILE] [--gen] [runtron args...]" \
+    "" \
+    "Options:" \
+    "  --output-file FILE  trace file for the perfetto client" \
+    "  -h, --help              show this help" \
+    "" \
+    "All other arguments are forwarded to runtron."
+}
+
+gen=false
+forward_args=()
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --output-file)
+      if [ "$#" -lt 2 ]; then
+        echo "error: --output-file requires a path" >&2
+        exit 2
+      fi
+      OUTPUT=$2
+      shift 2
+      ;;
+    --output-file=*)
+      OUTPUT="${1#*=}"
+      if [ "$OUTPUT" = "" ]; then
+        echo "error: --output-file requires a path" >&2
+        exit 2
+      fi
+      shift
+      ;;
+    -h | --help)
+      usage
+      exit 0
+      ;;
+    --)
+      shift
+      forward_args+=("--")
+      forward_args+=("$@")
+      break
+      ;;
+    --gen)
+      gen=true
+      shift
+      ;;
+    *)
+      forward_args+=("$1")
+      shift
+      ;;
+  esac
+done
+
 # Make sure user can read system traces. Copied from the tools/tmux program in the SDK.
 if [ ! -w /sys/kernel/tracing ]; then
   echo "tracefs not accessible, try sudo chown -R $USER /sys/kernel/tracing"
   sudo chown -R "$USER" /sys/kernel/tracing
 fi
 
-echo 0 > /sys/kernel/tracing/tracing_on
+echo 0 >/sys/kernel/tracing/tracing_on
 
 $TRACED &
 traced_pid=$!
@@ -37,7 +89,7 @@ traced_pid=$!
 $TRACED_PROBES &
