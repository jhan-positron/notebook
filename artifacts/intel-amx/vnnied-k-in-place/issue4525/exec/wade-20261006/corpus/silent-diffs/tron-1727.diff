-$PERFETTO --txt -c $CONFIG -o $OUTPUT &
+$PERFETTO --txt -c "$CONFIG" -o "$OUTPUT" &
 perfetto_pid=$!
 
 echo "traced running as PID $traced_pid"
@@ -45,28 +97,26 @@ echo "traced_probes running as PID $traced_probes_pid"
