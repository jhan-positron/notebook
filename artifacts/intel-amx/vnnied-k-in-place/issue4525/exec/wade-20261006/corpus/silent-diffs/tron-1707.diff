diff --git a/src/pos/debug.cpp b/src/pos/debug.cpp
new file mode 100644
index 00000000000..5834009f742
--- /dev/null
+++ b/src/pos/debug.cpp
@@ -0,0 +1,66 @@
+#include <iomanip>
+#include <sstream>
+#include <string>
+
+#include "tron/numerics.hpp"
+#include "tron/spdlog.hpp"
+
+void debug_hexdump(std::string preface, void* src, size_t len, int linelen) noexcept {
+  auto start = reinterpret_cast<unsigned char const*>(src);
+  // spdlog::debug("src=={}, *src==0x{:016x}", static_cast<void const*>(start),
+  // *reinterpret_cast<uint64_t const *>(src));
+  for (unsigned char const* cpt = start; cpt < start + (len); cpt += linelen) {
+    std::stringstream aline;
+    aline << preface << "> ";
+    for (ptrdiff_t lc = 0; lc < linelen; ++lc) {
+      // << " ";
+      aline << std::hex << std::setfill('0') << std::setw(2) << uint16_t(*(cpt + lc));
+    }
+    spdlog::debug("{}> {} ", static_cast<void const*>(cpt), aline.str());
+  }
+}
+
+void debug_bf16dump(std::string preface, void* src, size_t len, int linelen) noexcept {
+  auto start = reinterpret_cast<tron::bf16*>(src);
+  // spdlog::debug("src=={}, *src==0x{:016x}", static_cast<void const*>(start),
+  // *reinterpret_cast<uint64_t const *>(src));
+  for (tron::bf16* cpt = start; cpt < start + (len / 2); cpt += linelen) {
+    std::stringstream aline;
+    aline << preface << "> ";
+    for (ptrdiff_t lc = 0; lc < linelen; ++lc) {
+      tron::bf16 outval = (volatile tron::bf16) * (cpt + lc);
+      aline << std::setw(10) << outval << " ";
+    }
+    spdlog::debug("{}> {} ", static_cast<void const*>(cpt), aline.str());
+  }
+}
+void debug_wtdump(std::string preface, void* src, size_t len, int linelen) noexcept {
+  auto start = reinterpret_cast<unsigned char*>(src);
+  size_t bsize = 576;
+  size_t blocks = (len + 575) / bsize;
+  spdlog::debug("Dumping {} weight blocks", blocks);
+  for (size_t wblock = 0; wblock < blocks; wblock++) {
+    auto sstart = reinterpret_cast<tron::bf16*>(start + (wblock * bsize));
+    auto wstart = start + (wblock * bsize) + 64;
+    // for wtdump we always spit out two lines of scale data in bf16
+    for (tron::bf16* cpt = sstart; cpt < sstart + 16; cpt += 16) {
+      std::stringstream aline;
+      aline << preface << "> ";
+      for (ptrdiff_t lc = 0; lc < 32; ++lc) {
+        aline << std::setw(10) << tron::bf16(*(cpt + lc)) << " ";
+      }
+      spdlog::debug("{}> {} ", static_cast<void const*>(cpt), aline.str());
+    }
+    for (unsigned char const* cpt = wstart; cpt < wstart + (bsize - 64);
+        cpt += linelen) {
+      std::stringstream aline;
+      aline << preface << "> ";
+      for (ptrdiff_t lc = 0; lc < linelen; ++lc) {
+        // << " ";
+        aline << std::hex << std::setfill('0') << std::setw(2) << uint16_t(*(cpt + lc))
+              << " ";
+      }
+      spdlog::debug("{}> {} ", static_cast<void const*>(cpt), aline.str());
+    }
+  }
+}
