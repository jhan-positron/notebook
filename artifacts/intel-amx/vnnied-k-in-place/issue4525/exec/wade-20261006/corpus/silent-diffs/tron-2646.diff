 template <bool present, typename T>
 using static_option = std::conditional_t<present, T, missing_t>;
 
+TRON(inline)
+double relerr(double trueValue, double approxValue) {
+  if (trueValue == 0.0) {
+    if (approxValue == 0.0) {
+      return 0.0;
+    } else {
+      return std::numeric_limits<double>::infinity();
+    }
+  }
+  return std::abs((trueValue - approxValue) / trueValue);
+}
+
+TRON(inline)
+double abserr(double trueValue, double approxValue) {
+  // handle nan and infinite cases
+  if (std::isnan(trueValue) || std::isnan(approxValue)) {
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+  // standard seems to be matching inf is 0 opposite is inf
+  if (std::isinf(trueValue) || std::isinf(approxValue)) {
+    if (trueValue == approxValue) return 0.0;
+    return std::numeric_limits<double>::infinity();
+  }
+  return std::abs(trueValue - approxValue);
+}
+
+TRON(inline)
+std::pair<double, double> comberr(double trueValue, double approxValue) {
+  return {abserr(trueValue, approxValue), relerr(trueValue, approxValue)};
+}
