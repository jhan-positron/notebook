+}
 
+// convert 8 fp16 values to 8 bf16 values via fp32
+// ~12-15 cycles (fp16->fp32 is ~4-5 cycles, fp32->bf16 is ~8-10 cycles)
+// Note: this lives here rather than in fp16.hpp to avoid circular dependencies.
+TRON(nodiscard, inline, const)
+bf16x8 fp16s_to_bf16s(fp16x8 x) noexcept {
+  fp32x8 fp32_intermediate = fp16s_to_fp32s(x);
+  return fp32s_to_bf16s(fp32_intermediate);
+}
