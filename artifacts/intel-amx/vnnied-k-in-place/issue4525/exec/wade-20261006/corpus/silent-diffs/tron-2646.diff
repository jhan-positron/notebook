+// ~6-9 cycles (bf16->fp32 is ~2-4 cycles, fp32->fp16 is ~4-5 cycles)
+TRON(nodiscard, inline, const)
+fp16x8 bf16s_to_fp16s(bf16x8 x) noexcept {
+  fp32x8 fp32_intermediate = bf16s_to_fp32s(x);
