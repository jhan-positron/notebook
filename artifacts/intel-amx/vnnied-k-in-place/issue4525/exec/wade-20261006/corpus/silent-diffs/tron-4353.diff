+          base_load[w] = 0;
+          for (const kv_section& s : plan_state.ready_kv_plan[w])
+            base_load[w] += section_cost(s);
+          if (pending)
+            for (const kv_section& s : plan_state.pending_kv_plan[w])
+              base_load[w] += section_cost(s);
