@@ -0,0 +1,74 @@
+#include "pos/assert.hpp"
+#include "pos/hwattention.hpp"
+
+// #define DEBUG_SAVE_KV 1
+#ifdef DEBUG_SAVE_KV
+#define dbg_savekv_log(...) spdlog::debug(__VA_ARGS__)
+#else
+#define dbg_savekv_log(...)
+#endif
+
+namespace tron::hardware {
+
+void save_k_to_hardware(bf16* k_data,
+    size_t tok_ix,
+    size_t n_kv_heads,
+    size_t layer,
+    size_t head_size) noexcept {
+  if ((n_kv_heads > 32) || (layer > 31) || (head_size != 128)) {
+    spdlog::error("{} invalid parameter passed in tok_ix {}, n_kv_heads {}, layer {}, "
+                  "head_size {}",
+        __FUNCTION__, tok_ix, n_kv_heads, layer, head_size);
+  }
+
+  TRON_ASSERT((layer <= 32), "layer value given is not valid!  {} > 31", layer);
+  TRON_ASSERT((head_size <= 128), "Head size given is not valid! {} > 128", head_size);
+  TRON_ASSERT((tok_ix < hwkv_max_tok_ix),
+      "HWKV cache size exceeded!  tok_ix: {} >=  hwkv_max_tok_ix: {}", tok_ix,
+      hwkv_max_tok_ix);
+
+  // Extract per-head pointers from the intermediate data
+  bf16* k_head_ptrs[32];  // allocate 32 slots for kv head ptrs, even if we use fewer.
+  for (size_t kv_head = 0; kv_head < n_kv_heads; ++kv_head) {
+    dbg_savekv_log("save_k_to_hardware: tok {} head {} addr {}", tok_ix, kv_head,
+        (void*)(k_data + (kv_head * head_size)));
+    k_head_ptrs[kv_head] = k_data + (kv_head * head_size);
+  }
+
+  // Call the existing hardware transfer function
+  xfer_k_entry_blocking(
+      k_head_ptrs, (uint32_t)tok_ix, (uint32_t)n_kv_heads, layer, head_size);
+}
+
+void save_v_to_hardware(bf16* v_data,
+    size_t tok_ix,
+    size_t n_kv_heads,
+    size_t layer,
+    size_t head_size) noexcept {
+
+  if ((n_kv_heads > 32) || (layer > 31) || (head_size != 128)) {
+    spdlog::error("{} invalid parameter passed in tok_ix {}, n_kv_heads {}, layer {}, "
+                  "head_size {}",
+        __FUNCTION__, tok_ix, n_kv_heads, layer, head_size);
+  }
+
+  TRON_ASSERT((layer <= 32), "layer value given is not valid!  {} > 31", layer);
+  TRON_ASSERT((head_size <= 128), "Head size given is not valid! {} > 128", head_size);
+  TRON_ASSERT((tok_ix < hwkv_max_tok_ix),
+      "HWKV cache size exceeded!  tok_ix: {} >=  hwkv_max_tok_ix: {}", tok_ix,
+      hwkv_max_tok_ix);
+
+  // Extract per-head pointers from the intermediate data
+  bf16* v_head_ptrs[32];  // allocate 32 slots for kv head ptrs, even if we use fewer.
+  for (size_t kv_head = 0; kv_head < n_kv_heads; ++kv_head) {
+    dbg_savekv_log("save_v_to_hardware: tok {} head {} addr {}", tok_ix, kv_head,
+        (void*)(v_data + (kv_head * head_size)));
+    v_head_ptrs[kv_head] = v_data + (kv_head * head_size);
+  }
+
+  // Call the existing hardware transfer function
+  xfer_v_entry_blocking(
+      v_head_ptrs, (uint32_t)tok_ix, (uint32_t)n_kv_heads, layer, head_size);
+}
+
+}  // namespace tron::hardware
