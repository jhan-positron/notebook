+template <size_t n_layers, size_t n_kv_heads, size_t head_size, size_t x_bytes>
+TRON(inline)
+void page<n_layers, n_kv_heads, head_size, x_bytes>::get_v(
+    size_t layer, size_t kv_head, size_t i_page, bf16* vout_ptr) const noexcept
+  requires(head_size % 32 == 0)
+{
+  const bf16* v_ptr =
+      reinterpret_cast<const bf16*>(kv_block(layer, kv_head).v[i_page / 2]);
+  if (i_page % 2 == 0) {
+    for (size_t i = 0; i < head_size; i += 16) {
+      // f 7 e 6 d 5 c 4 b 3 a 2 9 1 8 0
+      bf16x32 both = _mm512_load_si512(v_ptr + i * 2);
+      // 7 6 5 4 3 2 1 0
+      __m256i lo = _mm512_cvtepi32_epi16(both);
+      _mm256_store_si256(reinterpret_cast<__m256i*>(vout_ptr + i), lo);
+    }
+  } else {
+    for (size_t i = 0; i < head_size; i += 16) {
+      // f 7 e 6 d 5 c 4 b 3 a 2 9 1 8 0
+      bf16x32 both = _mm512_load_si512(v_ptr + i * 2);
+      // f e d c b a 9 8
+      __m256i hi = _mm512_cvtepi32_epi16(_mm512_srli_epi32(both, 16));
+      _mm256_store_si256(reinterpret_cast<__m256i*>(vout_ptr + i), hi);
+    }
+  }
