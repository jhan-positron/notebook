index 00000000000..d9b1132cc7a
--- /dev/null
+++ b/h/common/fixed_string.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <cstddef>
+
+namespace tron {
+
+// A compile-time string usable as a non-type template parameter. Enables
+// passing a string literal as a template argument so downstream code can
+// derive `constexpr` artefacts (e.g. per-instance debug labels) without
+// any runtime allocation. Construct directly from a string literal:
+// `template <fixed_string Name> struct X { ... };  X<"foo"> x;`
+template <std::size_t N>
+struct fixed_string {
+  char data[N]{};
+  constexpr fixed_string(const char (&s)[N]) {
+    for (std::size_t i = 0; i < N; ++i)
+      data[i] = s[i];
+  }
+  constexpr const char* c_str() const {
+    return data;
+  }
+  static constexpr std::size_t size = N - 1;  // excludes terminating null
+};
+template <std::size_t N>
+fixed_string(const char (&)[N]) -> fixed_string<N>;
+
+}  // namespace tron
