+namespace expert_label_detail {
+// Compile-time storage for "<Base>[expert <I>]\0". `value.data()` has
+// program lifetime.
+template <fixed_string Base, size_t I>
+struct one {
+  static constexpr auto fmt_str = FMT_COMPILE("{} [expert {}]");
+  static constexpr size_t size = fmt::formatted_size(fmt_str, Base.c_str(), I) + 1;
+  static constexpr auto value = []() {
+    std::array<char, size> a{};
+    auto end = fmt::format_to(a.data(), fmt_str, Base.c_str(), I);
+    *end = '\0';
+    return a;
+  }();
+};
+
+template <fixed_string Base, size_t N, size_t... Is>
+constexpr std::array<const char*, N> make_table(std::index_sequence<Is...>) {
+  return {one<Base, Is>::value.data()...};
+}
+}  // namespace expert_label_detail
+
+// Compile-time table of `const char*` labels, one per expert, with
+// program-lifetime storage.
+template <fixed_string Base, size_t N>
+inline constexpr auto expert_labels =
+    expert_label_detail::make_table<Base, N>(std::make_index_sequence<N>{});
