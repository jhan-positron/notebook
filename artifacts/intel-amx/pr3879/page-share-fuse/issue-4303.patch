+TEST_CASE("page-share FUSE leaves expose live read-only totals", "[page_share]") {
+  using tron::fuse::stats;
+  using namespace tron::page_share;
+
+  stats::unmount();
+  stats::unmount_guard guard;
+  register_fuse_stats();
+  CHECK_FALSE(stats::is_initialized());
+
+  // initialize() alone does not mount or touch the directory. Registration and
+  // get_value() exercise the same callbacks used by live FUSE reads.
+  stats::initialize(std::filesystem::temp_directory_path().string());
+  register_fuse_stats();
+
+  const std::array<const char*, 5> names = {"page_visits", "relevant_query_tokens",
+      "shared_visits", "shared_tokens", "pending_visits"};
+  using file_handle = tron::fuse::fuse_sysfs::file_handle;
+  std::array<std::shared_ptr<file_handle>, 5> leaves;
+  const auto read_counter = [](const std::shared_ptr<file_handle>& leaf) {
+    const auto value = leaf->get_value();
+    REQUIRE(std::holds_alternative<uint64_t>(value));
+    return std::get<uint64_t>(value);
+  };
+  std::array<uint64_t, 5> before;
+  for (std::size_t i = 0; i < names.size(); ++i) {
+    leaves[i] =
+        stats::get_file_handle(std::string("/rinzler/stats/page_share/") + names[i]);
+    REQUIRE(leaves[i]);
+    CHECK(leaves[i]->is_read_only());
+    before[i] = read_counter(leaves[i]);
+  }
+
+  const auto histogram = stats::get_file_handle("/rinzler/stats/page_share/histogram");
+  REQUIRE(histogram);
+  CHECK(histogram->is_read_only());
+  const auto read_histogram = [&] {
+    const auto value = histogram->get_value();
+    REQUIRE(std::holds_alternative<std::string>(value));
+    const auto parsed = tron::json::parse(std::get<std::string>(value));
+    REQUIRE(parsed.is_array());
+    REQUIRE(parsed.size() == HISTOGRAM_SLOTS_7);
+    for (const auto& count : parsed) {
+      REQUIRE(count.is_number_unsigned());
+    }
+    return parsed.get<std::array<uint64_t, HISTOGRAM_SLOTS_7>>();
+  };
+  const auto histogram_before = read_histogram();
+
+  // Distinct bucket counts expose reordered JSON slots as well as stale values.
+  page_visit_counts counts;
+  counts.record_page_visit(0, /*is_pending=*/true);
+  const std::array<uint64_t, 7> query_counts = {1, 2, 3, 4, 8, 16, 17};
+  for (std::size_t i = 0; i < query_counts.size(); ++i) {
+    for (std::size_t visit = 0; visit <= i; ++visit) {
+      counts.record_page_visit(query_counts[i], /*is_pending=*/i == 2);
+    }
+  }
+  counts.flush();
+
+  const std::array<uint64_t, 5> expected = {28, 285, 27, 284, 3};
+  for (std::size_t i = 0; i < names.size(); ++i) {
+    CHECK(read_counter(leaves[i]) - before[i] == expected[i]);
+  }
+  const std::array<uint64_t, HISTOGRAM_SLOTS_7> expected_histogram = {
+      1, 2, 3, 4, 5, 6, 7};
+  const auto histogram_after = read_histogram();
+  for (std::size_t i = 0; i < expected_histogram.size(); ++i) {
+    CHECK(histogram_after[i] - histogram_before[i] == expected_histogram[i]);
+  }
+}
