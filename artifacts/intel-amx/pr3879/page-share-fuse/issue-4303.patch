+TEST_CASE(
+    "page-share runtime opt-in requires exactly 1 and is cached", "[page_share]") {
+  // Each child gets its own first enabled() call and leaves the parent cache
+  // and environment untouched, so Catch2 case ordering does not affect this.
+  struct runtime_case {
+    const char* setting;
+    bool expected;
+  };
+  const std::array<runtime_case, 6> settings = {{{nullptr, false}, {"", false},
+      {"0", false}, {"1", true}, {"true", false}, {"01", false}}};
+  for (const auto& [setting, expected] : settings) {
+    const pid_t child = ::fork();
+    REQUIRE(child >= 0);
+    if (child == 0) {
+      const int result = setting == nullptr
+                             ? ::unsetenv("TRON_PAGE_SHARE_COUNTERS")
+                             : ::setenv("TRON_PAGE_SHARE_COUNTERS", setting, 1);
+      if (result != 0) ::_exit(1);
+      if (tron::page_share::enabled() != expected) ::_exit(2);
+      if (::setenv("TRON_PAGE_SHARE_COUNTERS", expected ? "0" : "1", 1) != 0)
+        ::_exit(3);
+      ::_exit(tron::page_share::enabled() == expected ? 0 : 4);
+    }
+    int status = 0;
+    pid_t waited;
+    do {
+      waited = ::waitpid(child, &status, 0);
+    } while (waited < 0 && errno == EINTR);
+    REQUIRE(waited == child);
+    REQUIRE(WIFEXITED(status));
+    CHECK(WEXITSTATUS(status) == 0);
+  }
+}
