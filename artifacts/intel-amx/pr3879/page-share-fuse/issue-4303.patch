 namespace tron::page_share {
 
+// Cache once per process, rather than once per attention template instantiation.
+// Only the hook sites consult this switch; direct accumulator use is unchanged.
+inline bool enabled() {
+  static const bool collect = [] {
+    const char* value = std::getenv("TRON_PAGE_SHARE_COUNTERS");
+    return value && std::string_view(value) == "1";
+  }();
+  return collect;
+}
