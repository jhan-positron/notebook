 // Process-wide totals, summed over every apply_page_range call of every
 // attention worker. Each has a per-call counterpart of the same name without
 // the total_ prefix in page_visit_counts below.
@@ -62,6 +80,39 @@ inline std::atomic<uint64_t> total_shared_tokens;
 // work] in model.hpp and Note [Minibatch Dependency Tracking] in common.hpp.
 inline std::atomic<uint64_t> total_pending_visits;
 
+// Register before stats::start(). These casual leaves expose cumulative counts;
+// subtract two reads to measure an interval. Each atomic is read independently,
+// so concurrent flushes may make the values disagree across a live snapshot.
+inline void register_fuse_stats() {
+  if (!fuse::stats::is_initialized()) return;
+  using value_t = fuse::fuse_sysfs::value_type;
+  const std::string prefix = "/rinzler/stats/page_share/";
+  auto make_total = [&](const char* name, std::atomic<uint64_t>& total) {
+    auto handle = fuse::stats::make_file(prefix + name, uint64_t{0},
+        /*read_only=*/true);
+    handle->set_read_callback([&total](const std::string&, const value_t&) {
+      return value_t(total.load(std::memory_order_relaxed));
+    });
+  };
+  make_total("page_visits", total_page_visits);
+  make_total("relevant_query_tokens", total_relevant_query_tokens);
+  make_total("shared_visits", total_shared_visits);
+  make_total("shared_tokens", total_shared_tokens);
+  make_total("pending_visits", total_pending_visits);
+
+  auto histogram = fuse::stats::make_file(prefix + "histogram", std::string{"[]"},
+      /*read_only=*/true);
+  histogram->set_read_callback([](const std::string&, const value_t&) {
+    std::string out = "[";
+    for (int i = 0; i < HISTOGRAM_SLOTS_7; ++i) {
+      if (i) out += ',';
+      out += std::to_string(total_histogram[i].load(std::memory_order_relaxed));
+    }
+    out += ']';
+    return value_t(out);
+  });
+}
