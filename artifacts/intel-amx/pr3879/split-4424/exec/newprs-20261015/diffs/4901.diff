+#else
+    REQUIRE(converted_blocks() == 0);
+#endif
+  }
+
+  SECTION("hardware-scored operation: the completed block stays row-major") {
+    auto model = std::make_unique<heterogeneous_model>(
+        std::filesystem::path{}, json(json::value_t::object));
+    model_config cfg;
