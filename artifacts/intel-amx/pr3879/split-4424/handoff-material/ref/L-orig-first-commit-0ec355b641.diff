index 0000000000..90f0ed2793
--- /dev/null
+++ b/h/tron/kernels/k_vnni.hpp
@@ -0,0 +1,182 @@
+#pragma once
+// K stored in the VNNI pair-interleaved layout, in place of the row-major K
+// plane: the index map, the per-token store (scatter) and load (gather), and
+// the AVX-512 QK reader that serves partial pages and the AMX kill switch.
+// Everything here is AVX-512 (no AMX instruction), so any translation unit may
+// include it. The layout itself, who writes it and who reads it are described
+// in Note [K VNNI storage] (in kv_cache.hpp).
+//
+// Words used here: VNNI (Vector Neural Network Instructions) layout means that
+// the two values of a dim pair of one token are stored next to each other, and
+// one 64-byte row holds that dim pair for 16 consecutive tokens. It is the
+// B-operand layout of the AMX tile multiply (TDPBF16PS) and the operand layout
+// of the AVX-512 pair dot product (VDPBF16PS). A KV page holds 64 tokens; the
+// layout exists for 128-dim heads only.
+//
+// Plane layout (64 tokens x 128 dims of bf16 = 16 KiB, the same bytes as the
+// row-major plane), indexed by dim step s (32 dims), token block c (16
+// tokens), dim pair dp and token t:
+//   plane[(((s * 4 + c) * 16 + dp) * 16 + t) * 2 + j] == K[c * 16 + t][s * 32 + 2 * dp + j]
+// One (s, c) is one 1 KiB panel: 16 dim-pair rows of 64 bytes, exactly one
+// AMX B tile. Token i owns column (i % 16) of token block (i / 16) in every
+// panel, so tokens are written independently (no read-modify-write between
+// tokens, unlike the pair-interleaved V plane).
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <immintrin.h>
+#include <type_traits>
+
+#include "common/attributes.hpp"
+#include "common/numerics/bf16.hpp"
+#include "common/numerics/fp16.hpp"
+
+namespace tron::k_vnni {
+
+inline constexpr size_t PAGE_TOKENS_64 = 64;
+inline constexpr size_t HEAD_SIZE_128 = 128;
+// One panel = 16 dim-pair rows x 16 tokens x 2 paired values (1 KiB).
+inline constexpr size_t PANEL_ELEMS_512 = 16 * 16 * 2;
+inline constexpr size_t PANEL_BYTES_1024 = PANEL_ELEMS_512 * sizeof(bf16);
+inline constexpr size_t N_PANELS_16 = (HEAD_SIZE_128 / 32) * (PAGE_TOKENS_64 / 16);
+static_assert(N_PANELS_16 * PANEL_ELEMS_512 == PAGE_TOKENS_64 * HEAD_SIZE_128,
+    "the VNNI plane is a permutation of the row-major plane: same element count");
+
+// The layout gate. TRON_K_VNNI (CMake option) switches the K plane of every
+// 128-dim head to the VNNI layout; every other head size keeps the row-major
+// plane. The gate is a property of the storage geometry, not of the query
+// type or of the AMX availability, so every reader and writer of a slot sees
+// the same layout.
+#ifdef TRON_K_VNNI
+template <size_t head_size>
+inline constexpr bool layout_on = head_size == HEAD_SIZE_128;
+#else
+template <size_t head_size>
+inline constexpr bool layout_on = false;
+#endif
+
+// Element index of K[token][dim] inside the plane (the formula of the header
+// comment).
+constexpr size_t index(size_t token, size_t dim) noexcept {
+  const size_t s = dim / 32, c = token / 16, dp = (dim % 32) / 2, t = token % 16,
+               j = dim % 2;
+  return (((s * (PAGE_TOKENS_64 / 16) + c) * 16 + dp) * 16 + t) * 2 + j;
+}
+
+namespace detail {
+// The byte address of dim pair 0 of dim step s for token `token`: the pair
+// rows dp = 0..15 of that panel follow at 64-byte steps.
+TRON(inline)
+char* pair_base(bf16* plane, size_t s, size_t token) noexcept {
+  const size_t c = token / 16, t = token % 16;
+  return reinterpret_cast<char*>(plane) + ((s * 4 + c) * 256 + t) * 4;
+}
+TRON(inline)
+const char* pair_base(const bf16* plane, size_t s, size_t token) noexcept {
+  const size_t c = token / 16, t = token % 16;
+  return reinterpret_cast<const char*>(plane) + ((s * 4 + c) * 256 + t) * 4;
+}
+// Dword offsets of the 16 pair rows of one panel (64 bytes = 16 dwords apart).
+TRON(inline)
+__m512i pair_row_offsets() noexcept {
+  return _mm512_set_epi32(15 * 16, 14 * 16, 13 * 16, 12 * 16, 11 * 16, 10 * 16, 9 * 16,
+      8 * 16, 7 * 16, 6 * 16, 5 * 16, 4 * 16, 3 * 16, 2 * 16, 1 * 16, 0);
+}
+}  // namespace detail
+
+// Store one token's 128-dim K row into the plane: 4 scatters of 16 dwords
+// (one dim pair each), one per dim step. Only this token's 64 pair slots are
+// written.
+TRON(inline)
+void scatter_row(bf16* plane, size_t token, const bf16* row) noexcept {
+  const __m512i offsets = detail::pair_row_offsets();
+  for (size_t s = 0; s < HEAD_SIZE_128 / 32; ++s) {
+    const __m512i pairs = _mm512_loadu_si512(row + s * 32);
+    _mm512_i32scatter_epi32(detail::pair_base(plane, s, token), offsets, pairs, 4);
+  }
+}
+
+// Load one token's 128-dim K row out of the plane (the inverse of
+// scatter_row): 4 gathers of 16 dwords.
+TRON(inline)
+void gather_row(const bf16* plane, size_t token, bf16* row) noexcept {
+  const __m512i offsets = detail::pair_row_offsets();
+  for (size_t s = 0; s < HEAD_SIZE_128 / 32; ++s) {
+    const __m512i pairs =
+        _mm512_i32gather_epi32(offsets, detail::pair_base(plane, s, token), 4);
+    _mm512_storeu_si512(row + s * 32, pairs);
+  }
+}
+
+// Scores of one query group against the live tokens of one page, read from
+// the VNNI plane with AVX-512: s[h * s_stride + t] = q_h . K_t (UNSCALED) for
+// every token t whose bit is set in `live`; the other entries of s are left
+// untouched (the caller keeps them at -inf). The K storage of a token whose
+// bit is clear is never read (masked loads), so unwritten tokens cannot
+// contaminate the result. Token lanes: one 64-byte load supplies one dim pair
+// of 16 tokens, the query's dim pair is broadcast, and VDPBF16PS accumulates
+// 16 scores at once, so no horizontal reduction and no per-token gather.
+// q points at kv_mul rows of 128 values (the group's heads, row stride 128).
+//   bf16 q: exact bf16 x bf16 products added in fp32 by VDPBF16PS, the same
+//     instruction the row-major dotter<bf16, 128> uses (only the order of the
+//     fp32 adds differs; see Note [AMX attention dispatch]).
+//   float q: the stored bf16 K values are widened to fp32 exactly (a shift)
+//     and multiplied by the fp32 query with FMA, as dotter<float, 128> does.
+//   fp16 q: widened to fp32 once per call, then the float path.
+template <size_t kv_mul, typename q_scalar>
+TRON(inline)
+void qk_group(const bf16* plane,
+    const q_scalar* q,
+    uint64_t live,
+    float* s,
+    size_t s_stride) noexcept {
+  static_assert(kv_mul >= 1 && kv_mul <= 16, "one accumulator register per head");
+  if constexpr (std::is_same_v<q_scalar, fp16>) {
+    alignas(64) float qf[kv_mul * HEAD_SIZE_128];
+    for (size_t i = 0; i < kv_mul * HEAD_SIZE_128; ++i) qf[i] = float(q[i]);
+    qk_group<kv_mul, float>(plane, qf, live, s, s_stride);
+    return;
+  }
+  static_assert(std::is_same_v<q_scalar, bf16> || std::is_same_v<q_scalar, float>,
+      "the VNNI-K reader serves bf16, float and fp16 queries");
+  for (size_t c = 0; c < PAGE_TOKENS_64 / 16; ++c) {
+    const __mmask16 mask = __mmask16(live >> (c * 16));
+    if (mask == 0) continue;
+    __m512 acc[kv_mul];
+    for (size_t h = 0; h < kv_mul; ++h) acc[h] = _mm512_setzero_ps();
+    for (size_t step = 0; step < HEAD_SIZE_128 / 32; ++step) {
+      const bf16* panel = plane + (step * 4 + c) * PANEL_ELEMS_512;
+      for (size_t dp = 0; dp < 16; ++dp) {
+        // One dim pair of the 16 tokens of this block; lanes of dead tokens
+        // are zero and never loaded.
+        const __m512i k_pairs = _mm512_maskz_loadu_epi32(mask, panel + dp * 32);
+        const size_t d = step * 32 + 2 * dp;
+        if constexpr (std::is_same_v<q_scalar, bf16>) {
+          for (size_t h = 0; h < kv_mul; ++h) {
+            uint32_t q_pair;
+            std::memcpy(&q_pair, q + h * HEAD_SIZE_128 + d, sizeof(q_pair));
+            acc[h] = _mm512_dpbf16_ps(
+                acc[h], (__m512bh)_mm512_set1_epi32(int(q_pair)), (__m512bh)k_pairs);
+          }
+        } else {
+          // Even dims sit in the low halves of the dwords, odd dims in the
+          // high halves; each becomes an exact fp32 with a shift or a mask.
+          const __m512 k_even = _mm512_castsi512_ps(_mm512_slli_epi32(k_pairs, 16));
+          const __m512 k_odd = _mm512_castsi512_ps(
+              _mm512_and_si512(k_pairs, _mm512_set1_epi32(int(0xffff0000u))));
+          for (size_t h = 0; h < kv_mul; ++h) {
+            acc[h] = _mm512_fmadd_ps(
+                _mm512_set1_ps(q[h * HEAD_SIZE_128 + d]), k_even, acc[h]);
+            acc[h] = _mm512_fmadd_ps(
+                _mm512_set1_ps(q[h * HEAD_SIZE_128 + d + 1]), k_odd, acc[h]);
+          }
+        }
+      }
+    }
+    for (size_t h = 0; h < kv_mul; ++h)
+      _mm512_mask_storeu_ps(s + h * s_stride + c * 16, mask, acc[h]);
+  }
+}
+
+}  // namespace tron::k_vnni
