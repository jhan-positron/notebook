+
+// S[16 q][64 tok] = Q . K^T with K read from the VNNI plane as the B operand
+// (see the declaration and Note [K VNNI storage] in kv_cache.hpp). A = the
+// padded Q rows (16 rows x 32 dims per step, row stride 256 bytes); B = one
+// K panel per (step, token block): 16 dim-pair rows x 16 tokens, 64-byte
+// rows; C tiles 0..3 = the four 16-token blocks.
+void qk_vnni_128x4(const bf16* k_vnni_plane,
+    const bf16* q_rows,
+    float* s,
+    size_t s_stride_floats) noexcept {
+  // The tile stores write 16 rows (Note [Tile stores write 16 rows]); rows
+  // 4..15 are the products of the zero padding rows and are dropped below.
+  alignas(64) float s16[TILE_ROWS_16 * PAGE_TOKENS_64];
+  constexpr size_t S16_ROW_BYTES = PAGE_TOKENS_64 * sizeof(float);
+  // One K panel = 16 dim-pair rows x 16 tokens x 2 paired values (1 KiB);
+  // panel (step, block) sits at (step * 4 + block) panels from the plane base
+  // (the k_vnni.hpp layout).
+  constexpr size_t PANEL_ELEMS = TILE_ROWS_16 * TILE_ROWS_16 * 2;
+  _tile_zero(0);
+  _tile_zero(1);
+  _tile_zero(2);
+  _tile_zero(3);
+  for (size_t step = 0; step < HEAD_SIZE_128 / DIM_STEP_32; step++) {
+    _tile_loadd(4 /* dest tile */, q_rows + step * DIM_STEP_32, BF16_ROW_BYTES);
+    _tile_loadd(5 /* dest tile */, k_vnni_plane + (step * 4 + 0) * PANEL_ELEMS,
+        TILE_ROW_BYTES_64);
+    _tile_dpbf16ps(0 /* dest tile */, 4 /* src tile 0 */, 5 /* src tile 1 */);
+    _tile_loadd(6 /* dest tile */, k_vnni_plane + (step * 4 + 1) * PANEL_ELEMS,
+        TILE_ROW_BYTES_64);
+    _tile_dpbf16ps(1 /* dest tile */, 4 /* src tile 0 */, 6 /* src tile 1 */);
+    _tile_loadd(5 /* dest tile */, k_vnni_plane + (step * 4 + 2) * PANEL_ELEMS,
+        TILE_ROW_BYTES_64);
+    _tile_dpbf16ps(2 /* dest tile */, 4 /* src tile 0 */, 5 /* src tile 1 */);
+    _tile_loadd(6 /* dest tile */, k_vnni_plane + (step * 4 + 3) * PANEL_ELEMS,
+        TILE_ROW_BYTES_64);
+    _tile_dpbf16ps(3 /* dest tile */, 4 /* src tile 0 */, 6 /* src tile 1 */);
+  }
+  _tile_stored(0 /* src tile */, s16 + 0, S16_ROW_BYTES);
+  _tile_stored(1 /* src tile */, s16 + 16, S16_ROW_BYTES);
+  _tile_stored(2 /* src tile */, s16 + 32, S16_ROW_BYTES);
+  _tile_stored(3 /* src tile */, s16 + 48, S16_ROW_BYTES);
+  for (size_t r = 0; r < GROUP_HEADS_4; r++) {
+    std::memcpy(s + r * s_stride_floats, s16 + r * PAGE_TOKENS_64, S16_ROW_BYTES);
+  }
