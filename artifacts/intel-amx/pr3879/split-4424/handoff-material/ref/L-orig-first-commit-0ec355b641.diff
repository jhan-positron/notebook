index 0000000000..ebef88e101
--- /dev/null
+++ b/t/t_k_vnni_layout.cpp
@@ -0,0 +1,271 @@
+// The VNNI K storage layout (Note [K VNNI storage] in kv_cache.hpp): the index
+// map and the per-token store / load primitives are exact, the AVX-512 reader
+// of that layout does not digress from the row-major dotter, and the
+// layout-agnostic page accessors and page copies move tokens correctly.
+// No AMX instruction runs here, so every case runs on every host; the cases
+// that need a VNNI slot (the book-level ones under TRON_K_VNNI) exercise the
+// row-major layout in the other build, where they check the same contract.
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <random>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include "common/numerics/bf16.hpp"
+#include "tron/kernels/dotter.hpp"
+#include "tron/kernels/k_vnni.hpp"
+#include "tron/models/kv_cache.hpp"
+
+namespace {
+
+using tron::k_vnni::HEAD_SIZE_128;
+using tron::k_vnni::PAGE_TOKENS_64;
+
+uint16_t bf16_rne(float f) {
+  uint32_t bits;
+  std::memcpy(&bits, &f, 4);
+  bits += 0x7fffu + ((bits >> 16) & 1u);
+  return static_cast<uint16_t>(bits >> 16);
+}
+
+float bf16_to_float(uint16_t b) {
+  uint32_t bits = static_cast<uint32_t>(b) << 16;
+  float f;
+  std::memcpy(&f, &bits, 4);
+  return f;
+}
+
+struct alignas(64) plane_and_rows {
+  tron::bf16 plane[PAGE_TOKENS_64 * HEAD_SIZE_128];
+  tron::bf16 rows[PAGE_TOKENS_64 * HEAD_SIZE_128];  // the same K, one row per token
+};
+
+// The documented layout formula, written out independently of k_vnni::index.
+size_t documented_index(size_t token, size_t dim) {
+  const size_t s = dim / 32, c = token / 16, dp = (dim % 32) / 2, t = token % 16,
+               j = dim % 2;
+  return (((s * 4 + c) * 16 + dp) * 16 + t) * 2 + j;
+}
+
+}  // namespace
+
+TEST_CASE("VNNI K store and load are exact and token-independent", "[kv_data][k_vnni]") {
+  auto buf = std::make_unique<plane_and_rows>();
+  std::mt19937 gen(7);
+  std::uniform_int_distribution<uint16_t> bits(0, 0xffff);
+  for (auto& x : buf->rows) {
+    x = tron::bf16::from_bits(bits(gen));
+  }
+  // Poison: a wrong index would leave poison where a value belongs, or put
+  // a value where poison belongs.
+  for (auto& x : buf->plane) {
+    x = tron::bf16::from_bits(0xa5a5);
+  }
+  // Store every token in a scrambled order (tokens own disjoint slots).
+  for (size_t i = 0; i < PAGE_TOKENS_64; ++i) {
+    const size_t tok = (i * 37 + 11) % PAGE_TOKENS_64;
+    tron::k_vnni::scatter_row(buf->plane, tok, buf->rows + tok * HEAD_SIZE_128);
+  }
+  SECTION("the plane holds every value at the documented position") {
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+        const size_t at = tron::k_vnni::index(tok, d);
+        REQUIRE(at == documented_index(tok, d));
+        REQUIRE(buf->plane[at].to_bits() == buf->rows[tok * HEAD_SIZE_128 + d].to_bits());
+      }
+    }
+  }
+  SECTION("gather_row inverts scatter_row for every token") {
+    alignas(64) tron::bf16 row[HEAD_SIZE_128];
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      tron::k_vnni::gather_row(buf->plane, tok, row);
+      REQUIRE(std::memcmp(row, buf->rows + tok * HEAD_SIZE_128, sizeof(row)) == 0);
+    }
+  }
+  SECTION("rewriting one token changes no other token's slots") {
+    const size_t tok = 29;
+    for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+      buf->rows[tok * HEAD_SIZE_128 + d] = tron::bf16::from_bits(bits(gen));
+    }
+    tron::k_vnni::scatter_row(buf->plane, tok, buf->rows + tok * HEAD_SIZE_128);
+    for (size_t t = 0; t < PAGE_TOKENS_64; ++t) {
+      for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+        REQUIRE(buf->plane[tron::k_vnni::index(t, d)].to_bits() ==
+                buf->rows[t * HEAD_SIZE_128 + d].to_bits());
+      }
+    }
+  }
+}
+
+TEST_CASE("VNNI K reader does not digress from the row-major dotter",
+    "[kv_data][k_vnni]") {
+  // Same numerics contract as the AMX kernels (Note [AMX attention dispatch]):
+  // both readers add the same exact bf16 x bf16 products in fp32, so only the
+  // add order may differ. Envelope: 1e-4 of the absolute-product mass plus
+  // 1e-6. Tokens outside the live mask keep their preset value, and their
+  // storage holds NaN poison that a stray load would spread.
+  constexpr size_t kv_mul = 4;
+  auto buf = std::make_unique<plane_and_rows>();
+  std::mt19937 gen(31);
+  std::uniform_real_distribution<float> u(-1.f, 1.f);
+  alignas(64) tron::bf16 q_bf16[kv_mul * HEAD_SIZE_128];
+  alignas(64) float q_f32[kv_mul * HEAD_SIZE_128];
+  for (size_t i = 0; i < kv_mul * HEAD_SIZE_128; ++i) {
+    q_bf16[i] = tron::bf16::from_bits(bf16_rne(u(gen)));
+    q_f32[i] = u(gen);
+  }
+  for (auto& x : buf->rows) {
+    x = tron::bf16::from_bits(bf16_rne(u(gen)));
+  }
+  std::vector<uint64_t> masks;
+  for (size_t n = 0; n <= PAGE_TOKENS_64; ++n)  // every prefix, 0 and 64 included
+    masks.push_back(n == 64 ? ~uint64_t{0} : ((uint64_t{1} << n) - 1));
+  for (int i = 0; i < 24; ++i)  // holes
+    masks.push_back((uint64_t(gen()) << 32) | uint64_t(gen()));
+  masks.push_back(uint64_t{1} << 63);
+  masks.push_back(uint64_t{1} << 16);
+
+  for (uint64_t live : masks) {
+    // Only live tokens are stored; the rest of the plane is NaN poison.
+    for (auto& x : buf->plane) {
+      x = tron::bf16::from_bits(0x7fc1);
+    }
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      if ((live >> tok) & 1) {
+        tron::k_vnni::scatter_row(buf->plane, tok, buf->rows + tok * HEAD_SIZE_128);
+      }
+    }
+    const float preset = -1.0f / 0.0f;
+    alignas(64) float s_bf16[kv_mul][PAGE_TOKENS_64];
+    alignas(64) float s_f32[kv_mul][PAGE_TOKENS_64];
+    for (auto& row : s_bf16) {
+      for (auto& x : row) x = preset;
+    }
+    for (auto& row : s_f32) {
+      for (auto& x : row) x = preset;
+    }
+    tron::k_vnni::qk_group<kv_mul>(buf->plane, q_bf16, live, &s_bf16[0][0], PAGE_TOKENS_64);
+    tron::k_vnni::qk_group<kv_mul>(buf->plane, q_f32, live, &s_f32[0][0], PAGE_TOKENS_64);
+    for (size_t h = 0; h < kv_mul; ++h) {
+      tron::const_view<tron::bf16, true, false, tron::seq<HEAD_SIZE_128>> qv_bf16{
+          q_bf16 + h * HEAD_SIZE_128};
+      tron::const_view<float, true, false, tron::seq<HEAD_SIZE_128>> qv_f32{
+          q_f32 + h * HEAD_SIZE_128};
+      tron::dotter<tron::bf16, HEAD_SIZE_128> dot_bf16(qv_bf16);
+      tron::dotter<float, HEAD_SIZE_128> dot_f32(qv_f32);
+      for (size_t t = 0; t < PAGE_TOKENS_64; ++t) {
+        CAPTURE(live, h, t);
+        if (!((live >> t) & 1)) {
+          REQUIRE(s_bf16[h][t] == preset);
+          REQUIRE(s_f32[h][t] == preset);
+          continue;
+        }
+        tron::const_view<tron::bf16, true, false, tron::seq<HEAD_SIZE_128>> kv{
+            buf->rows + t * HEAD_SIZE_128};
+        double mass_bf16 = 0, mass_f32 = 0;
+        for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+          const double k = bf16_to_float(buf->rows[t * HEAD_SIZE_128 + d].to_bits());
+          mass_bf16 += std::fabs(double(bf16_to_float(q_bf16[h * HEAD_SIZE_128 + d].to_bits())) * k);
+          mass_f32 += std::fabs(double(q_f32[h * HEAD_SIZE_128 + d]) * k);
+        }
+        REQUIRE(std::fabs(double(s_bf16[h][t]) - double(dot_bf16(kv))) <=
+                1e-4 * mass_bf16 + 1e-6);
+        REQUIRE(std::fabs(double(s_f32[h][t]) - double(dot_f32(kv))) <=
+                1e-4 * mass_f32 + 1e-6);
+      }
+    }
+  }
+}
+
+namespace {
+
+// One slot, one KV head of 128 dims: a VNNI slot under TRON_K_VNNI, a
+// row-major slot otherwise. The accessors and the append path below are
+// layout-agnostic, so the same checks hold in both builds.
+using book_t = tron::uniform_kv_cache<1, tron::kv_geometry{1, HEAD_SIZE_128}, 0>;
+using page_t = book_t::page_t;
+constexpr tron::kv_slot_id slot0(0);
+
+void fill_row(std::array<tron::bf16, HEAD_SIZE_128>& row, size_t token, size_t salt) {
+  for (size_t d = 0; d < HEAD_SIZE_128; ++d)
+    row[d] = tron::bf16::from_bits(static_cast<uint16_t>(0x3000 + salt * 4096 + token * 128 + d));
+}
+
+}  // namespace
+
+TEST_CASE("page K rows survive the store, the load and an append", "[kv_data][k_vnni]") {
+  static_assert(book_t::page_size == PAGE_TOKENS_64);
+#ifdef TRON_K_VNNI
+  STATIC_REQUIRE(tron::k_vnni::layout_on<HEAD_SIZE_128>);
+#else
+  STATIC_REQUIRE_FALSE(tron::k_vnni::layout_on<HEAD_SIZE_128>);
+#endif
+  alignas(64) std::array<tron::bf16, HEAD_SIZE_128> row{}, got{};
+  SECTION("store and load, every token of a page") {
+    book_t cache(/*n_pages=*/1);
+    cache.increment_tokens_used(PAGE_TOKENS_64);
+    page_t* page = cache.page_of(0);
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      fill_row(row, tok, 1);
+      page->set_k_row(slot0, 0, tok, row.data());
+    }
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      fill_row(row, tok, 1);
+      page->get_k_row(slot0, 0, tok, got.data());
+      CAPTURE(tok);
+      REQUIRE(got == row);
+    }
+  }
+  SECTION("append into a partly filled page moves tokens to new offsets") {
+    // Destination holds 5 tokens; the source's 20 tokens land at offsets 5..24
+    // of the destination's first page: the token-by-token copy path.
+    book_t destination(/*n_pages=*/1);
+    book_t source(/*n_pages=*/1);
+    destination.increment_tokens_used(5);
+    source.increment_tokens_used(20);
+    for (size_t tok = 0; tok < 5; ++tok) {
+      fill_row(row, tok, 2);
+      destination.page_of(tok)->set_k_row(slot0, 0, tok, row.data());
+    }
+    for (size_t tok = 0; tok < 20; ++tok) {
+      fill_row(row, tok, 3);
+      source.page_of(tok)->set_k_row(slot0, 0, tok, row.data());
+    }
+    destination.append(source);
+    REQUIRE(destination.size() == 25);
+    for (size_t tok = 0; tok < 5; ++tok) {  // the old tokens are untouched
+      fill_row(row, tok, 2);
+      destination.page_of(tok)->get_k_row(slot0, 0, tok, got.data());
+      CAPTURE(tok);
+      REQUIRE(got == row);
+    }
+    for (size_t tok = 0; tok < 20; ++tok) {
+      fill_row(row, tok, 3);
+      destination.page_of(5 + tok)->get_k_row(slot0, 0, 5 + tok, got.data());
+      CAPTURE(tok);
+      REQUIRE(got == row);
+    }
+  }
+  SECTION("append of a full page into an empty book copies the whole page") {
+    book_t destination(/*n_pages=*/1);
+    book_t source(/*n_pages=*/1);
+    source.increment_tokens_used(PAGE_TOKENS_64);
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      fill_row(row, tok, 4);
+      source.page_of(tok)->set_k_row(slot0, 0, tok, row.data());
+    }
+    destination.append(source);
+    REQUIRE(destination.size() == PAGE_TOKENS_64);
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      fill_row(row, tok, 4);
+      destination.page_of(tok)->get_k_row(slot0, 0, tok, got.data());
+      CAPTURE(tok);
+      REQUIRE(got == row);
+    }
+  }
+}
