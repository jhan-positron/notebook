+TEST_CASE("VNNI K block store equals the per-token scatter, bit for bit",
+    "[kv_data][k_vnni]") {
+  // store_block (16 tokens transposed in registers, whole-line stores) is
+  // the prefill store of save_k (Note [Striped K store] in model.hpp); it
+  // must leave the plane exactly as scatter_row per present token does, and
+  // it must not touch the slots of absent tokens (poison stays poison). The
+  // masks cover: full block, single tokens, halves, alternating lanes, the
+  // empty block, and random subsets.
+  auto ref = std::make_unique<plane_and_rows>();
+  auto blk = std::make_unique<plane_and_rows>();
+  std::mt19937 gen(19);
+  std::uniform_int_distribution<uint16_t> bits(0, 0xffff);
+  for (auto& x : ref->rows) {
+    x = tron::bf16::from_bits(bits(gen));
+  }
+  std::vector<unsigned> masks = {0xffff, 0x0001, 0x8000, 0x00ff, 0xff00, 0x5555, 0xaaaa,
+      0x0000, 0x1234, 0xfffe, 0x7fff, 0x0f0f, 0x0002, 0x4000};
+  for (int i = 0; i < 24; ++i)
+    masks.push_back(bits(gen));
+  size_t checked = 0;
+  for (size_t c = 0; c < PAGE_TOKENS_64 / 16; ++c) {
+    for (unsigned m : masks) {
+      for (auto& x : ref->plane) {
+        x = tron::bf16::from_bits(0xa5a5);
+      }
+      std::memcpy(blk->plane, ref->plane, sizeof(ref->plane));
+      const tron::bf16* rows[16] = {};
+      for (size_t t = 0; t < 16; ++t) {
+        if (!((m >> t) & 1u)) continue;
+        const size_t tok = c * 16 + t;
+        rows[t] = ref->rows + tok * HEAD_SIZE_128;
+        tron::k_vnni::scatter_row(ref->plane, tok, rows[t]);
+      }
+      tron::k_vnni::store_block(blk->plane, c, __mmask16(m), rows);
+      REQUIRE(std::memcmp(blk->plane, ref->plane, sizeof(ref->plane)) == 0);
+      ++checked;
+    }
+  }
+  REQUIRE(checked == 4 * masks.size());
+  SECTION("a block store on top of other blocks changes only its own block") {
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok)
+      tron::k_vnni::scatter_row(ref->plane, tok, ref->rows + tok * HEAD_SIZE_128);
+    std::memcpy(blk->plane, ref->plane, sizeof(ref->plane));
+    // New rows for block 2 only.
+    for (size_t tok = 32; tok < 48; ++tok)
+      for (size_t d = 0; d < HEAD_SIZE_128; ++d)
+        ref->rows[tok * HEAD_SIZE_128 + d] = tron::bf16::from_bits(bits(gen));
+    const tron::bf16* rows[16];
+    for (size_t t = 0; t < 16; ++t) {
+      rows[t] = ref->rows + (32 + t) * HEAD_SIZE_128;
+      tron::k_vnni::scatter_row(ref->plane, 32 + t, rows[t]);
+    }
+    tron::k_vnni::store_block(blk->plane, 2, 0xffff, rows);
+    REQUIRE(std::memcmp(blk->plane, ref->plane, sizeof(ref->plane)) == 0);
+    alignas(64) tron::bf16 row[HEAD_SIZE_128];
+    for (size_t tok = 0; tok < PAGE_TOKENS_64; ++tok) {
+      tron::k_vnni::gather_row(blk->plane, tok, row);
+      REQUIRE(std::memcmp(row, ref->rows + tok * HEAD_SIZE_128, sizeof(row)) == 0);
+    }
+  }
+}
