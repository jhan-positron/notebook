+
+namespace detail {
+// In-place transpose of a 16 x 16 matrix of 32-bit lanes: on return r[i]
+// holds lane i of every input register (input register t in lane t). Four
+// stages of two-register shuffles, 64 shuffles in all.
+TRON(inline)
+void transpose_16x16_epi32(__m512i (&r)[16]) noexcept {
+  __m512i t[16];
+  for (size_t i = 0; i < 8; ++i) {
+    t[2 * i] = _mm512_unpacklo_epi32(r[2 * i], r[2 * i + 1]);
+    t[2 * i + 1] = _mm512_unpackhi_epi32(r[2 * i], r[2 * i + 1]);
+  }
+  for (size_t i = 0; i < 4; ++i) {
+    r[4 * i] = _mm512_unpacklo_epi64(t[4 * i], t[4 * i + 2]);
+    r[4 * i + 1] = _mm512_unpackhi_epi64(t[4 * i], t[4 * i + 2]);
+    r[4 * i + 2] = _mm512_unpacklo_epi64(t[4 * i + 1], t[4 * i + 3]);
+    r[4 * i + 3] = _mm512_unpackhi_epi64(t[4 * i + 1], t[4 * i + 3]);
+  }
+  for (size_t i = 0; i < 4; ++i) {
+    t[i] = _mm512_shuffle_i32x4(r[i], r[i + 4], 0x88);
+    t[i + 4] = _mm512_shuffle_i32x4(r[i], r[i + 4], 0xdd);
+    t[i + 8] = _mm512_shuffle_i32x4(r[i + 8], r[i + 12], 0x88);
+    t[i + 12] = _mm512_shuffle_i32x4(r[i + 8], r[i + 12], 0xdd);
+  }
+  for (size_t i = 0; i < 8; ++i) {
+    r[i] = _mm512_shuffle_i32x4(t[i], t[i + 8], 0x88);
+    r[i + 8] = _mm512_shuffle_i32x4(t[i], t[i + 8], 0xdd);
+  }
+}
+}  // namespace detail
+
+// Store the K rows of up to 16 tokens of one token block c (tokens c * 16 + t
+// for the bits t set in `present`) into the plane with full-line stores:
+// for each of the 4 dim steps, the 16 rows' 16 dim pairs (one 64-byte load
+// per row) are transposed in registers into the panel's 16 pair rows, and
+// each pair row is written as one 64-byte store (masked to the present
+// tokens' lanes when the block is partial). The absent tokens' slots are not
+// written. rows[t] points at the 128 bf16 of token t and may be null for an
+// absent token. Compared with scatter_row per token, a full block issues 64
+// stores of whole lines instead of 64 scatters writing 4 bytes into each of
+// 64 lines. The same 16 KiB is written; the write pattern differs.
+TRON(inline)
+void store_block(
+    bf16* plane, size_t c, __mmask16 present, const bf16* const rows[16]) noexcept {
+  for (size_t s = 0; s < HEAD_SIZE_128 / 32; ++s) {
+    __m512i r[16];
+    for (size_t t = 0; t < 16; ++t) {
+      r[t] = ((present >> t) & 1u) ? _mm512_loadu_si512(rows[t] + s * 32)
+                                   : _mm512_setzero_si512();
+    }
+    detail::transpose_16x16_epi32(r);
+    bf16* panel = plane + (s * (PAGE_TOKENS_64 / 16) + c) * PANEL_ELEMS_512;
+    if (present == 0xffffu) {
+      for (size_t dp = 0; dp < 16; ++dp)
+        _mm512_storeu_si512(panel + dp * 32, r[dp]);
+    } else {
+      for (size_t dp = 0; dp < 16; ++dp)
+        _mm512_mask_storeu_epi32(panel + dp * 32, present, r[dp]);
+    }
+  }
+}
