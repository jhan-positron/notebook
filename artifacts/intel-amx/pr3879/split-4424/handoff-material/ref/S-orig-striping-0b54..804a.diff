+
+  SECTION("one thread: the grouping stores every row and touches nothing else") {
+    bk.fill_random(gen);
+    const auto before = snapshot();
+    state.template save_k<geometry>(&q_batch, operation, state.plugin_state.kouts);
+    check(before);
+    REQUIRE(q_batch.k_store_window.opened.load() == 0);
+  }
+
+  SECTION("three threads: the helpers share the window and every row lands once") {
+    bk.fill_random(gen);
+    const auto before = snapshot();
+    constexpr size_t n_workers = 3;
+    std::vector<std::thread> helpers;
+    for (size_t worker_ix = 1; worker_ix < n_workers; ++worker_ix)
+      helpers.emplace_back([&, worker_ix] {
+        state.template save_k_helper<geometry>(
+            &q_batch, operation, state.plugin_state.kouts, worker_ix, n_workers);
+      });
+    state.template save_k<geometry>(
+        &q_batch, operation, state.plugin_state.kouts, n_workers);
+    for (auto& h : helpers)
+      h.join();
+    check(before);
+    if constexpr (k_vnni::layout_on<head_size>) {
+      auto const& w = q_batch.k_store_window;
+      REQUIRE(w.opened.load() == 1);
+      REQUIRE(w.finished.load() == n_workers - 1);
+      // The work units: [5,8) [8] [9,16) [16,21) [48,64) [64,72) [100] [130,136) [21]
+      REQUIRE(w.n_units == 9);
+      REQUIRE(w.unit_start[0] == 0);
+      REQUIRE(w.unit_start[1] == 3);  // the job without KV work is its own unit
+      REQUIRE(w.unit_start[2] == 4);
+      REQUIRE(w.unit_start[3] == 11);  // token 16 starts block 1
+      REQUIRE(w.unit_start[4] == 16);  // token 48
+      REQUIRE(w.unit_start[5] == 32);  // token 64: page 1
+      REQUIRE(w.unit_start[6] == 40);  // token 100
+      REQUIRE(w.unit_start[7] == 41);  // token 130: page 2
+      REQUIRE(w.unit_start[8] == 47);  // the trailing job without KV work
+      REQUIRE(w.unit_start[9] == 48);
+      REQUIRE(w.next_unit.load() >= 9);
+    } else {
+      REQUIRE(q_batch.k_store_window.opened.load() == 0);
+    }
+  }
+}
