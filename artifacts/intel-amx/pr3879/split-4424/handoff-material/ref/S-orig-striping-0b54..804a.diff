+// Runtime switches of the two store paths of save_k (model.hpp), read once
+// per process. Both paths are on by default; exactly the value "0" switches
+// one off (the comparison is exact, as for TRON_AMX_DISABLE, whose polarity
+// is the opposite: it switches AMX off with "1"). Both exist for same-binary
+// A/B measurements of the store cost.
+//   TRON_K_VNNI_BLOCK=0  every token is scattered on its own (scatter_row)
+//                        instead of 16 tokens at a time (store_block).
+//   TRON_K_VNNI_STRIPE=0 the main thread stores every token itself instead
+//                        of sharing the work with the idle main helpers
+//                        (Note [Striped K store] in model.hpp).
+inline bool block_store_enabled() noexcept {
+  static const bool on = [] {
+    const char* v = std::getenv("TRON_K_VNNI_BLOCK");
+    return !(v != nullptr && std::strcmp(v, "0") == 0);
+  }();
+  return on;
+}
+inline bool striped_store_enabled() noexcept {
+  static const bool on = [] {
+    const char* v = std::getenv("TRON_K_VNNI_STRIPE");
+    return !(v != nullptr && std::strcmp(v, "0") == 0);
+  }();
+  return on;
