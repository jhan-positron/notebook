+    // Note [Striped K store]
+    // ~~~~~~~~~~~~~~~~~~~~~~
+    // save_k stores the K rows of every token of the minibatch once per
+    // (layer, pass). With the VNNI K layout (Note [K VNNI storage] in
+    // kv_cache.hpp) that store is the main thread's largest serial piece of
+    // work in a prefill layer: measured 2026-09-14 on delphi-3bda (qwen3-4b,
+    // 8 users, prompt 1024, 128 tokens of each user per pass) at 0.86 ms per
+    // layer, 105 ns per (token, KV head) row, with the attention workers'
+    // pending sections waiting behind it. Two things shorten it:
+    //   1. Block store (k_vnni::store_block, page::set_k_block): a run of the
+    //      pass's tokens that fills (part of) one 16-token block of a page is
+    //      transposed in registers and written as whole 64-byte lines,
+    //      instead of one 4-byte scatter per (token, dim pair, line). Chosen
+    //      per run in store_k_block; TRON_K_VNNI_BLOCK=0 disables it.
+    //   2. Striping over the main helpers: in generated plugins the helpers
+    //      are idle while main runs save_k (their next kernel waits for the
+    //      attention output), so the generated run_main_help calls
+    //      save_k_helper at the same statement position and every thread
+    //      claims 16-token blocks of the minibatch's items until none is
+    //      left. TRON_K_VNNI_STRIPE=0 disables it; n_workers == 1 (the
+    //      handwritten plugins, the unit tests) never stripes.
+    // The window protocol (fields in batch::k_store_window, common.hpp):
+    //   - both sides decide with k_store_striped(); a window exists only
+    //     when it says yes, so a helper never waits for a window main does
+    //     not open (a pass with at most 16 tokens, such as a decode step, or
+    //     more than 128 workers is not striped);
+    //   - main cuts the item list into work units (unit_start[]): a unit is a
+    //     run of items in one 16-token block of one page with the same
+    //     token_jobs_do_kv value, so a page block has one writer and, when
+    //     the run fills it, one full-line store per pair row. Main then
+    //     zeroes the claim counter and increments `opened` (release). A
+    //     helper's W-th call waits for `opened` >= W (acquire), so window W
+    //     of a pass is the W-th striped save_k of that pass on both sides;
+    //   - every thread claims units with fetch_add on `next_unit` and stores
+    //     their rows; a unit index is handed out once, so a thread that
+    //     leaves the claim loop has stored every unit it took;
+    //   - a helper increments `finished` (release) when its claim loop ends;
+    //     main returns only when `finished` == n_workers - 1 (acquire). So
+    //     every unit is stored when main returns, no helper is inside a
+    //     window main has left, the counters are main's to reset, and every
+    //     row store happens-before the downstream latch count_down below;
+    //   - the per-token completion marks and GOF credits stay on main, after
+    //     the join, in the token order of before.
+    // The rows a helper reads (ks) are ready because main waited for every
+    // token's K channel before calling save_k (the generated code), and the
+    // channel phase cannot advance while main is inside save_k. A helper can
+    // reach its save_k_helper call without main's help (nothing blocks
+    // between its K/Q rope kernel and this statement), so main's join cannot
+    // deadlock; a join that does not complete within two minutes aborts with
+    // the counters in the message.
+
+    static constexpr size_t K_STORE_BLOCK_16 = 16;
+
+    // Whether the K store of this minibatch is shared with the helpers; the
+    // same answer on the main thread and on every helper.
+    template <attention_geometry geometry>
+    bool k_store_striped(batch* q_batch, size_t n_workers) const noexcept {
+      if constexpr (!k_vnni::layout_on<geometry.kv.head_size>) {
+        return false;
+      } else {
+        return n_workers > 1 &&
+               n_workers <= q_batch->k_store_window.helper_windows.size() &&
+               q_batch->items.size() > K_STORE_BLOCK_16 &&
+               k_vnni::striped_store_enabled();
+      }
+    }
+
+    // Cut the minibatch's items into the work units of Note [Striped K
+    // store]; only main calls this, before it opens the window.
+    void k_store_cut_units(batch* q_batch) noexcept {
+      auto& w = q_batch->k_store_window;
+      auto const& self = *this;
+      const size_t n_items = q_batch->items.size();
+      TRON_ASSERT(n_items + 1 <= w.unit_start.size(),
+          "save_k: {} items exceed the K store window's unit table", n_items);
+      uint32_t n_units = 0;
+      const page* run_page = nullptr;
+      size_t run_block = 0;
+      bool run_kv = false;
+      for (size_t t = 0; t < n_items; ++t) {
+        const token_job_id ix = q_batch->items[t];
+        const bool kv = self.token_jobs_do_kv[ix] != 0;
+        const page* pg = kv ? &page_of(token_jobs[ix]) : nullptr;
+        const size_t block =
+            kv ? static_cast<size_t>(pg->offset_in_page(token_jobs[ix])) /
+                     K_STORE_BLOCK_16
+               : 0;
+        if (t == 0 || kv != run_kv || pg != run_page || block != run_block) {
+          w.unit_start[n_units++] = static_cast<uint32_t>(t);
+          run_kv = kv;
+          run_page = pg;
+          run_block = block;
+        }
+      }
+      w.unit_start[n_units] = static_cast<uint32_t>(n_items);
+      w.n_units = n_units;
+    }
+
+    // Store the K rows (every KV head) of the tokens items[task_begin,
+    // task_end) of q_batch into slot `slot`. VNNI slots: consecutive items
+    // that fall into the same 16-token block of the same page are stored as
+    // one block (set_k_block); a token alone in its block, or every token
+    // when TRON_K_VNNI_BLOCK=0, goes through set_k_row (scatter). Row-major
+    // slots: the per-token row store of before. Marks and credits are not
+    // touched here (save_k_impl does them after every store is done).
+    template <attention_geometry geometry, typename kv_buffer_t>
+    void store_k_block(batch* q_batch,
+        kv_slot_id slot,
+        kv_buffer_t& ks,
+        size_t task_begin,
+        size_t task_end) noexcept {
+      auto const& self = *this;
+      auto row_of = [&](token_job_id ix, size_t kv_head) {
+        return slice<geometry.kv.head_size>()(
+            ks[ix].as_view(), kv_head * geometry.kv.head_size);
+      };
+      if constexpr (!k_vnni::layout_on<geometry.kv.head_size>) {
+        for (size_t t = task_begin; t < task_end; ++t) {
+          token_job_id ix = q_batch->items[t];
+          if (!self.token_jobs_do_kv[ix]) continue;
+          token_id tok_ix = token_jobs[ix];
+          page& pg = page_of(tok_ix);
+          int j = pg.offset_in_page(tok_ix);
+          for (size_t kv_head = 0; kv_head < geometry.kv.n_kv_heads; ++kv_head)
+            pg.template k<geometry.kv>(slot, kv_head, j).set(row_of(ix, kv_head));
+        }
+      } else {
+        using kv_elem_t = std::remove_cv_t<
+            std::remove_pointer_t<decltype(row_of(token_job_id{0}, 0).data)>>;
+        constexpr bool rows_are_bf16 = std::is_same_v<kv_elem_t, bf16>;
+        const bool block_store = k_vnni::block_store_enabled();
+        // A bf16 K buffer is read in place; any other activation type is
+        // converted to bf16 on the stack first, as the row-major store does
+        // in place.
+        alignas(64) bf16 conv[K_STORE_BLOCK_16][geometry.kv.head_size];
+        size_t t = task_begin;
+        while (t < task_end) {
+          const token_job_id ix0 = q_batch->items[t];
+          if (!self.token_jobs_do_kv[ix0]) {
+            ++t;
+            continue;
+          }
+          page& pg = page_of(token_jobs[ix0]);
+          const size_t c = static_cast<size_t>(pg.offset_in_page(token_jobs[ix0])) /
+                           K_STORE_BLOCK_16;
+          // The run: consecutive items in block c of this page (tokens
+          // without KV work in between are skipped, not run breakers).
+          token_job_id run_ix[K_STORE_BLOCK_16];
+          uint8_t run_t[K_STORE_BLOCK_16];
+          size_t n = 0;
+          __mmask16 present = 0;
+          for (; t < task_end && n < K_STORE_BLOCK_16; ++t) {
+            const token_job_id ix = q_batch->items[t];
+            if (!self.token_jobs_do_kv[ix]) continue;
+            const token_id tok_ix = token_jobs[ix];
+            if (&page_of(tok_ix) != &pg) break;
+            const size_t j = static_cast<size_t>(pg.offset_in_page(tok_ix));
+            if (j / K_STORE_BLOCK_16 != c) break;
+            const __mmask16 bit = __mmask16(1u << (j % K_STORE_BLOCK_16));
+            if (present & bit) break;  // the same offset twice: not a run
+            run_ix[n] = ix;
+            run_t[n] = static_cast<uint8_t>(j % K_STORE_BLOCK_16);
+            present |= bit;
+            ++n;
+          }
+          if (n == 1 || !block_store) {
+            for (size_t i = 0; i < n; ++i) {
+              const size_t j = c * K_STORE_BLOCK_16 + run_t[i];
+              for (size_t kv_head = 0; kv_head < geometry.kv.n_kv_heads; ++kv_head) {
+                auto kout = row_of(run_ix[i], kv_head);
+                if constexpr (rows_are_bf16) {
+                  pg.template set_k_row<geometry.kv>(slot, kv_head, j, kout.data);
+                } else {
+                  view<bf16, true, false, seq<geometry.kv.head_size>>{conv[0]}.set(
+                      kout);
+                  pg.template set_k_row<geometry.kv>(slot, kv_head, j, conv[0]);
+                }
+              }
+            }
+          } else {
+            for (size_t kv_head = 0; kv_head < geometry.kv.n_kv_heads; ++kv_head) {
+              const bf16* rows[K_STORE_BLOCK_16] = {};
+              for (size_t i = 0; i < n; ++i) {
+                auto kout = row_of(run_ix[i], kv_head);
+                if constexpr (rows_are_bf16) {
+                  rows[run_t[i]] = kout.data;
+                } else {
+                  view<bf16, true, false, seq<geometry.kv.head_size>>{conv[i]}.set(
+                      kout);
+                  rows[run_t[i]] = conv[i];
+                }
+              }
+              pg.template set_k_block<geometry.kv>(slot, kv_head, c, present, rows);
+            }
+          }
+        }
+      }
+    }
+
+    // A helper's share of the K store window (Note [Striped K store]);
+    // called by the generated run_main_help at the attention statement of
+    // every KV-writing operation, with the helper's worker_ix (1 ..
+    // n_workers - 1).
+    template <attention_geometry geometry, size_t operation_ix, typename kv_buffer_t>
+    void save_k_helper(
+        batch* q_batch, kv_buffer_t& ks, size_t worker_ix, size_t n_workers) noexcept {
+      constexpr auto const& operation =
+          generated_attention_operation<geometry, operation_ix>();
+      static_assert(operation.writes_kv);
+      save_k_helper<geometry>(q_batch, operation, ks, worker_ix, n_workers);
+    }
+
+    template <attention_geometry geometry, typename kv_buffer_t>
+    void save_k_helper(batch* q_batch,
+        attention_operation_descriptor const& operation,
+        kv_buffer_t& ks,
+        size_t worker_ix,
+        size_t n_workers) noexcept {
+      if constexpr (!k_vnni::layout_on<geometry.kv.head_size>) {
+        return;
+      } else {
+        if (!k_store_striped<geometry>(q_batch, n_workers)) return;
+        const kv_slot_id slot = operation.binding.kv_slot;
+        auto& w = q_batch->k_store_window;
