+  // This page's packed K plane for one KV head of one slot, read-only: the
+  // argument type of the layout-specific score kernels (the AMX QK kernel
+  // qk_vnni_128x4 reads it in place as its B operand, the AVX-512 reader
+  // k_vnni::qk_group one token per lane). VNNI slots only (Note [K VNNI
+  // storage]). Internal cache writes take writable views from the block owner
+  // instead. Only the blocks named by k_vnni_blocks hold the VNNI layout; the
+  // others hold row-major rows (Note [Row-major tail block] in
+  // h/tron/tensor/k_vnni.hpp, read through row_major_row).
+  template <kv_geometry geometry>
+    requires(book_t::template declares_geometry<geometry>() &&
+             k_vnni::layout_on<geometry.head_size>)
+  TRON(nodiscard, inline, pure)
+  k_vnni_view<const bf16, page_size, geometry.head_size> k_packed(
+      kv_slot_id slot, size_t kv_head) const noexcept TRON(this_lifetimebound)
+  {
+    return kv_block<geometry>(slot, kv_head).k.as_view();
+  }
+
+  // The 16-token blocks of this page that hold the VNNI layout for `slot`, one
+  // bit per block (bit c = page offsets 16 c .. 16 c + 15): the converted
+  // blocks of Note [K VNNI storage].
+  template <kv_geometry geometry>
+    requires(book_t::template declares_geometry<geometry>() &&
+             k_vnni::layout_on<geometry.head_size>)
+  TRON(nodiscard, inline)
+  uint8_t k_vnni_blocks(kv_slot_id slot) const noexcept {
+    return k_vnni_blocks_[k_state_ix(slot)].load(std::memory_order_acquire);
+  }
+
+  // A storage slot and the index of its K layout state (Note [K VNNI
+  // storage]): the EAGLE entry for the EAGLE storage, the slot's own entry
+  // otherwise. k_storage_of resolves a logical slot under the current view.
+  // copy_from builds the pair from the physical slot instead, because a page
+  // copy moves every physical slot. The deferred conversion list of save_k
+  // keeps the resolved pair, so that a view change between the save and the
+  // forward end cannot redirect the conversion. The block conversion and the
+  // page copy take the pair as one argument.
+  struct k_storage_ref {
+    kv_storage_offset offset;
+    size_t state_ix;
+  };
+  TRON(nodiscard, inline)
+  k_storage_ref k_storage_of(kv_slot_id slot) const noexcept {
+    const size_t ix = k_state_ix(slot);
+    return {ix == layout_t::n_slots ? book.eagle_storage_offset()
+                                    : kv_storage_offset(slot.i),
+        ix};
+  }
+
+  // Record that the K row of page offset `offset` is saved for `slot` (VNNI
+  // slots; a row-major slot keeps no bits and returns false). Returns true when
+  // the row's 16-token block now has all 16 rows saved and is not converted
+  // yet: the main thread of save_k then queues the block for k_block_to_vnni
+  // at the forward end. A row saved again into a block that waits for its
+  // conversion returns true again (the conversion is idempotent); a row of a
+  // converted block returns false (set_k_row wrote it into the VNNI column).
+  template <kv_geometry geometry>
+    requires(book_t::template declares_geometry<geometry>())
+  TRON(nodiscard, inline)
+  bool note_k_row_saved(kv_slot_id slot, size_t offset) noexcept {
+    TRON_ASSERT_LT(offset, page_size);
+    if constexpr (!k_vnni::layout_on<geometry.head_size>) {
+      (void)slot;
+      return BLOCK_COMPLETED_FALSE;
+    }
+    const size_t ix = k_state_ix(slot);
+    const size_t c = offset / k_vnni::BLOCK_TOKENS_16;
+    const uint64_t bit = k_vnni::offset_bit(offset);
+    auto& saved = k_rows_saved_[ix];
+    uint64_t before = saved.load(std::memory_order_relaxed);
+    if ((before & bit) == 0) before = saved.fetch_or(bit, std::memory_order_acq_rel);
+    const uint64_t after = before | bit;
+    return (after & k_block_bits(c)) == k_block_bits(c) &&
+           (k_vnni_blocks_[ix].load(std::memory_order_acquire) &
+               k_vnni::block_bit(c)) == 0;
+  }
+
+  TRON(nodiscard, inline)
+  bool note_k_row_saved(kv_slot_id slot, size_t offset) noexcept
+    requires(layout_t::uniform_geometry)
