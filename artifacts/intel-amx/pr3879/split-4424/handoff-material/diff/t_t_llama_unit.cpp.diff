+    for (size_t tok = 0; tok < num_kv_tokens; ++tok) {
+      page_t* page = bk.page_of(tok);
+      const int offset = page->offset_in_page(token_id(tok));
+      for (size_t kv_head = 0; kv_head < n_kv_heads; ++kv_head) {
+        page->get_k_row(
+            slot, kv_head, offset, k_destination_row<head_size>(row.data()));
+        for (size_t d = 0; d < head_size; ++d) {
+          rows[tok * n_kv_heads + kv_head][d] = row[d].to_bits();
+        }
+      }
+    }
+    return rows;
+  };
+  auto check = [&](std::vector<std::array<uint16_t, head_size>> const& before) {
+    std::vector<int> job_of_token(num_kv_tokens, -1);  // -1: no job stores it
+    for (size_t job = 0; job < n_items; ++job) {
+      if (do_kv[job]) job_of_token[job_tokens[job].i] = static_cast<int>(job);
+    }
+    const auto after = snapshot();
+    size_t stored = 0, kept = 0;
+    for (size_t tok = 0; tok < num_kv_tokens; ++tok) {
+      for (size_t kv_head = 0; kv_head < n_kv_heads; ++kv_head) {
+        auto const& got = after[tok * n_kv_heads + kv_head];
+        if (job_of_token[tok] < 0) {
+          REQUIRE(got == before[tok * n_kv_heads + kv_head]);
+          ++kept;
+          continue;
+        }
+        const size_t job = static_cast<size_t>(job_of_token[tok]);
+        for (size_t d = 0; d < head_size; ++d) {
+          const uint16_t want = source_bits(job, kv_head * head_size + d);
+          if (got[d] != want) {
+            FAIL("token " << tok << " kv_head " << kv_head << " dim " << d
+                          << ": stored 0x" << std::hex << got[d] << " expected 0x"
+                          << want);
+          }
+        }
+        ++stored;
+      }
+    }
+    REQUIRE(stored == kv_jobs * n_kv_heads);
+    REQUIRE(kept == (num_kv_tokens - kv_jobs) * n_kv_heads);
+  };
+  // The marks: save_k marks K of every job with KV work exactly once. The
+  // helpers leave before the mark loop. K alone does not complete a token.
+  // The second mark completes it (mark_k_complete returns true only when
+  // the count was 1). A job without KV work has no mark (count 0). Once per
+  // section: the second mark completes the token, so the row check after the
+  // forward-end conversion does not repeat it.
+  auto check_marks = [&] {
+    for (size_t job = 0; job < n_items; ++job) {
+      page_t* page = token_pages[job_tokens[job].i];
+      const size_t offset = static_cast<size_t>(page->offset_in_page(job_tokens[job]));
+      REQUIRE_FALSE(page->is_kv_complete(slot, offset));
+      REQUIRE(page->mark_k_complete(slot, offset) == (do_kv[job] != 0));
+    }
+  };
+
+  // Rows 0..4 and 8 of page 0 are saved before the pass, so the pass's run
+  // 5..15 (minus the job of token 8, which has no KV work) completes block 0
+  // of page 0 through save_k: the block is queued and converted at the forward
+  // end (convert_pending_k_blocks, Note [K VNNI storage]). Block 3 of page 0 is
+  // a whole run and is converted by the block save itself.
+  constexpr size_t pre_saved_rows = 5;
+  constexpr size_t no_kv_token = 8;  // its job has no KV work: add(8, false)
+  auto pre_save = [&] {
+    for (size_t tok = 0; tok <= no_kv_token; ++tok) {
+      if (tok >= pre_saved_rows && tok != no_kv_token) continue;
+      REQUIRE_FALSE(pages[0]->note_k_row_saved(slot, tok));
+    }
+  };
+  auto check_blocks = [&](bool converted) {
+#ifdef TRON_K_VNNI
+    constexpr uint8_t blocks_0_and_3 = 0x9;
+    constexpr uint8_t block_3_only = 0x8;
+    constexpr uint8_t no_block = 0x0;
+    const uint8_t page0 = converted ? blocks_0_and_3 : block_3_only;
+    REQUIRE(pages[0]->template k_vnni_blocks<geometry.kv>(slot) == page0);
+    // The pages the pass does not complete a block of.
+    REQUIRE(pages[1]->template k_vnni_blocks<geometry.kv>(slot) == no_block);
+    REQUIRE(pages[2]->template k_vnni_blocks<geometry.kv>(slot) == no_block);
+#else
+    (void)converted;
+#endif
+  };
+
+  SECTION("one thread: the grouping stores every row and touches nothing else") {
+    bk.fill_random(gen);
+    pre_save();
+    const auto before = snapshot();
+    state.template save_k<geometry>(&q_batch, operation, state.plugin_state.kouts);
+    check(before);
+    check_marks();
+    check_blocks(/*converted=*/false);
+    state.convert_pending_k_blocks();
+    check_blocks(/*converted=*/true);
+    check(before);
+    REQUIRE(q_batch.k_store_window.opened.load() == 0);
+  }
+
+  // Note [Row-major blocks under hardware attention] in kv_cache.hpp: the rows
+  // land the same way; only the row bits and the forward-end conversion of the
+  // hardware-scored operation are skipped. Catch2 builds a fresh state for
+  // every SECTION, so the flag needs no reset.
+  constexpr uint8_t operation_uses_hw = 1;
+  SECTION("hardware attention scores the operation: the completed block stays "
+          "row-major, the whole-block save is still VNNI") {
+    bk.fill_random(gen);
+    pre_save();
+    state.attention_operation_uses_hw[operation.binding.operation.i] =
+        operation_uses_hw;
+    const auto before = snapshot();
+    state.template save_k<geometry>(&q_batch, operation, state.plugin_state.kouts);
+    check(before);
+    check_marks();
+    check_blocks(/*converted=*/false);
+    state.convert_pending_k_blocks();
+    check_blocks(/*converted=*/false);
+    check(before);
+  }
+
+  SECTION("hardware attention scores another operation: this one still converts") {
+    // The flag is read for the saving operation, not for another id space
+    // (operation 0 is also layer 0 and KV slot 0; operation 1 is not).
+    bk.fill_random(gen);
+    pre_save();
+    constexpr size_t other_operation = 1;
+    const attention_op_id other =
+        state.active_attention_operations[other_operation].binding.operation;
+    REQUIRE(other != operation.binding.operation);
+    state.attention_operation_uses_hw[other.i] = operation_uses_hw;
+    const auto before = snapshot();
+    state.template save_k<geometry>(&q_batch, operation, state.plugin_state.kouts);
+    check(before);
+    check_marks();
+    check_blocks(/*converted=*/false);
+    state.convert_pending_k_blocks();
+    check_blocks(/*converted=*/true);
+    check(before);
+  }
+
+  SECTION("three threads: the helpers share the window and every row lands once") {
+    bk.fill_random(gen);
+    pre_save();
+    const auto before = snapshot();
+    constexpr size_t n_workers = 3;
+    constexpr size_t main_worker_ix = 0;
+    // Every worker calls the same save_k with its own index (Note [Shared
+    // block save] in model.hpp).
+    std::vector<std::thread> helpers;
+    for (size_t worker_ix = 1; worker_ix < n_workers; ++worker_ix) {
+      helpers.emplace_back([&, worker_ix] {
+        state.template save_k<geometry>(
+            &q_batch, operation, state.plugin_state.kouts, worker_ix, n_workers);
+      });
+    }
+    state.template save_k<geometry>(
+        &q_batch, operation, state.plugin_state.kouts, main_worker_ix, n_workers);
+    for (auto& h : helpers) {
+      h.join();
+    }
+    check(before);
+    check_marks();
+    check_blocks(/*converted=*/false);
+    state.convert_pending_k_blocks();
+    check_blocks(/*converted=*/true);
+    check(before);
+    if constexpr (k_vnni::layout_on<head_size>) {
+      auto const& w = q_batch.k_store_window;
+      REQUIRE(w.opened.load() == 1);
+      REQUIRE(w.finished.load() == n_workers - 1);
+      // The work units cover the items in order, and every unit was claimed.
+      // The exact cut is not a contract: the writers only need that a unit
+      // never crosses a page, a 16-token page block or a change of
+      // token_jobs_do_kv (batch::k_store_window), so that two units never
+      // write the same token lanes and a unit that fills its block may use
+      // whole-line stores.
+      REQUIRE(w.n_units >= 1);
+      REQUIRE(w.unit_start[0] == 0);
+      REQUIRE(w.unit_start[w.n_units] == n_items);
+      REQUIRE(w.next_unit.load() >= w.n_units);
+      for (size_t u = 0; u < w.n_units; ++u) {
+        const size_t begin = w.unit_start[u];
+        const size_t end = w.unit_start[u + 1];
+        CAPTURE(u, begin, end);
+        REQUIRE(begin < end);
+        // The job's token position, its page and its 16-token block.
+        auto token_of = [&](size_t item) {
+          return job_tokens[q_batch.items[item].i].i;
+        };
+        auto block_of = [&](size_t tok) {
+          return (tok % page_t::page_size) / k_vnni::BLOCK_TOKENS_16;
+        };
+        const bool unit_kv = do_kv[q_batch.items[begin].i] != 0;
+        const page_t* unit_page = unit_kv ? token_pages[token_of(begin)] : nullptr;
+        const size_t unit_block = unit_kv ? block_of(token_of(begin)) : 0;
+        for (size_t t = begin; t < end; ++t) {
+          CAPTURE(t);
+          REQUIRE((do_kv[q_batch.items[t].i] != 0) == unit_kv);
+          if (unit_kv) {
+            REQUIRE(token_pages[token_of(t)] == unit_page);
+            REQUIRE(block_of(token_of(t)) == unit_block);
+          }
+        }
+      }
+    } else {
+      REQUIRE(q_batch.k_store_window.opened.load() == 0);
+    }
+  }
+}
+
