-using bf16 = uint16_t;
-
-// ---------- scalar helpers ----------
-static inline float b2f(bf16 v) {
-  uint32_t u = (uint32_t)v << 16;
-  float f;
-  std::memcpy(&f, &u, 4);
-  return f;
-}
-static inline bf16 f2b(float f) {  // round-to-nearest-even, like cvtne
-  uint32_t u;
-  std::memcpy(&u, &f, 4);
-  uint32_t lsb = (u >> 16) & 1;
-  u += 0x7fff + lsb;
-  return (bf16)(u >> 16);
-}
-
-// fast exp used IDENTICALLY by all variants (so softmax cost is comparable):
-// exp(x) via exp2(x * log2e), 2^i * poly(f). Max rel err ~2e-7, fine at tol 2e-2.
-static inline __m512 vexp(__m512 x) {
-  const __m512 log2e = _mm512_set1_ps(1.442695041f);
-  const __m512 c0 = _mm512_set1_ps(1.0f);
-  const __m512 c1 = _mm512_set1_ps(0.6931472f);
-  const __m512 c2 = _mm512_set1_ps(0.2402265f);
-  const __m512 c3 = _mm512_set1_ps(0.0555041f);
-  const __m512 c4 = _mm512_set1_ps(0.0096181f);
-  const __m512 c5 = _mm512_set1_ps(0.0013333f);
-  __m512 t = _mm512_mul_ps(x, log2e);
-  __m512 r = _mm512_roundscale_ps(t, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
-  __m512 f = _mm512_sub_ps(t, r);  // |f| <= 0.5
-  // 2^f polynomial evaluated directly on f (coefficients already include ln2 powers)
-  __m512 p = _mm512_fmadd_ps(c5, f, c4);
-  p = _mm512_fmadd_ps(p, f, c3);
-  p = _mm512_fmadd_ps(p, f, c2);
-  p = _mm512_fmadd_ps(p, f, c1);
-  p = _mm512_fmadd_ps(p, f, c0);
-  return _mm512_scalef_ps(p, r);  // p * 2^r
-}
