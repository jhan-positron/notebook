-// ---------- 16x16 fp32 transpose (validated against reference below) ----------
-static inline void transpose16x16(
-    const float* src, int src_stride_f, float* dst, int dst_stride_f) {
-  // Stage 1: within each 4-row group g, build u[g][k] whose 128-bit lane l
-  // holds column (4l+k) of rows 4g..4g+3.
-  __m512 u[4][4];
-  for (int g = 0; g < 4; g++) {
-    __m512 r0 = _mm512_loadu_ps(src + (4 * g + 0) * src_stride_f);
-    __m512 r1 = _mm512_loadu_ps(src + (4 * g + 1) * src_stride_f);
-    __m512 r2 = _mm512_loadu_ps(src + (4 * g + 2) * src_stride_f);
-    __m512 r3 = _mm512_loadu_ps(src + (4 * g + 3) * src_stride_f);
-    __m512 t0 = _mm512_unpacklo_ps(r0, r1);
-    __m512 t1 = _mm512_unpackhi_ps(r0, r1);
-    __m512 t2 = _mm512_unpacklo_ps(r2, r3);
-    __m512 t3 = _mm512_unpackhi_ps(r2, r3);
-    u[g][0] = _mm512_castpd_ps(
-        _mm512_unpacklo_pd(_mm512_castps_pd(t0), _mm512_castps_pd(t2)));
-    u[g][1] = _mm512_castpd_ps(
-        _mm512_unpackhi_pd(_mm512_castps_pd(t0), _mm512_castps_pd(t2)));
-    u[g][2] = _mm512_castpd_ps(
-        _mm512_unpacklo_pd(_mm512_castps_pd(t1), _mm512_castps_pd(t3)));
-    u[g][3] = _mm512_castpd_ps(
-        _mm512_unpackhi_pd(_mm512_castps_pd(t1), _mm512_castps_pd(t3)));
-  }
-  // Stage 2: output row j = 4l+k gathers lane l from u[0..3][k].
-  for (int k = 0; k < 4; k++) {
-    __m512 p = _mm512_shuffle_f32x4(u[0][k], u[1][k], 0x88);  // l0,l2 of g0,g1
-    __m512 q = _mm512_shuffle_f32x4(u[2][k], u[3][k], 0x88);
-    __m512 r = _mm512_shuffle_f32x4(u[0][k], u[1][k], 0xdd);  // l1,l3 of g0,g1
-    __m512 s = _mm512_shuffle_f32x4(u[2][k], u[3][k], 0xdd);
-    _mm512_storeu_ps(dst + (k + 0) * dst_stride_f, _mm512_shuffle_f32x4(p, q, 0x88));
-    _mm512_storeu_ps(dst + (k + 4) * dst_stride_f, _mm512_shuffle_f32x4(r, s, 0x88));
-    _mm512_storeu_ps(dst + (k + 8) * dst_stride_f, _mm512_shuffle_f32x4(p, q, 0xdd));
-    _mm512_storeu_ps(dst + (k + 12) * dst_stride_f, _mm512_shuffle_f32x4(r, s, 0xdd));
-  }
-}
