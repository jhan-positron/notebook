-static constexpr int PAGE = 64;               // tokens per page
-static constexpr int HD = 128;                // head_dim
-static constexpr int MAXQ = 16;               // max query width (one tile)
-static constexpr float SCALE = 0.088388347f;  // 1/sqrt(128), matches qwen log
