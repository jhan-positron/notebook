-// ---------- our AMX kernels ----------
-// Q pack: Q[nq][128] bf16 -> 4 B panels, each 16 rows x 64 B:
-// panel s, row dp (dim pair), lane q: { Q[q][s*32+2dp], Q[q][s*32+2dp+1] },
-// lanes q>=nq zeroed (padding).
-static void pack_q(const bf16* Q, int nq, bf16* Bp /*4*16*64 bf16? bytes*/) {
-  std::memset(Bp, 0, 4 * 16 * 64);
-  for (int s = 0; s < 4; s++) {
-    for (int dp = 0; dp < 16; dp++) {
-      for (int q = 0; q < nq; q++) {
-        bf16* dst = Bp + ((s * 16 + dp) * 32 + q * 2);
-        dst[0] = Q[q * HD + s * 32 + 2 * dp];
-        dst[1] = Q[q * HD + s * 32 + 2 * dp + 1];
-      }
-    }
-  }
-}
-
-// --- mirror-orientation (Bill's formulation) support ---
-// K mirror pack: K[64][128] -> per (k-step s, token-block c) B panel of
-// 16 dim-pair rows x 16 tokens x 2 bf16.  Cost is EXCLUDED from the page loop
-// (write-through-at-save_k model); charged separately in system-level runs.
-static void pack_k_mirror(const bf16* K, bf16* M /*4*4*16*32 bf16*/) {
-  for (int s = 0; s < 4; s++) {
-    for (int c = 0; c < 4; c++) {
-      for (int dp = 0; dp < 16; dp++) {
-        for (int t = 0; t < 16; t++) {
-          bf16* dst = M + (((s * 4 + c) * 16 + dp) * 16 + t) * 2;
-          dst[0] = K[(c * 16 + t) * HD + s * 32 + 2 * dp];
-          dst[1] = K[(c * 16 + t) * HD + s * 32 + 2 * dp + 1];
-        }
-      }
-    }
-  }
-}
-
-// QK row-major (mirror orientation): S[16 q][64 tok] = Q . K^T, no transpose.
-// A = Q padded rows (stride 256 B); B = K mirror panels; C tiles per token block.
-static void qk_amx_rowmajor(const bf16* Qp, const bf16* M, float S[MAXQ][PAGE]) {
-  _tile_zero(0);
-  _tile_zero(1);
-  _tile_zero(2);
-  _tile_zero(3);
-  for (int s = 0; s < 4; s++) {
-    _tile_loadd(4, Qp + s * 32, 256);
-    _tile_loadd(5, M + ((s * 4 + 0) * 16 * 16) * 2, 64);
-    _tile_dpbf16ps(0, 4, 5);
-    _tile_loadd(6, M + ((s * 4 + 1) * 16 * 16) * 2, 64);
-    _tile_dpbf16ps(1, 4, 6);
-    _tile_loadd(5, M + ((s * 4 + 2) * 16 * 16) * 2, 64);
-    _tile_dpbf16ps(2, 4, 5);
-    _tile_loadd(6, M + ((s * 4 + 3) * 16 * 16) * 2, 64);
-    _tile_dpbf16ps(3, 4, 6);
-  }
-  _tile_stored(0, &S[0][0], PAGE * 4);
-  _tile_stored(1, &S[0][16], PAGE * 4);
-  _tile_stored(2, &S[0][32], PAGE * 4);
-  _tile_stored(3, &S[0][48], PAGE * 4);
-}
-
-// QK: S^T[64][16] = K_page . Q^T ; C tiles tmm0-3 (16 tokens each)
-static void qk_amx(const bf16* K, const bf16* Bp, float* St /*64x16, stride 16f*/) {
-  _tile_zero(0);
-  _tile_zero(1);
-  _tile_zero(2);
-  _tile_zero(3);
-  for (int s = 0; s < 4; s++) {
-    _tile_loadd(6, Bp + s * 16 * 32, 64);
-    _tile_loadd(4, K + 0 * 16 * HD + s * 32, 256);
-    _tile_dpbf16ps(0, 4, 6);
-    _tile_loadd(5, K + 1 * 16 * HD + s * 32, 256);
-    _tile_dpbf16ps(1, 5, 6);
-    _tile_loadd(4, K + 2 * 16 * HD + s * 32, 256);
-    _tile_dpbf16ps(2, 4, 6);
-    _tile_loadd(5, K + 3 * 16 * HD + s * 32, 256);
-    _tile_dpbf16ps(3, 5, 6);
-  }
-  _tile_stored(0, St + 0 * 16 * 16, 64);
-  _tile_stored(1, St + 1 * 16 * 16, 64);
-  _tile_stored(2, St + 2 * 16 * 16, 64);
-  _tile_stored(3, St + 3 * 16 * 16, 64);
-}
-
-// transpose St(64x16) -> S(nq x 64) with the scale applied during the store
-// (one combined pass), producing only the nq rows that are actually needed.
-static void st_to_s(const float* St, float S[MAXQ][PAGE], int nq) {
-  const __m512 sc = _mm512_set1_ps(SCALE);
-  for (int r = 0; r < 4; r++) {  // r = 16-token block
-    const float* src = St + r * 256;
-    __m512 u[4][4];
-    for (int g = 0; g < 4; g++) {
-      __m512 r0 = _mm512_loadu_ps(src + (4 * g + 0) * 16);
-      __m512 r1 = _mm512_loadu_ps(src + (4 * g + 1) * 16);
-      __m512 r2 = _mm512_loadu_ps(src + (4 * g + 2) * 16);
-      __m512 r3 = _mm512_loadu_ps(src + (4 * g + 3) * 16);
-      __m512 t0 = _mm512_unpacklo_ps(r0, r1);
-      __m512 t1 = _mm512_unpackhi_ps(r0, r1);
-      __m512 t2 = _mm512_unpacklo_ps(r2, r3);
-      __m512 t3 = _mm512_unpackhi_ps(r2, r3);
-      u[g][0] = _mm512_castpd_ps(
-          _mm512_unpacklo_pd(_mm512_castps_pd(t0), _mm512_castps_pd(t2)));
-      u[g][1] = _mm512_castpd_ps(
-          _mm512_unpackhi_pd(_mm512_castps_pd(t0), _mm512_castps_pd(t2)));
-      u[g][2] = _mm512_castpd_ps(
-          _mm512_unpacklo_pd(_mm512_castps_pd(t1), _mm512_castps_pd(t3)));
-      u[g][3] = _mm512_castpd_ps(
-          _mm512_unpackhi_pd(_mm512_castps_pd(t1), _mm512_castps_pd(t3)));
-    }
-    for (int k = 0; k < 4; k++) {
-      __m512 p = _mm512_shuffle_f32x4(u[0][k], u[1][k], 0x88);
-      __m512 q = _mm512_shuffle_f32x4(u[2][k], u[3][k], 0x88);
-      _mm512_storeu_ps(
-          &S[k][r * 16], _mm512_mul_ps(_mm512_shuffle_f32x4(p, q, 0x88), sc));
-      if (nq > 4) {
-        _mm512_storeu_ps(&S[k + 4][r * 16],
-            _mm512_mul_ps(
-                _mm512_shuffle_f32x4(_mm512_shuffle_f32x4(u[0][k], u[1][k], 0xdd),
-                    _mm512_shuffle_f32x4(u[2][k], u[3][k], 0xdd), 0x88),
-                sc));
-      }
-      if (nq > 8) {
-        __m512 rr = _mm512_shuffle_f32x4(u[0][k], u[1][k], 0xdd);
-        __m512 ss = _mm512_shuffle_f32x4(u[2][k], u[3][k], 0xdd);
-        _mm512_storeu_ps(
-            &S[k + 8][r * 16], _mm512_mul_ps(_mm512_shuffle_f32x4(p, q, 0xdd), sc));
-        _mm512_storeu_ps(
-            &S[k + 12][r * 16], _mm512_mul_ps(_mm512_shuffle_f32x4(rr, ss, 0xdd), sc));
-      }
-    }
-  }
-}
-
-// PV: O[16][128] += P[16][64] . V_page, output blocking 4+4 or 6+2.
-// A = P rows (flat, stride 128 B); B = V as stored ([pair][dim][2], pair-row
-// stride 512 B, dim-block offset c*64 B).
-static void pv_amx(
-    const bf16* V, const bf16 P[MAXQ][PAGE], float* O /*16x128*/, bool six_two) {
-  if (!six_two) {  // 4+4: tiles 0-3 = C, 4 = A, 5 = B
-    for (int half = 0; half < 2; half++) {
-      _tile_zero(0);
-      _tile_zero(1);
-      _tile_zero(2);
-      _tile_zero(3);
-      for (int s = 0; s < 2; s++) {
-        _tile_loadd(4, &P[0][s * 32], 128);
-        for (int c = 0; c < 4; c++) {
-          _tile_loadd(5, V + s * 16 * HD * 2 + (half * 4 + c) * 32, 512);
-          switch (c) {
-          case 0:
-            _tile_dpbf16ps(0, 4, 5);
-            break;
-          case 1:
-            _tile_dpbf16ps(1, 4, 5);
-            break;
-          case 2:
-            _tile_dpbf16ps(2, 4, 5);
-            break;
-          case 3:
-            _tile_dpbf16ps(3, 4, 5);
-            break;
-          }
-        }
-      }
-      _tile_stored(0, O + half * 64 + 0, 512);  // stride 512 B = one O row
-      _tile_stored(1, O + half * 64 + 16, 512);
-      _tile_stored(2, O + half * 64 + 32, 512);
-      _tile_stored(3, O + half * 64 + 48, 512);
-    }
-  } else {  // 6+2: tiles 0-5 = C, 6 = A, 7 = B
-    // block 1: dims 0-95 (6 tiles)
-    _tile_zero(0);
-    _tile_zero(1);
-    _tile_zero(2);
-    _tile_zero(3);
-    _tile_zero(4);
-    _tile_zero(5);
-    for (int s = 0; s < 2; s++) {
-      _tile_loadd(6, &P[0][s * 32], 128);
-      for (int c = 0; c < 6; c++) {
-        _tile_loadd(7, V + s * 16 * HD * 2 + c * 32, 512);
-        switch (c) {
-        case 0:
-          _tile_dpbf16ps(0, 6, 7);
-          break;
-        case 1:
-          _tile_dpbf16ps(1, 6, 7);
-          break;
-        case 2:
-          _tile_dpbf16ps(2, 6, 7);
-          break;
-        case 3:
-          _tile_dpbf16ps(3, 6, 7);
-          break;
-        case 4:
-          _tile_dpbf16ps(4, 6, 7);
-          break;
-        case 5:
-          _tile_dpbf16ps(5, 6, 7);
-          break;
-        }
-      }
-    }
-    _tile_stored(0, O + 0, 512);
-    _tile_stored(1, O + 16, 512);
-    _tile_stored(2, O + 32, 512);
-    _tile_stored(3, O + 48, 512);
-    _tile_stored(4, O + 64, 512);
-    _tile_stored(5, O + 80, 512);
-    // block 2: dims 96-127 (2 tiles)
-    _tile_zero(0);
-    _tile_zero(1);
-    for (int s = 0; s < 2; s++) {
-      _tile_loadd(6, &P[0][s * 32], 128);
-      for (int c = 0; c < 2; c++) {
-        _tile_loadd(7, V + s * 16 * HD * 2 + (6 + c) * 32, 512);
-        if (c == 0) {
-          _tile_dpbf16ps(0, 6, 7);
-        } else {
-          _tile_dpbf16ps(1, 6, 7);
-        }
-      }
-    }
-    _tile_stored(0, O + 96, 512);
-    _tile_stored(1, O + 112, 512);
-  }
-}
-#endif  // __AMX_BF16__
-
-// ---------- scalar reference ----------
-static void reference(const std::vector<bf16>& Kv,
-    const std::vector<bf16>& Vv,
-    const bf16* Q,
-    int nq,
-    int npages,
-    accum& ac) {
-  ac.reset(nq);
-  for (int pg = 0; pg < npages; pg++) {
-    const bf16* K = Kv.data() + (size_t)pg * PAGE * HD;
-    const bf16* V = Vv.data() + (size_t)pg * PAGE * HD;
-    for (int q = 0; q < nq; q++) {
-      float s_row[PAGE];
-      for (int t = 0; t < PAGE; t++) {
-        float acc = 0;
-        for (int d = 0; d < HD; d++) {
-          acc += b2f(Q[q * HD + d]) * b2f(K[t * HD + d]);
-        }
-        s_row[t] = acc * SCALE;
-      }
-      float pm = *std::max_element(s_row, s_row + PAGE);
-      float m_new = std::max(pm, ac.m[q]);
-      float corr = std::exp(ac.m[q] - m_new);
-      float ssum = 0;
-      float pv[HD] = {0};
-      for (int t = 0; t < PAGE; t++) {
-        float e = std::exp(s_row[t] - m_new);
-        e = b2f(f2b(e));  // P is bf16 in all fast paths
-        ssum += e;
-        for (int d = 0; d < HD; d++) {
-          pv[d] += e * b2f(V[(t / 2) * HD * 2 + d * 2 + (t & 1)]);
-        }
-      }
-      ac.m[q] = m_new;
-      ac.s[q] = ac.s[q] * corr + ssum;
-      for (int d = 0; d < HD; d++) {
-        ac.v[q][d] = ac.v[q][d] * corr + pv[d];
-      }
-    }
-  }
-}
-
-int main(int argc, char** argv) {
-  int nq = argc > 1 ? atoi(argv[1]) : 4;
-  long iters = argc > 2 ? atol(argv[2]) : 50000;
-  std::string variant = argc > 3 ? argv[3] : "amx44";
-  int npages = argc > 4 ? atoi(argv[4]) : 1;
-  if (nq < 1 || nq > 16) {
-    fprintf(stderr, "Nq in 1..16\n");
-    return 1;
-  }
-  bool is_qk_mirror = variant == "amxqk";
-  bool is_pipelined = variant == "amxpl";  // our orientation, score handling lags
-                                           // one page behind the tile stores
-  bool is_amx =
-      variant == "amx44" || variant == "amx62" || is_qk_mirror || is_pipelined;
-#ifndef __AMX_BF16__
-  if (is_amx) {
-    fprintf(stderr, "not an AMX build\n");
-    return 1;
-  }
-#endif
-  if (is_amx && !amx_request()) {
-    fprintf(stderr, "arch_prctl failed\n");
-    return 1;
-  }
-
-  // buffers (page ring)
-  std::vector<bf16> K((size_t)npages * PAGE * HD), V((size_t)npages * PAGE * HD);
-  std::vector<bf16> Q(MAXQ * HD, 0);
-  srand(7);
-  auto rnd = [] { return f2b(((float)rand() / RAND_MAX - 0.5f) * 0.6f); };
-  for (auto& x : K) {
-    x = rnd();
-  }
-  for (auto& x : V) {
-    x = rnd();
-  }
-  for (int q = 0; q < nq; q++) {
-    for (int d = 0; d < HD; d++) {
-      Q[q * HD + d] = rnd();
-    }
-  }
-
-  alignas(64) static float S[MAXQ][PAGE];
-  alignas(64) static bf16 P[MAXQ][PAGE];
-  std::memset(P, 0, sizeof(P));  // pad rows stay zero
-  alignas(64) static float St[PAGE * 16];
-  alignas(64) static float St2[2][PAGE * 16];  // double buffer for amxpl
-  alignas(64) static float O[16 * HD];
-  alignas(64) static bf16 Bp[4 * 16 * 32];
-  alignas(64) static bf16 Qpad[MAXQ * HD];  // zero-padded Q for mirror orientation
-  std::vector<bf16> Kmir;                   // K mirror ring (amxqk only)
-  accum ac, ref;
-
-  // validate the vector transpose once
-  {
-    alignas(64) float a[256], b[256], c[256];
-    for (int i = 0; i < 256; i++) {
-      a[i] = (float)i * 0.5f - 31.f;
-    }
-    transpose16x16(a, 16, b, 16);
-    transpose16x16_ref(a, 16, c, 16);
-    for (int i = 0; i < 256; i++) {
-      if (b[i] != c[i]) {
-        fprintf(stderr, "transpose16x16 BROKEN at %d\n", i);
-        return 1;
-      }
-    }
-  }
-
-#ifdef __AMX_BF16__
-  if (is_qk_mirror) {  // build the K mirror once (write-through model)
-    Kmir.resize((size_t)npages * 4 * 4 * 16 * 32);
-    for (int pg = 0; pg < npages; pg++) {
-      pack_k_mirror(K.data() + (size_t)pg * PAGE * HD,
-          Kmir.data() + (size_t)pg * 4 * 4 * 16 * 32);
-    }
-    std::memset(Qpad, 0, sizeof(Qpad));
-    std::memcpy(Qpad, Q.data(), (size_t)nq * HD * sizeof(bf16));
-  }
-#endif
-
-  auto run_pages = [&](accum& a2) {
-#ifdef __AMX_BF16__
-    if (is_amx) {
-      amx_config_maxshape();
-      if (!is_qk_mirror) pack_q(Q.data(), nq, Bp);
-    }
-#endif
-    a2.reset(nq);
-    for (int pg = 0; pg < npages; pg++) {
-      const bf16* Kp = K.data() + (size_t)pg * PAGE * HD;
-      const bf16* Vp = V.data() + (size_t)pg * PAGE * HD;
-      if (!is_amx) {
-        qk_avx(Kp, Q.data(), nq, S);
-        softmax_page(S, nq, a2, P);
-        pv_avx(Vp, P, nq, a2);
-      }
-#ifdef __AMX_BF16__
-      else if (is_qk_mirror) {
-        qk_amx_rowmajor(Qpad, Kmir.data() + (size_t)pg * 4 * 4 * 16 * 32, S);
-        const __m512 sc = _mm512_set1_ps(SCALE);  // scale pass (no transpose)
-        for (int q2 = 0; q2 < nq; q2++) {
-          for (int c = 0; c < PAGE; c += 16) {
-            __m512 v = _mm512_mul_ps(_mm512_loadu_ps(&S[q2][c]), sc);
-            _mm512_storeu_ps(&S[q2][c], v);
-          }
-        }
-        softmax_page(S, nq, a2, P);
-        pv_amx(Vp, P, O, false);  // 4+4 (the adopted blocking)
-        for (int q2 = 0; q2 < nq; q2++) {
-          for (int d = 0; d < HD; d += 16) {
-            __m512 v = _mm512_loadu_ps(a2.v[q2] + d);
-            v = _mm512_add_ps(v, _mm512_loadu_ps(O + q2 * HD + d));
-            _mm512_storeu_ps(a2.v[q2] + d, v);
-          }
-        }
-      } else if (is_pipelined) {
-        // page pg: tile-compute scores into buffer pg%2; then handle the
-        // PREVIOUS page's scores (stored one iteration ago - no store-to-load
-        // stall) and its PV. The final page is drained after the loop.
-        qk_amx(Kp, Bp, St2[pg & 1]);
-        if (pg > 0) {
-          const bf16* Vprev = V.data() + (size_t)(pg - 1) * PAGE * HD;
-          st_to_s(St2[(pg - 1) & 1], S, nq);
-          softmax_page(S, nq, a2, P);
-          pv_amx(Vprev, P, O, false);
-          for (int q2 = 0; q2 < nq; q2++) {
-            for (int d = 0; d < HD; d += 16) {
-              __m512 v = _mm512_loadu_ps(a2.v[q2] + d);
-              v = _mm512_add_ps(v, _mm512_loadu_ps(O + q2 * HD + d));
-              _mm512_storeu_ps(a2.v[q2] + d, v);
-            }
-          }
-        }
-        if (pg == npages - 1) {  // drain the last page
-          const bf16* Vlast = Vp;
-          st_to_s(St2[pg & 1], S, nq);
-          softmax_page(S, nq, a2, P);
-          pv_amx(Vlast, P, O, false);
-          for (int q2 = 0; q2 < nq; q2++) {
-            for (int d = 0; d < HD; d += 16) {
-              __m512 v = _mm512_loadu_ps(a2.v[q2] + d);
-              v = _mm512_add_ps(v, _mm512_loadu_ps(O + q2 * HD + d));
-              _mm512_storeu_ps(a2.v[q2] + d, v);
-            }
-          }
-        }
-      } else {
-        qk_amx(Kp, Bp, St);
-        st_to_s(St, S, nq);
-        softmax_page(S, nq, a2, P);
-        pv_amx(Vp, P, O, variant == "amx62");
-        for (int q = 0; q < nq; q++) {
-          for (int d = 0; d < HD; d += 16) {
-            __m512 v = _mm512_loadu_ps(a2.v[q] + d);
-            v = _mm512_add_ps(v, _mm512_loadu_ps(O + q * HD + d));
-            _mm512_storeu_ps(a2.v[q] + d, v);
-          }
-        }
-      }
-#endif
-    }
-#ifdef __AMX_BF16__
-    if (is_amx) _tile_release();
-#endif
-  };
-
-  // correctness vs scalar reference (skipped for huge rings; correctness is
-  // width/variant-dependent, not ring-size-dependent)
-  double worst = 0;
-  if (npages <= 64) {
-    reference(K, V, Q.data(), nq, npages, ref);
-    run_pages(ac);
-    for (int q = 0; q < nq; q++) {
-      for (int d = 0; d < HD; d++) {
-        double a = ac.v[q][d] / ac.s[q], b = ref.v[q][d] / ref.s[q];
-        double rel = std::fabs(a - b) / (std::fabs(b) + 1e-3);
-        worst = std::max(worst, rel);
-      }
-    }
-    if (worst > 2e-2) {
-      fprintf(stderr, "CORRECTNESS FAIL: worst rel err %.4g\n", worst);
-      return 1;
-    }
-  }
-
-  // timing
-  for (int w = 0; w < 3; w++) {
-    run_pages(ac);  // warmup
-  }
-  struct timespec t0, t1;
-  clock_gettime(CLOCK_MONOTONIC, &t0);
-  for (long i = 0; i < iters; i++) {
-    run_pages(ac);
-  }
-  clock_gettime(CLOCK_MONOTONIC, &t1);
-  double ns = (t1.tv_sec - t0.tv_sec) * 1e9 + (t1.tv_nsec - t0.tv_nsec);
-  double per_page = ns / ((double)iters * npages);
-  double macs = 2.0 * nq * PAGE * HD;  // QK + PV per page (useful MACs)
-  printf("Nq=%d variant=%s pages=%d iters=%ld per_page_ns=%.1f useful_GFLOPS=%.1f "
-         "worst_rel_err=%.2e\n",
-      nq, variant.c_str(), npages, iters, per_page, 2.0 * macs / per_page, worst);
-  return 0;
-}
