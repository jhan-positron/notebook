-// ---------- AVX baseline (shipping-kernel instruction patterns) ----------
-// dotter<bf16,128> pattern: Q row preloaded in 4 zmm, per K token 4x dpbf16 + reduce
-static void qk_avx(const bf16* K, const bf16* Q, int nq, float S[MAXQ][PAGE]) {
-  for (int q = 0; q < nq; q++) {
-    __m512i q0 = _mm512_loadu_si512(Q + q * HD);
-    __m512i q1 = _mm512_loadu_si512(Q + q * HD + 32);
-    __m512i q2 = _mm512_loadu_si512(Q + q * HD + 64);
-    __m512i q3 = _mm512_loadu_si512(Q + q * HD + 96);
-    for (int t = 0; t < PAGE; t++) {
-      const bf16* k = K + t * HD;
-      __m512 a0 = _mm512_dpbf16_ps(
-          _mm512_setzero_ps(), (__m512bh)q0, (__m512bh)_mm512_loadu_si512(k));
-      __m512 a1 = _mm512_dpbf16_ps(
-          _mm512_setzero_ps(), (__m512bh)q1, (__m512bh)_mm512_loadu_si512(k + 32));
-      a0 = _mm512_dpbf16_ps(a0, (__m512bh)q2, (__m512bh)_mm512_loadu_si512(k + 64));
-      a1 = _mm512_dpbf16_ps(a1, (__m512bh)q3, (__m512bh)_mm512_loadu_si512(k + 96));
-      S[q][t] = _mm512_reduce_add_ps(_mm512_add_ps(a0, a1)) * SCALE;
-    }
-  }
-}
-// scaled_v pattern: 8 fp32 accumulators over dims, dpbf16 per token pair
-static void pv_avx(const bf16* V, const bf16 P[MAXQ][PAGE], int nq, accum& ac) {
-  for (int q = 0; q < nq; q++) {
-    __m512 acc[8];
-    for (int i = 0; i < 8; i++) {
-      acc[i] = _mm512_setzero_ps();
-    }
-    for (int p = 0; p < PAGE / 2; p++) {
-      uint32_t pair;
-      std::memcpy(&pair, &P[q][2 * p], 4);
-      __m512i pb = _mm512_set1_epi32((int)pair);
-      const bf16* v = V + p * HD * 2;  // [pair][dim][2]
-      for (int i = 0; i < 8; i++) {
-        acc[i] = _mm512_dpbf16_ps(
