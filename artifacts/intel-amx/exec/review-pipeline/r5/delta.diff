-      }
-    }
-    for (int i = 0; i < 8; i++) {
-      __m512 v = _mm512_loadu_ps(ac.v[q] + i * 16);
-      _mm512_storeu_ps(ac.v[q] + i * 16, _mm512_add_ps(v, acc[i]));
-    }
-  }
-}
