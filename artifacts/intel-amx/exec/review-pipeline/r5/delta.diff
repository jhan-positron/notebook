-// S[q][64] fp32 (already scaled) -> update m,s, produce P bf16 [16][64]
-// (pad rows zeroed once by caller), and per-query rescale factor applied to v*.
-static inline void softmax_page(
-    float S[MAXQ][PAGE], int nq, accum& ac, bf16 P[MAXQ][PAGE]) {
-  for (int q = 0; q < nq; q++) {
-    __m512 mx = _mm512_loadu_ps(S[q]);
-    for (int c = 16; c < PAGE; c += 16) {
-      mx = _mm512_max_ps(mx, _mm512_loadu_ps(S[q] + c));
-    }
-    float pm = _mm512_reduce_max_ps(mx);
-    bool max_moved = pm > ac.m[q];
-    float m_new = max_moved ? pm : ac.m[q];
-    __m512 vm = _mm512_set1_ps(m_new);
-    __m512 acc = _mm512_setzero_ps();
-    for (int c = 0; c < PAGE; c += 16) {
-      __m512 e = vexp(_mm512_sub_ps(_mm512_loadu_ps(S[q] + c), vm));
-      acc = _mm512_add_ps(acc, e);
-      __m256i eb = (__m256i)_mm512_cvtneps_pbh(e);
-      _mm256_storeu_si256((__m256i*)(P[q] + c), eb);
-    }
-    if (max_moved) {  // rescale needed only when the running max moved
-      float corr = std::exp(ac.m[q] - m_new);
-      ac.m[q] = m_new;
-      ac.s[q] = ac.s[q] * corr + _mm512_reduce_add_ps(acc);
-      __m512 vc = _mm512_set1_ps(corr);
-      for (int d = 0; d < HD; d += 16) {
-        __m512 v = _mm512_loadu_ps(ac.v[q] + d);
-        _mm512_storeu_ps(ac.v[q] + d, _mm512_mul_ps(v, vc));
-      }
-    } else {
-      ac.s[q] += _mm512_reduce_add_ps(acc);
-    }
-  }
-}
