+using v_plane_owner = tron::v_vnni_tensor<PAGE_TOKENS_64, HEAD_SIZE_128>;
+
+// One packed V plane with random bf16 content, filled through the typed write
+// path (append_v_row) like check_pv's owner; on the heap for its alignment.
+std::unique_ptr<v_plane_owner> random_v_owner(uint32_t seed) {
+  std::mt19937 gen(seed);
+  std::uniform_real_distribution<float> uv(-1.f, 1.f);
+  auto owner = std::make_unique<v_plane_owner>();
+  for (size_t t = 0; t < PAGE_TOKENS_64; ++t) {
+    alignas(tron::chunk_alignment) tron::bf16 row[HEAD_SIZE_128];
+    for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+      row[d] = tron::bf16::from_bits(bf16_rne(uv(gen)));
+    }
+    tron::append_v_row(owner->as_view(), t, tron::v_source_row<HEAD_SIZE_128>(row));
+  }
+  return owner;
+}
+
+// Note [Next-page prefetch] in amx_attn_iface.hpp: the kernels take the next
+// page's planes only to prefetch them, and a prefetch has no architectural
+// effect. So the outputs with and without the planes must be the same bit for
+// bit, and the prefetched page must keep its bytes. This pins that contract:
+// a change that reads a value through next_k / next_v, or writes through
+// them, fails here before it can change a token.
+template <size_t group_heads>
+void check_prefetch_identity() {
+  // QK: score page `cur` twice, the second time with page `next` to prefetch.
+  auto cur = std::make_unique<qk_inputs<group_heads>>();
+  auto next = std::make_unique<qk_inputs<group_heads>>();
+  fill_qk(*cur, 21u);
+  fill_qk(*next, 22u);
+  const auto next_before = std::make_unique<qk_inputs<group_heads>>(*next);
+  alignas(64) tron::bf16 q_packed[tron::amx_attn_h128g4::Q_PACK_ELEMS_2048] = {};
+  tron::amx_attn_h128g4::pack_q_group_128x4<group_heads>(cur->q, q_packed);
+  alignas(64) float s_plain[GROUP_HEADS_16][PAGE_TOKENS_64] = {};
+  alignas(64) float s_prefetch[GROUP_HEADS_16][PAGE_TOKENS_64] = {};
+  tron::amx_attn_h128g4::begin_region();
+  tron::amx_attn_h128g4::qk_rowmajor_128x4<group_heads>(
+      tron::const_native_k_view<PAGE_TOKENS_64, HEAD_SIZE_128>{cur->k}, q_packed,
+      &s_plain[0][0], PAGE_TOKENS_64, nullptr);
+  tron::amx_attn_h128g4::qk_rowmajor_128x4<group_heads>(
+      tron::const_native_k_view<PAGE_TOKENS_64, HEAD_SIZE_128>{cur->k}, q_packed,
+      &s_prefetch[0][0], PAGE_TOKENS_64, next->k);
+  tron::amx_attn_h128g4::end_region();
+  REQUIRE(std::memcmp(s_plain, s_prefetch, sizeof(s_plain)) == 0);
+  REQUIRE(std::memcmp(next->k, next_before->k, sizeof(next->k)) == 0);
+
+  // PV: the same with two packed V planes and one set of weight rows.
+  auto v_cur = random_v_owner(41u);
+  auto v_next = random_v_owner(42u);
+  const auto v_next_before = std::make_unique<v_plane_owner>(*v_next);
+  std::mt19937 gen(43);
+  std::uniform_real_distribution<float> ue(-10.f, 0.f);
+  alignas(64) float exp_rows[group_heads][PAGE_TOKENS_64];
+  for (auto& row : exp_rows) {
+    for (auto& x : row) {
+      x = std::exp(ue(gen));
+    }
+  }
+  alignas(64) float o_plain[TILE_ROWS_16 * HEAD_SIZE_128] = {};
+  alignas(64) float o_prefetch[TILE_ROWS_16 * HEAD_SIZE_128] = {};
+  tron::amx_attn_h128g4::begin_region();
+  tron::amx_attn_h128g4::weights_times_v_128x4<group_heads>(
+      v_cur->as_view(), &exp_rows[0][0], PAGE_TOKENS_64, o_plain, nullptr);
+  tron::amx_attn_h128g4::weights_times_v_128x4<group_heads>(v_cur->as_view(),
+      &exp_rows[0][0], PAGE_TOKENS_64, o_prefetch,
+      tron::detail::v_vnni_access::prefetch_base(v_next->as_view()));
+  tron::amx_attn_h128g4::end_region();
+  REQUIRE(std::memcmp(o_plain, o_prefetch, sizeof(o_plain)) == 0);
+  REQUIRE(std::memcmp(v_next.get(), v_next_before.get(), sizeof(v_plane_owner)) == 0);
+}
