#!/usr/bin/env python3
"""Generate token-divergence-issue4444-report.html from the td-20261016 campaign records.

Reads (all on NFS):
  exec/results/td-20261016/layers-<off>-vs-<on>.json   per-record comparisons (dd_first_divergence.py)
  exec/results/td-20261016/layers-<off>-vs-<on>.csv    per-key rows (for the layer-0 WO statistics)
  exec/results/td-20261016/steps-<off>-vs-<on>.json    per-step logits comparisons (dd_logits_step.py)
  exec/results/td2-20261016/verdict.txt, steps-*.json  prompt-8192 round (optional)
  exec/results/td3-20261016/verdict.txt, stats-*.txt   attention path counters round (optional)
  exec/td-20261016/ktest/results.txt                   kernel bit-exactness program output
  exec/td-20261016/replay/results.md                   offline replay (numbers quoted as literals below, with the section)
  exec/td-20261016/tiestats/tie_stats.json             near-tie statistics
Every number printed in the page comes from one of these files or from a literal marked with its source.
Usage: python3 gen_report.py [--out PATH]
"""
import argparse
import csv
import html
import json
import math
import os
import re
import statistics

EXEC = "/home/jhan/workspace/intel-AMX/exec"
RES = f"{EXEC}/results/td-20261016"
RES2 = f"{EXEC}/results/td2-20261016"
RES3 = f"{EXEC}/results/td3-20261016"
KTEST = f"{EXEC}/td-20261016/ktest/results.txt"
TIES = f"{EXEC}/td-20261016/tiestats/tie_stats.json"
OUT_DEFAULT = "/home/jhan/workspace/intel-AMX/token-divergence-4444/token-divergence-issue4444-report.html"

# Validated palette (dataviz skill, references/palette.md, light mode): slots 1-3 validate all-pairs.
BLUE, ORANGE, AQUA, YELLOW, VIOLET, RED = "#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#6250d6", "#e34948"
INK, INK2, MUTED, GRID, SURF = "#0b0b0b", "#52514e", "#8a8984", "#e6e5e1", "#fcfcfb"

PAIRS = [  # (off, on, what the pair isolates, mechanism tag)
    ("baseoff", "pocoff", "kill switch on both: main's dotter against the PoC's unpack + dotter on VNNI K (layout only)", "none"),
    ("clean", "baseoff", "main built without AMX against main with the kill switch (the kill-switch contract on row-major K)", "none"),
    ("base", "poc", "AMX on both: the PoC removes the reader's add order; what is left is the page-end path choice", "page-end"),
    ("base", "new", "AMX on both: the VNNI reader's add order against the dotter's on partial pages", "order"),
    ("baseoff", "newoff", "kill switch on both: the reader's add order against the dotter's on every page", "order"),
    ("newoff", "trunc", "AMX order against AVX order, both with truncated weights (order only, AMX vs AVX)", "order"),
    ("new", "trunc", "AMX weights rounded to nearest against truncated, same AMX order (rounding only)", "rounding"),
    ("new", "newoff", "the kill switch on the stack binary: AMX path against reader + AVX path", "rounding+order"),
    ("baseoff", "base", "the kill switch on main: AMX path against dotter + AVX path (the PR 3879 question)", "rounding+order"),
    ("clean", "new", "the issue's question: the row-major binary against the stack's AMX binary", "rounding+order"),
]
ARMS = [
    ("new", "runtron.pr4", "PR 4959 probe commit ea94e95a4e, VNNI K + AMX on", "the stack's binary"),
    ("base", "runtron.main1010", "main 72308ec90c, row-major K, AMX on", "the stack's comparator"),
    ("clean", "runtron.clean", "main 72308ec90c built with TRON_AMX_DISPATCH=OFF", "the issue's row-major binary"),
    ("poc", "runtron.poc", "ea94e95a4e + commit 017181c02d: each VNNI token row unpacked and scored by the row-major dotter", "PoC: removes the reader's add order"),
    ("trunc", "runtron.trunc", "ea94e95a4e + commit 3d1426f549: the AMX PV weights truncated to bf16 like the AVX path", "PoC: removes the rounding-mode difference"),
    ("newoff", "runtron.pr4 + TRON_AMX_DISABLE=1", "the stack's kill switch", "AMX off, VNNI reader + AVX path"),
    ("baseoff", "runtron.main1010 + TRON_AMX_DISABLE=1", "main's kill switch", "AMX off, dotter + AVX path"),
    ("pocoff", "runtron.poc + TRON_AMX_DISABLE=1", "the PoC's kill switch", "AMX off, unpack + dotter + AVX path"),
]


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return None


def read_text(path):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return None


def fmt_e(x, digits=2):
    if x is None:
        return "n/a"
    if x == 0:
        return "0"
    return f"{x:.{digits}e}".replace("e-0", "e-").replace("e+0", "e+")


def pct(x, digits=1):
    return "n/a" if x is None else f"{100 * x:.{digits}f} %"


def layer_stats(off, on):
    """Per-record comparison summary + layer-0 WO statistics from the csv."""
    j = load_json(f"{RES}/layers-{off}-vs-{on}.json")
    out = {"pair": f"{off} vs {on}", "pending": j is None}
    if j is None:
        return out
    s = j["summary"]
    out.update(n=s["n_keys_compared"], n_over=s["n_over_threshold"], first=s["first_over"], min_token=s["min_token_over"],
               missing=(s["n_missing_in_off"], s["n_missing_in_on"]))
    wo = j["by_label"].get("WO", {})
    out["wo_first"] = (wo.get("first_token_over"), wo.get("first_layer_over"), wo.get("n_over"))
    # layer-0 WO over tokens, from the csv
    rows = []
    wo_any = []
    try:
        with open(f"{RES}/layers-{off}-vs-{on}.csv") as f:
            for r in csv.DictReader(f):
                if r["label"] == "WO" and r["layer"] == "0":
                    rows.append((int(r["token"]), float(r["rel_l2"]), float(r["frac_changed"])))
                if r["label"] == "WO" and float(r["rel_l2"]) > 0:
                    wo_any.append((int(r["token"]), int(r["layer"]), float(r["rel_l2"]), float(r["frac_changed"])))
    except OSError:
        pass
    rows.sort()
    wo_any.sort()
    out["wo_first_any"] = wo_any[0] if wo_any else None
    diff = [r for r in rows if r[1] > 0]
    prompt = [r for r in diff if r[0] < 1024]
    dec = [r for r in diff if r[0] >= 1024]
    out["wo0"] = {
        "n_tokens": len(rows), "n_diff": len(diff), "first_tokens": [r[0] for r in diff[:6]],
        "n_diff_prompt": len(prompt), "n_diff_decode": len(dec),
        "median_rel": statistics.median([r[1] for r in diff]) if diff else 0.0,
        "max_rel": max([r[1] for r in diff]) if diff else 0.0,
        "median_frac": statistics.median([r[2] for r in diff]) if diff else 0.0,
        "at_128": next((r for r in rows if r[0] == 128), None),
        "diff_tokens": [r[0] for r in diff],
    }
    # first differing record overall, and the earliest WO record
    return out


def step_stats(off, on):
    j = load_json(f"{RES}/steps-{off}-vs-{on}.json")
    if j is None:
        return None
    s = j["summary"]
    steps = j["steps"]
    flips = [st for st in steps if not st["same_top1"]]
    return {"summary": s, "steps": steps, "flips": flips}


def ktest_lines():
    t = read_text(KTEST) or ""
    want = ("T0 ", "T1 ", "T1b", "T2 ", "T3   lane=s2:(acc+po)+pe reduce=halving", "T4   s2", "T5m qk_vnni_128x4 vs even/odd-chain model, combine=acc+fl(E+O)",
            "T6a", "T6c", "T6d weights_times_v_128x4 vs even/odd-chain model (RNE P), combine=acc+fl(E+O)", "T7a", "T8a", "T9a", "T9b", "T9c")
    out = {}
    for line in t.splitlines():
        for w in want:
            if line.startswith(w):
                out.setdefault(w.strip(), []).append(line)
    return out


def svg_header(w, h):
    return f'<svg viewBox="0 0 {w} {h}" width="100%" style="max-width:{w}px;font-family:inherit" role="img">'


def chart_first_token(layers):
    """Dot plot: first differing record per arm pair (log x), identical pairs at the right edge."""
    W, L, R, T, B = 960, 150, 40, 40, 60
    H = T + 34 * len(PAIRS) + 12 + B
    xs = lambda tok: L + (math.log10(max(tok, 1)) / math.log10(1400)) * (W - L - R)
    out = [svg_header(W, H)]
    out.append(f'<rect x="0" y="0" width="{W}" height="{H}" fill="{SURF}"/>')
    for tok, lab, row in ((1, "token 1", 0), (10, "10", 0), (100, "100", 0), (128, "128", 1), (1000, "1000", 0), (1087, "1087", 1)):
        x = xs(tok)
        out.append(f'<line x1="{x:.1f}" y1="{T}" x2="{x:.1f}" y2="{H - B}" stroke="{GRID}" stroke-width="1"/>')
        out.append(f'<text x="{x:.1f}" y="{H - B + 16 + 13 * row}" font-size="11" fill="{INK2}" text-anchor="middle">{lab}</text>')
    out.append(f'<text x="{(L + W - R) / 2:.0f}" y="{H - 6}" font-size="12" fill="{INK2}" text-anchor="middle">position of the first differing record (prompt tokens 0-1023, decode tokens 1024-1279; log scale)</text>')
    color = {"none": AQUA, "order": BLUE, "rounding": ORANGE, "rounding+order": BLUE, "page-end": VIOLET}
    for i, (off, on, what, mech) in enumerate(PAIRS):
        y = T + 18 + 34 * i
        st = layers[(off, on)]
        out.append(f'<text x="{L - 10}" y="{y + 4}" font-size="12" fill="{INK}" text-anchor="end">{off} vs {on}</text>')
        if st.get("pending"):
            out.append(f'<text x="{L + 6}" y="{y + 4}" font-size="11" fill="{MUTED}">pending</text>')
            continue
        if st["n_over"] == 0:
            x = xs(1280)
            out.append(f'<rect x="{x - 6:.1f}" y="{y - 6}" width="12" height="12" rx="2" fill="{AQUA}"/>')
            out.append(f'<text x="{x - 12:.1f}" y="{y + 4}" font-size="11" fill="{INK2}" text-anchor="end">identical over all {st["n"]:,} records</text>')
            continue
        tok = st["min_token"]
        x = xs(tok)
        out.append(f'<line x1="{xs(1)}" y1="{y}" x2="{x:.1f}" y2="{y}" stroke="{GRID}" stroke-width="2"/>')
        wf = st.get("wo_first_any")
        if wf and wf[0] == tok:
            lab = f'token {tok}: WO layer {wf[1]}, {pct(wf[3])} of its values, relative change {fmt_e(wf[2])}'
        else:
            f = st["first"]
            lab = f'token {tok}: {f["key"].split(" of token")[0]}, {pct(f["frac_changed"])} of its values, relative change {fmt_e(f["rel_l2"])}'
        if mech == "rounding+order" and tok < 128:
            # the rounding cause reaches this pair from token 128 on: a second marker
            x2 = xs(128)
            w0 = st["wo0"]["at_128"]
            out.append(f'<line x1="{x:.1f}" y1="{y}" x2="{x2:.1f}" y2="{y}" stroke="{GRID}" stroke-width="2"/>')
            out.append(f'<circle cx="{x2:.1f}" cy="{y}" r="6" fill="{ORANGE}" stroke="{SURF}" stroke-width="2"/>')
            lab2 = f'token 128: WO layer 0, {pct(w0[2]) if w0 else "n/a"} of values, {fmt_e(w0[1]) if w0 else "n/a"}'
            out.append(f'<text x="{x2 + 10:.1f}" y="{y + 4}" font-size="11" fill="{INK2}">{html.escape(lab2)}</text>')
            out.append(f'<circle cx="{x:.1f}" cy="{y}" r="6" fill="{color[mech]}" stroke="{SURF}" stroke-width="2"/>')
            out.append(f'<text x="{x + 10:.1f}" y="{y - 9}" font-size="11" fill="{INK2}">{html.escape(lab)}</text>')
            continue
        dot_color = ORANGE if (mech == "rounding+order" and tok >= 128) else color[mech]
        out.append(f'<circle cx="{x:.1f}" cy="{y}" r="6" fill="{dot_color}" stroke="{SURF}" stroke-width="2"/>')
        if x < W - 360:
            out.append(f'<text x="{x + 10:.1f}" y="{y + 4}" font-size="11" fill="{INK2}">{html.escape(lab)}</text>')
        else:
            out.append(f'<text x="{x - 10:.1f}" y="{y + 4}" font-size="11" fill="{INK2}" text-anchor="end">{html.escape(lab)}</text>')
    lx = L
    for lab, c in (("add order only", BLUE), ("weight rounding", ORANGE), ("page-end path choice", VIOLET), ("no difference", AQUA)):
        out.append(f'<circle cx="{lx + 6}" cy="{T - 16}" r="5" fill="{c}"/><text x="{lx + 16}" y="{T - 12}" font-size="11" fill="{INK2}">{lab}</text>')
        lx += 16 + 6.5 * len(lab) + 26
    out.append("</svg>")
    return "\n".join(out)


def chart_seam(layers):
    """Bars: the layer-0 WO difference size (median relative L2 over the tokens where it differs) per pair, log scale."""
    items = []
    for off, on, what, mech in PAIRS:
        st = layers[(off, on)]
        if st.get("pending") or st["n_over"] == 0 or not st.get("wo0"):
            continue
        w = st["wo0"]
        if w["n_diff"] == 0:
            continue
        items.append((f"{off} vs {on}", w["median_rel"], w["n_diff"], w["n_tokens"], mech))
    W, H, L, R, T, B = 960, 50 + 30 * len(items) + 40, 220, 170, 30, 40
    lo, hi = 1e-5, 1e-2
    xs = lambda v: L + (math.log10(max(v, lo)) - math.log10(lo)) / (math.log10(hi) - math.log10(lo)) * (W - L - R)
    out = [svg_header(W, H), f'<rect width="{W}" height="{H}" fill="{SURF}"/>']
    for v, lab in ((1e-5, "1e-5"), (1e-4, "1e-4"), (1e-3, "1e-3"), (1e-2, "1e-2")):
        x = xs(v)
        out.append(f'<line x1="{x:.1f}" y1="{T}" x2="{x:.1f}" y2="{H - B}" stroke="{GRID}"/>')
        out.append(f'<text x="{x:.1f}" y="{H - B + 16}" font-size="11" fill="{INK2}" text-anchor="middle">{lab}</text>')
    out.append(f'<text x="{(L + W - R) / 2:.0f}" y="{H - 6}" font-size="12" fill="{INK2}" text-anchor="middle">median relative change of the layer-0 attention output record (WO) over the tokens where it differs (log scale)</text>')
    color = {"order": BLUE, "rounding": ORANGE, "rounding+order": ORANGE, "page-end": VIOLET}
    for i, (lab, v, nd, nt, mech) in enumerate(items):
        y = T + 10 + 30 * i
        out.append(f'<text x="{L - 10}" y="{y + 13}" font-size="12" fill="{INK}" text-anchor="end">{lab}</text>')
        out.append(f'<rect x="{L}" y="{y}" width="{xs(v) - L:.1f}" height="18" rx="0" fill="{color[mech]}"/>')
        out.append(f'<text x="{xs(v) + 6:.1f}" y="{y + 13}" font-size="11" fill="{INK2}">{fmt_e(v)} ({nd} of {nt} tokens differ)</text>')
    out.append("</svg>")
    return "\n".join(out)


def chart_margins(sp, flip_pairs_steps, title):
    """Strip: per-step margin (OFF arm, bf16 ulps) with flip steps highlighted; the pair movement p95 as a line."""
    W, H, L, R, T, B = 960, 240, 60, 20, 30, 40
    steps = sp["steps"]
    maxu = 80
    ys = lambda u: H - B - (min(u, maxu) / maxu) * (H - T - B)
    xs = lambda k: L + (k - 1) / 255 * (W - L - R)
    out = [svg_header(W, H), f'<rect width="{W}" height="{H}" fill="{SURF}"/>']
    for u in (0, 20, 40, 60, 80):
        out.append(f'<line x1="{L}" y1="{ys(u):.1f}" x2="{W - R}" y2="{ys(u):.1f}" stroke="{GRID}"/>')
        out.append(f'<text x="{L - 6}" y="{ys(u) + 4:.1f}" font-size="11" fill="{INK2}" text-anchor="end">{u}{"+" if u == maxu else ""}</text>')
    p95 = statistics.quantiles([abs(st["delta_pair"]) / st["ulp_top1_off"] for st in steps if st["ulp_top1_off"]], n=20)[18]
    out.append(f'<line x1="{L}" y1="{ys(p95):.1f}" x2="{W - R}" y2="{ys(p95):.1f}" stroke="{ORANGE}" stroke-width="2"/>')
    out.append(f'<text x="{W - R}" y="{ys(p95) - 6:.1f}" font-size="11" fill="{INK2}" text-anchor="end">p95 of the pair movement: {p95:.1f} ulps</text>')
    for st in steps:
        u = st["margin_off_ulps"]
        x, y = xs(st["step"]), ys(u)
        if not st["same_top1"]:
            out.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="6" fill="{RED}" stroke="{SURF}" stroke-width="2"/>')
            out.append(f'<text x="{x:.1f}" y="{y - 16:.1f}" font-size="11" fill="{INK}" text-anchor="middle">flip at step {st["step"]}: margin {u:g} ulp</text>')
        else:
            out.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="2.5" fill="{BLUE}"/>')
    out.append(f'<text x="{(L + W - R) / 2:.0f}" y="{H - 8}" font-size="12" fill="{INK2}" text-anchor="middle">generated step 1-256; y = gap between the two best candidates in the first arm, in bf16 ulps (capped at 80)</text>')
    out.append(f'<text x="{L}" y="{T - 12}" font-size="12" fill="{INK}">{html.escape(title)}</text>')
    out.append("</svg>")
    return "\n".join(out)


def chart_bias():
    """Dot plot of the mass-weighted bias and RMS error vs exact (replay M3, layer 0, 201 tokens) and ktest T7a."""
    rows = [  # label, bias, rms, source
        ("replay, real data: truncated (AVX path)", -7.8e-4, 2.00e-3, "replay results.md M3 'clean'"),
        ("replay, real data: AMX arms (base, new)", -6.3e-4, 1.91e-3, "replay results.md M3 'base'"),
        ("replay, real data: all rounded to nearest", -1.6e-5, 1.60e-3, "replay results.md M3 'clean_rne'"),
        ("kernel test, random pages: truncated (AVX)", -7.3e-4, 2.92e-3, "ktest T7a o_trunc"),
        ("kernel test, random pages: AMX kernel (RNE)", -5.8e-6, 1.62e-3, "ktest T7a o_rne"),
    ]
    W, L, R, T, B = 960, 330, 120, 40, 50
    H = T + 40 * len(rows) + 10 + B
    lo, hi = -1.0e-3, 3.2e-3
    xs = lambda v: L + (v - lo) / (hi - lo) * (W - L - R)
    out = [svg_header(W, H), f'<rect width="{W}" height="{H}" fill="{SURF}"/>']
    for v in (-1e-3, -5e-4, 0, 5e-4, 1e-3, 1.5e-3, 2e-3, 2.5e-3, 3e-3):
        x = xs(v)
        out.append(f'<line x1="{x:.1f}" y1="{T}" x2="{x:.1f}" y2="{H - B}" stroke="{GRID if v else INK2}"/>')
        out.append(f'<text x="{x:.1f}" y="{H - B + 16}" font-size="11" fill="{INK2}" text-anchor="middle">{v * 100:+.2f} %</text>')
    out.append(f'<text x="{(L + W - R) / 2:.0f}" y="{H - 6}" font-size="12" fill="{INK2}" text-anchor="middle">relative to the exact fp64 attention output: signed bias (dot) and RMS error (bar end)</text>')
    for i, (lab, bias, rms, src) in enumerate(rows):
        y = T + 22 + 40 * i
        out.append(f'<text x="{L - 10}" y="{y + 4}" font-size="12" fill="{INK}" text-anchor="end">{html.escape(lab)}</text>')
        out.append(f'<line x1="{xs(0):.1f}" y1="{y}" x2="{xs(rms):.1f}" y2="{y}" stroke="{GRID}" stroke-width="6"/>')
        out.append(f'<text x="{xs(rms) + 8:.1f}" y="{y + 4}" font-size="11" fill="{INK2}">RMS error {rms * 100:.2f} %</text>')
        out.append(f'<circle cx="{xs(bias):.1f}" cy="{y}" r="6" fill="{ORANGE if bias < -1e-4 else AQUA}" stroke="{SURF}" stroke-width="2"/>')
        out.append(f'<text x="{xs(bias):.1f}" y="{y - 11}" font-size="11" fill="{INK2}" text-anchor="middle">bias {bias * 100:+.3f} %</text>')
    out.append("</svg>")
    return "\n".join(out)


def chart_orders():
    """Schematic of the three fp32 add orders for one 128-dim score."""
    W, H = 960, 290
    out = [svg_header(W, H), f'<rect width="{W}" height="{H}" fill="{SURF}"/>']
    cols = [
        ("Row-major dotter (AVX-512)", BLUE, [
            "16 lanes; lane j holds dims 2j, 2j+1",
            "acc1[j]: dims 0-31, then 64-95",
            "acc2[j]: dims 32-63, then 96-127",
            "t[j] = acc1[j] + acc2[j]",
            "tree over the 16 lanes:",
            "  j+8, then j+4, then j+2, then 0+1",
            "lane step: (acc + odd) + even product"]),
        ("VNNI reader (AVX-512)", ORANGE, [
            "one lane per token",
            "one chain over the 64 dimension",
            "  pairs, in dimension order",
            "step: (acc + odd) + even product",
            "no tree",
            "",
            "scalar model bit-exact: 512,000 / 512,000"]),
        ("AMX tile (TDPBF16PS)", VIOLET, [
            "4 instructions of 16 pairs each",
            "per instruction:",
            "  E = chain of the 16 even products",
            "  O = chain of the 16 odd products",
            "  acc = acc + fl(E + O)",
            "found by experiment, not in the manual",
            "model bit-exact: 512,000 / 512,000"]),
    ]
    cw = (W - 40) / 3
    for i, (title, c, lines) in enumerate(cols):
        x = 20 + i * cw
        out.append(f'<rect x="{x}" y="16" width="{cw - 16}" height="{H - 32}" rx="6" fill="none" stroke="{c}" stroke-width="2"/>')
        out.append(f'<text x="{x + 12}" y="42" font-size="14" font-weight="600" fill="{INK}">{html.escape(title)}</text>')
        for k, ln in enumerate(lines):
            out.append(f'<text x="{x + 12}" y="{70 + 28 * k}" font-size="12" fill="{INK2}" xml:space="preserve">{html.escape(ln)}</text>')
    out.append("</svg>")
    return "\n".join(out)


def td2_section():
    v = read_text(f"{RES2}/verdict.txt")
    t = read_text(f"{RES2}/tokens.txt")
    if not v:
        return "<p><em>Pending: the prompt-8192 round (probe-td2.sh) has not finished.</em></p>"
    rows = []
    for off, on in (("base", "new"), ("new", "newoff"), ("base", "poc")):
        j = load_json(f"{RES2}/steps-{off}-vs-{on}.json")
        if not j:
            continue
        s = j["summary"]
        rows.append(f"<tr><td>{off} vs {on}</td><td>{s['n_identical_steps']} of {s['n_steps']}</td><td>{s['flip_steps'] or 'none'}</td>"
                    f"<td>{pct(s['nonflip_median_frac_changed'])}</td><td>{s['nonflip_median_mean_abs_delta']:.3f}</td><td>{s['median_margin_off']:.3f}</td><td>{s['max_tvd']:.3f}</td></tr>")
    return (f"<pre class='small'>{html.escape(t or '')}</pre><table><thead><tr><th>pair</th><th>steps with identical logits</th><th>top-token flips (step)</th>"
            f"<th>median share of logits changed</th><th>median mean |delta|</th><th>median margin (logit units)</th><th>max TVD</th></tr></thead><tbody>{''.join(rows)}</tbody></table>")


def td3_section():
    v = read_text(f"{RES3}/verdict.txt")
    if not v:
        return "<p><em>Pending: the path-counter round (probe-td3.sh) has not finished.</em></p>"
    return f"<pre class='small'>{html.escape(v)}</pre>"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=OUT_DEFAULT)
    a = ap.parse_args()
    layers = {(off, on): layer_stats(off, on) for off, on, _, _ in PAIRS}
    steps = {(off, on): step_stats(off, on) for off, on, _, _ in PAIRS}
    kt = ktest_lines()
    ties = load_json(TIES) or {}

    # ---------- tables ----------
    arm_rows = "".join(f"<tr><td><code>{n}</code></td><td>{b}</td><td>{d}</td><td>{r}</td></tr>" for n, b, d, r in ARMS)
    pair_rows = []
    for off, on, what, mech in PAIRS:
        st = layers[(off, on)]
        if st.get("pending"):
            res = "pending"
        elif st["n_over"] == 0:
            res = f"identical: 0 of {st['n']:,} records differ"
        else:
            f = st["first"]
            w = st["wo0"]
            res = (f"first difference at token {st['min_token']} ({html.escape(f['key'])}: {pct(f['frac_changed'])} of its values, relative change {fmt_e(f['rel_l2'])}); "
                   f"{st['n_over']:,} of {st['n']:,} records differ; layer-0 WO differs at {w['n_diff']} of {w['n_tokens']} tokens (first: {', '.join(map(str, w['first_tokens']))})")
        sp = steps[(off, on)]
        if sp:
            s = sp["summary"]
            lg = (f"{s['n_identical_steps']} of 256 steps identical; flips at {s['flip_steps'] or 'none'}; "
                  f"median {pct(s['nonflip_median_frac_changed'])} of logits changed per step")
        else:
            lg = "pending"
        pair_rows.append(f"<tr><td><code>{off}</code> vs <code>{on}</code></td><td>{html.escape(what)}</td><td>{res}</td><td>{lg}</td></tr>")

    # flip steps detail across pairs
    flip_rows = []
    for off, on, what, mech in PAIRS:
        sp = steps[(off, on)]
        if not sp:
            continue
        for st in sp["flips"]:
            flip_rows.append(f"<tr><td>{off} vs {on}</td><td>{st['step']}</td><td>{st['off_top1']} / {st['off_top2']}</td><td>{st['margin_off']:g} = {st['margin_off_ulps']:g} ulps</td>"
                             f"<td>{st['delta_pair']:+g} = {st['delta_pair'] / st['ulp_top1_off']:+g} ulps</td><td>{st['on_top1']}</td></tr>")

    # per-step saturation table
    sat_rows = []
    for off, on, what, mech in PAIRS:
        sp = steps[(off, on)]
        if not sp:
            continue
        s = sp["summary"]
        sat_rows.append(f"<tr><td>{off} vs {on}</td><td>{s['n_identical_steps']}</td><td>{pct(s['nonflip_median_frac_changed'])}</td><td>{s['nonflip_median_mean_abs_delta']:.3f}</td>"
                        f"<td>{s['nonflip_median_abs_delta_pair']:g} / {s['nonflip_p95_abs_delta_pair']:g}</td><td>{s['median_margin_off']:g}</td><td>{s['max_tvd']:.3f}</td><td>{s['flip_steps'] or 'none'}</td></tr>")

    kt_rows = "".join(f"<tr><td><code>{html.escape(k)}</code></td><td><code class='small'>{html.escape(' | '.join(v))}</code></td></tr>" for k, v in kt.items())

    # tie stats headline (first campaign, from the agent's json)
    td = ties.get("td20261016", {})
    tie_rows = []
    for off, on, what, mech in PAIRS:
        k = f"{off}-vs-{on}"
        pr = (td.get("prediction") or {}).get(k)
        pq = (td.get("pairs") or {}).get(k)
        if not pr or not pq:
            continue
        own = pr.get("own_ulps", {})
        mc = pq.get("margin_counts", {})
        tie_rows.append(f"<tr><td>{off} vs {on}</td><td class='num'>{len(pq.get('observed_flips', []))} ({', '.join(map(str, pq.get('observed_flips', []))) or '-'})</td>"
                        f"<td class='num'>{own.get('expected_flips', float('nan')):.2f}</td><td class='num'>{own.get('p_at_least_one', float('nan')):.2f}</td>"
                        f"<td class='num'>{mc.get('eq_0', 'n/a')}</td><td class='num'>{mc.get('le_2ulp', 'n/a')}</td></tr>")
    tot = td.get("totals", {})
    tie_tot = html.escape(json.dumps({k: v for k, v in tot.items() if not isinstance(v, (dict, list))}, indent=0)) if tot else "pending"

    base_new = layers[("base", "new")]
    base_poc = layers[("base", "poc")]
    new_newoff = layers[("new", "newoff")]
    newoff_trunc = layers[("newoff", "trunc")]
    bn_wo = base_new.get("wo0", {})
    nn_wo = new_newoff.get("wo0", {})
    nt_wo = newoff_trunc.get("wo0", {})

    css = f"""
    :root {{ color-scheme: light; --ink:{INK}; --ink2:{INK2}; --muted:{MUTED}; --grid:{GRID}; --surf:{SURF}; --blue:{BLUE}; --orange:{ORANGE}; --aqua:{AQUA}; --violet:{VIOLET}; }}
    html, body {{ background:#ffffff; color:var(--ink); font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; line-height:1.45; margin:0; }}
    main {{ max-width: 1040px; margin: 0 auto; padding: 24px 16px 64px; }}
    h1 {{ font-size: 1.6rem; margin: 0 0 4px; }} h2 {{ font-size: 1.25rem; margin: 36px 0 8px; border-bottom: 1px solid var(--grid); padding-bottom: 4px; }} h3 {{ font-size: 1.05rem; margin: 22px 0 6px; }}
    p, li {{ max-width: 80ch; }} .meta {{ color: var(--ink2); font-size: .9rem; }}
    table {{ border-collapse: collapse; width: 100%; font-size: .9rem; margin: 10px 0 16px; }} th, td {{ border-bottom: 1px solid var(--grid); padding: 6px 8px; text-align: left; vertical-align: top; }} th {{ color: var(--ink2); font-weight: 600; }}
    td.num, th.num {{ text-align: right; font-variant-numeric: tabular-nums; }}
    code {{ font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .88em; }} pre {{ background: #f4f4f1; padding: 10px; overflow-x: auto; font-size: .82rem; }}
    .small {{ font-size: .8rem; }} .short {{ background: #f4f6fa; border-left: 4px solid var(--blue); padding: 10px 14px; }}
    figure {{ margin: 14px 0 22px; }} figcaption {{ color: var(--ink2); font-size: .88rem; margin-top: 6px; max-width: 90ch; }}
    .verdict {{ background: #fdf3ee; border-left: 4px solid var(--orange); padding: 10px 14px; }}
    .ok {{ color: #1b7f5a; font-weight: 600; }} .miss {{ color: #b23b3b; font-weight: 600; }}
    """

    def first_desc(st):
        if st.get("pending"):
            return "pending"
        if st["n_over"] == 0:
            return "no differing record"
        f = st["first"]
        return f"token {st['min_token']}, {html.escape(f['key'].split(' of token')[0])}"

    page = f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Issue 4444 root cause</title><style>{css}</style></head><body><main>
<h1>Issue #4444: the root cause of the token divergence, measured</h1>
<p class="meta">Campaign td-20261016 on delphi-3bda, 2026-10-16. Written by Claude Code for jhan. Every number on this page comes from a file named in the section "Records"; the generator is <code>exec/td-20261016/report/gen_report.py</code>.</p>

<h2>Short version</h2>
<div class="short">
<p>The tokens diverge because the three attention engines (the row-major AVX-512 dotter, the VNNI-K AVX-512 reader and the AMX tile kernels) add the same bf16 products in three different fp32 orders, and because the AVX-512 PV path truncates the softmax weights to bf16 while the AMX path rounds them to nearest; a greedy run then picks a different token only at a step where the two best candidates are within one or two bf16 ulps of each other. Each cause was isolated with a proof-of-concept binary and measured record for record: a stack binary with the reader's add order removed matches main bit for bit over all 1,024 prompt tokens and 63 decode steps, and exactly over the whole run under the kill switch; the one remaining difference is a path choice at every 64th decode step, verified in the code. No kernel defect was found; the one pre-existing accuracy problem is the AVX-512 truncation of the weights, which biases every attention output low by about 0.08 % and raises its error against an exact reference by 1.25 to 1.8 times.</p>
</div>

<h2>Words used here</h2>
<table><thead><tr><th>term</th><th>meaning</th></tr></thead><tbody>
<tr><td>tron, runtron</td><td>tron is the inference program under test; runtron is its command-line tool. All runs here are runtron runs.</td></tr>
<tr><td>AMX, AVX-512</td><td>Two Intel CPU instruction sets. AMX multiplies 16-row tiles (instruction TDPBF16PS); AVX-512 works on 16-lane vectors (instruction VDPBF16PS). Both multiply bf16 pairs and add in fp32.</td></tr>
<tr><td>bf16, fp32, ulp</td><td>bf16 is the 16-bit float the activations and the KV cache use (8 significant bits, one notch = 0.39 % of the value). fp32 is the 32-bit float the sums are formed in (one notch = 1.2e-7 of the value). A ulp is one notch at the size of the value.</td></tr>
<tr><td>dotter, reader, AMX kernels</td><td>The three ways tron scores a query against stored keys: the row-major dotter (<code>dotter&lt;bf16,128&gt;</code>, one token at a time), the VNNI reader (<code>k_vnni::qk_group</code>, one token per vector lane, reads the VNNI K layout of PR 4956), and the AMX kernels (<code>qk_rowmajor_128x4</code> / <code>qk_vnni_128x4</code> for a whole 64-token page, <code>weights_times_v_128x4</code> for the PV product).</td></tr>
<tr><td>PV path, softmax weights P</td><td>After the scores, attention forms P = exp(score - max) and multiplies P with the stored values V. The AVX-512 PV path (<code>scaled_v_expr</code>) truncates P to bf16 (drops the low 16 bits); the AMX PV kernel rounds P to the nearest bf16.</td></tr>
<tr><td>page, block, dense page, page-end step</td><td>A page is 64 tokens of the KV cache; a block is a 16-token quarter of a page. A dense page is one the AMX kernels take whole: complete, fully visible to the query and, at the PR 4959 head, all four blocks in the VNNI layout. The page-end step is the decode step whose new token completes a page.</td></tr>
<tr><td>kill switch</td><td>The environment variable <code>TRON_AMX_DISABLE=1</code>: the same binary runs with the AMX kernels off.</td></tr>
<tr><td>the stack, main, clean binary</td><td>The stack is PR 4956 to 4959 (VNNI K layout + AMX), measured at the PR 4959 probe commit ea94e95a4e. main is 72308ec90c, the commit the stack is based on. The clean binary is main built with <code>TRON_AMX_DISPATCH=OFF</code>, the issue's "row-major binary".</td></tr>
<tr><td>forced run, record, seam</td><td>A forced run feeds every binary the same 256 generated tokens (teacher forcing), so all binaries score the same context at every step. A record is one logged intermediate vector ("WO layer 3 of token 517"): 416,443 per run. The seam is the first record where two binaries differ.</td></tr>
<tr><td>WO, Logits</td><td>WO is the output of the attention output projection, the first logged value downstream of attention (the attention output itself is not logged for this model). Logits are the per-word scores of one step; the top token is the greedy choice.</td></tr>
<tr><td>near tie, margin, flip</td><td>The margin is the gap between the two best candidates' logits at a step. A near tie is a margin within a few ulps. A flip is a step where two binaries choose different top tokens.</td></tr>
<tr><td>PoC</td><td>Proof-of-concept binary: a measurement-only code change that removes exactly one suspected cause, so the record-level comparison tests that cause alone.</td></tr>
</tbody></table>

<h2>1. What was asked and what was run</h2>
<p>Issue #4444 asks for the cause of the token differences between the AMX/VNNI binaries and the row-major binary, with a measurement, and for a decision on the kill-switch contract. The earlier forced runs (2026-10-11, 2026-10-13) had shown that every flip sits at a near tie, but not which operation makes the scores differ, nor by how much, nor whether any of it is a defect.</p>
<p>Method: one cell (qwen3-4b, tp2, 1 user, prompt 1,024 tokens, 256 generated tokens, CPU attention, greedy, <code>--pay-for-determinism</code>), eight binaries or settings ("arms") run as forced runs with the full per-layer record kept (20.6 GB per run), then compared record for record and step for step. Two proof-of-concept binaries remove one cause each. Predictions were written before the runs (<code>token-divergence-4444/predictions.md</code>) and are scored in section 8. Kernel-level facts come from a standalone program that drives the real kernels on the machine; an offline replay on the real logged Q, K, V values gives the accuracy against an exact reference.</p>
<table><thead><tr><th>arm</th><th>binary</th><th>what it is</th><th>role</th></tr></thead><tbody>{arm_rows}</tbody></table>

<h2>2. The result ladder: which pairs differ, where and how much</h2>
<figure>{chart_first_token(layers)}
<figcaption>Each row is one pair of arms run on the same forced tokens. The dot marks the first record that differs; the label names it and how much it changed. Pairs that isolate the add order first differ at prompt token 1 (one fp32 ulp in the scores, rarely visible in bf16). Pairs that include the weight rounding first differ at token 128, the first query that sees a dense page on AMX, and change a third of the output values. The pair base vs poc isolates the page-end path choice: identical for 1,087 tokens. Two pairs are bit-identical over the whole run.</figcaption></figure>
<table><thead><tr><th>pair</th><th>what the pair isolates</th><th>records (416,443 per run)</th><th>logits (256 steps)</th></tr></thead><tbody>{''.join(pair_rows)}</tbody></table>
<figure>{chart_seam(layers)}
<figcaption>Size of the difference where it starts: the layer-0 attention output record (WO) of each token. The add-order pairs (blue) change the record by about 1e-4 relative and only at a minority of tokens; the rounding pairs (orange) change it by about 2e-3 at every token from 128 on. The page-end pair (violet) changes it at three tokens only.</figcaption></figure>

<h2>3. Cause 1: three fp32 add orders</h2>
<figure>{chart_orders()}
<figcaption>How each engine sums the 128 products of one score. The products are identical (bf16 times bf16 is exact in fp32); only the grouping of the fp32 adds differs. The two AVX-512 orders were confirmed bit for bit against scalar models (512,000 scores each); the AMX order was found by experiment and confirmed bit for bit on both AMX kernels. Source: <code>exec/td-20261016/ktest/results.txt</code>, lines T0, T3, T4, T5m, T6d.</figcaption></figure>
<p>Kernel level (random data, 2,000 query groups x 64 tokens): the AMX kernel and the VNNI reader disagree on {html.escape(kt.get('T1', ['n/a'])[0].split('diff=')[1].split(' max_abs')[0] if kt.get('T1') else 'n/a')} of the scores, by at most 2 bf16 ulps; the dotter and the AMX kernel on 50.1 %; the two AMX QK kernels (row-major K and VNNI K) agree bit for bit. The AMX PV kernel and the AVX-512 PV loop differ in 72.8 % of outputs even when both see the same bf16 weights, so the PV path has an order difference of its own. [ktest T1, T1b, T2, T6a, T6c]</p>
<p>Model level: the stack binary (reader on partial pages) and main (dotter on partial pages) first differ at prompt token 1 ({first_desc(base_new)}), with a relative change of {fmt_e(base_new['first']['rel_l2']) if not base_new.get('pending') else 'n/a'}: one fp32 ulp in a score moves one bf16 output element now and then. The layer-0 WO record differs at {bn_wo.get('n_diff', 'n/a')} of {bn_wo.get('n_tokens', 'n/a')} tokens (first at token {bn_wo.get('first_tokens', ['n/a'])[0]}), with a median relative change of {fmt_e(bn_wo.get('median_rel'))}. The same seam appears in the kill-switch pair baseoff vs newoff, where the reader serves every page.</p>
<p><b>Proof by removal.</b> The PoC binary <code>poc</code> unpacks every VNNI token row and scores it with the row-major dotter, so the reader never runs. Under the kill switch, <code>pocoff</code> equals <code>baseoff</code> in all {layers[('baseoff', 'pocoff')].get('n', 0):,} records and all 256 logit vectors: the VNNI layout itself changes nothing, and the add order of the reader is the whole difference between the two kill-switch arms. With AMX on, <code>poc</code> equals <code>base</code> for every record of the 1,024 prompt tokens and of decode tokens 1,024 to 1,086, and first differs at token {base_poc.get('min_token', 'n/a')} (cause 3 below). Prediction P1 held for the add order; the residual is a separate, smaller cause.</p>
<p>The clean binary and main under the kill switch are bit-identical ({layers[('clean', 'baseoff')].get('n_over', 'pending')} differing records; 256 of 256 logit vectors identical), so the kill-switch contract of Note [AMX attention dispatch] holds exactly on row-major K. With VNNI K it does not: <code>newoff</code> differs from <code>baseoff</code> from prompt token 1 on, as the issue states.</p>

<h2>4. Cause 2: the rounding of the softmax weights</h2>
<p>The AVX-512 PV path truncates P to bf16 (<code>interleave_bf16_ps</code> keeps the high 16 bits of each fp32 weight); the AMX PV kernel rounds to nearest even (<code>_mm512_cvtne2ps_pbh</code>). Truncation always rounds toward zero, so the truncated weights sum to less than the exact ones while the divisor (the fp32 sum of the unrounded weights) does not shrink: the output is scaled down.</p>
<p>Model level: with AMX on, the first dense page is seen by prompt token 128 (the first query of the second prefill pass; a pass's own pages are never dense because the query mask holds one range per key of the pass). There <code>new</code> and <code>newoff</code> first differ ({first_desc(new_newoff)}): {pct(new_newoff['first']['frac_changed']) if not new_newoff.get('pending') else 'n/a'} of the record's values change, relative change {fmt_e(new_newoff['first']['rel_l2']) if not new_newoff.get('pending') else 'n/a'}. From there the layer-0 WO differs at {nn_wo.get('n_diff', 'n/a')} of {nn_wo.get('n_tokens', 'n/a')} tokens (every token from 128 on), median relative change {fmt_e(nn_wo.get('median_rel'))}: about ten to twenty times the add-order seam. main under its own kill switch shows the same picture (baseoff vs base: same first record, same size), so this is the PR 3879 difference, not a stack difference.</p>
<p><b>Separating rounding from order.</b> The PoC binary <code>trunc</code> truncates P inside the AMX kernel. <code>new</code> vs <code>trunc</code> (rounding only, same AMX order) reproduces the token-128 seam exactly ({first_desc(layers[('new', 'trunc')])}, {pct(layers[('new', 'trunc')]['first']['frac_changed']) if not layers[('new', 'trunc')].get('pending') else 'n/a'} of values). <code>newoff</code> vs <code>trunc</code> (order only: AMX order against AVX order, both truncated) first differs at {first_desc(newoff_trunc)} with a relative change of {fmt_e(newoff_trunc['first']['rel_l2']) if not newoff_trunc.get('pending') else 'n/a'}; layers 0 and 1 of token 128 are bit-identical in that pair. The layer-0 WO of the order-only pair differs at {nt_wo.get('n_diff', 'n/a')} tokens with a median relative change of {fmt_e(nt_wo.get('median_rel'))}. So at the seam the rounding mode is the dominant mechanism and the AMX-vs-AVX add order is a minor one.</p>
<figure>{chart_bias()}
<figcaption>Which path is closer to the truth. Offline replay of layer-0 attention on the real logged Q, K, V of 201 tokens (replay results.md, M3) and the kernel test on random 64-token pages (ktest T7a). The truncating AVX path is biased low by 0.08 % of the output on average (up to 0.18 % at single tokens) and its RMS error is 1.25 times (replay) to 1.8 times (kernel test) that of the rounding-to-nearest path, whose bias is zero within noise. The AMX arms sit in between because their partial pages still go through the truncating path.</figcaption></figure>
<p>The truncation removes 0.16 % of the softmax weight mass on average on real data (0.14 % on random pages; the theoretical mean for uniformly placed mantissas is 0.28 %, halved because the largest weight of every page is exactly 1 and survives truncation). [replay M3; ktest T7a]</p>

<h2>5. Cause 3: one page per 64 decode steps takes a different path (PR 4959 only)</h2>
<p>With the reader's order removed, <code>poc</code> and <code>base</code> still differ from decode token {base_poc.get('min_token', 'n/a')} on. At layer 0 their WO records differ only at tokens {', '.join(map(str, base_poc.get('wo0', {}).get('diff_tokens', [])[:6])) or 'n/a'}: the decode steps whose new token is the 64th of its page. Code reading (verified, citations in the records section): in that step main sees a complete, fully visible page and scores it on AMX (AMX order, rounded weights); the PR 4959 head stores the new row row-major into the page's last block and converts the block to VNNI only at the end of the forward pass, after attention ran, so the page fails the layout gate and goes through the software loop (reader + dotter, truncated weights) for that one step. From the next step on both score the page on AMX. PR 4957 and PR 4958 write every row into the VNNI column at once and behave like main here. With the kill switch no arm uses AMX, so the asymmetry is absent there. The direct measurement of the path counters at decode steps 63 and 64 is in section 7.</p>

<h2>6. From a one-ulp seam to a different token</h2>
<p>Whatever its size at the seam, every difference saturates within the forward pass: at the logits of every later step about 80 % of the 151,936 vocabulary scores differ by at least one bf16 ulp between any two non-identical arms, and the median mean |delta| over the vocabulary is the same 0.03 to 0.04 logit units for the add-order pairs and the rounding pairs alike. So the logits carry no information about which cause produced them; only the record-level seam does.</p>
<table><thead><tr><th>pair</th><th class="num">identical steps</th><th class="num">median share of logits changed</th><th class="num">median mean |delta|</th><th class="num">pair movement median / p95 (logit)</th><th class="num">median margin</th><th class="num">max TVD</th><th>flips at step</th></tr></thead><tbody>{''.join(sat_rows)}</tbody></table>
<p>A flip needs a near tie. The top token changed at three steps in the whole campaign: 20, 84 and 248. At each one the first arm's margin was 0 (an exact tie, resolved to the lower token id), 1 or 2 ulps, and the pair movement was 1 to 2 ulps; the median margin over the 256 steps is 3.9 logit units, about 39 ulps.</p>
<table><thead><tr><th>pair</th><th>step</th><th>top two ids (first arm)</th><th>margin</th><th>movement of the pair</th><th>top id in the second arm</th></tr></thead><tbody>{''.join(flip_rows) or '<tr><td colspan=6>pending</td></tr>'}</tbody></table>
<figure>{chart_margins(steps[('base', 'new')], None, 'base vs new: margin per step, flip highlighted') if steps[('base', 'new')] else ''}
<figcaption>Every generated step of the base-vs-new pair: the gap between the two best candidates in base (bf16 ulps). The orange line is the 95th percentile of how far the arm change moves that gap. Only a step below the line can flip; step 84 (an exact tie in base) did. The replay and tie statistics (section 7) predict 0.8 to 1.5 flips per 256 steps for pairs like these; 0 to 2 were observed per pair.</figcaption></figure>

<h2>7. Confirmations: counters, the prompt-8192 cell, near-tie prediction</h2>
<h3>7.1 Attention path counters at decode steps 63 and 64 (round 3)</h3>
{td3_section()}
<h3>7.2 The prompt-8192 cell, where every stack PR reported identical tokens (round 2)</h3>
{td2_section()}
<h3>7.3 Near-tie flip prediction</h3>
<p>The flip model "the top token changes when the margin plus the pair movement crosses zero" (ties to the lower token id) reproduces every observed flip of every pair. Its predictive form draws the movement independently of the margin from the pair's own measured movements (in ulps) and sums the flip probability over the 256 steps. On the earlier records (2026-10-13, 2026-08-30) it expected 0.76 to 1.54 flips per 256 steps per pair against 0 to 3 observed. On tonight's eight non-identical pairs it expects 12.4 flips in total against 9 observed (probability of 9 or fewer under the model: 0.18). Source: <code>exec/td-20261016/tiestats/tie_stats.md</code>, section 2.</p>
<table><thead><tr><th>pair</th><th class="num">observed flips (steps)</th><th class="num">expected flips</th><th class="num">P(at least one flip)</th><th class="num">exact ties among 256 steps</th><th class="num">steps with margin at most 2 ulps</th></tr></thead><tbody>{''.join(tie_rows) or '<tr><td colspan=6>pending</td></tr>'}</tbody></table>

<h2>8. Predictions written before the runs, and what happened</h2>
<table><thead><tr><th>prediction</th><th>outcome</th></tr></thead><tbody>
<tr><td>P1 poc == base in every record</td><td><span class="miss">Held for 1,087 tokens, then failed</span>: identical for all prompt tokens and decode tokens to 1,086; the residual is the page-end path choice (cause 3), found through this failure.</td></tr>
<tr><td>P2 pocoff == baseoff and baseoff == clean</td><td><span class="ok">Held</span>: 0 differing records in both pairs.</td></tr>
<tr><td>P3 base vs new first differs at prompt token 1, layer 0, about 1e-5 relative</td><td><span class="ok">Held on the token</span> (token 1), <span class="miss">missed on the layer and size</span>: the first bf16-visible record is WO at layer 16, 2.6e-4 relative; layer 0 first differs at token 26. One-ulp score differences rarely survive the bf16 output rounding.</td></tr>
<tr><td>P4 newoff vs new first differs at prompt token 128, layer 0</td><td><span class="ok">Held</span>.</td></tr>
<tr><td>P5 trunc == newoff if the AMX and AVX orders agree</td><td><span class="miss">Orders do not agree</span>: the kernel test found the AMX tile adds its 16 pairs as two chains (even and odd products) joined once per instruction, so the pair differs from token 128 (layer 2) on, by a tenth of the rounding seam.</td></tr>
<tr><td>P6 new vs trunc: rounding only, seam at token 128 layer 0, about 1e-3, systematic sign</td><td><span class="ok">Held</span>: 1.9e-3, 36 % of values; the truncating side is biased low by 0.08 % on real data.</td></tr>
<tr><td>P7 saturated logits for every non-identical pair; flips only at near ties (step 84 at 0-2 ulps, step 248 at 1 ulp)</td><td><span class="ok">Held</span>: 80 % of logits change per step in every non-identical pair; flips at steps 20, 84, 248 only, margins 0 to 2 ulps.</td></tr>
</tbody></table>

<h2>9. Verdict</h2>
<div class="verdict">
<p><b>Root cause.</b> The divergence has three mechanical causes, each isolated and measured: (1) three fp32 add orders (dotter, reader, AMX tile), which move a score by one fp32 ulp and a bf16 output element now and then; (2) the truncation of the softmax weights in the AVX-512 PV path against round-to-nearest in the AMX PV kernel, which moves a third of the attention output elements by one bf16 notch at every dense page and carries a systematic bias; (3) at the PR 4959 head only, the page-completing decode step scores one page in the software loop where main uses AMX. Any of them saturates to ulp-level noise on 80 % of the logits within one forward pass, and the greedy choice changes only at a near tie, which this prompt offers at roughly one step in a hundred.</p>
<p><b>Is it a real problem?</b> The add orders are not: all three are correct fp32 summations, the VNNI layout is numerically inert (pocoff equals baseoff bit for bit), and the same flips occur between any two orders. The page-end path choice is not a defect either, but it is a documented-nowhere asymmetry that costs the stack bit-identity with main even after the reader order is matched. The weight truncation is a real, pre-existing accuracy problem of the AVX-512 path (present in the clean binary, on AMD hosts and under the kill switch): a -0.08 % bias and a 1.25 to 1.8 times larger error than rounding to nearest, for no benefit. The kill-switch contract of Note [AMX attention dispatch] is broken exactly as the issue says: on VNNI K the switch gives an AMX-off run of the same binary, not the clean binary's numerics. The design note <code>token-divergence-issue4444-fix-design.html</code> proposes what to change.</p>
</div>

