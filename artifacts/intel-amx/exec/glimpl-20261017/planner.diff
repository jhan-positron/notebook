+// pending pages took up to twice the mean compute time per layer (Muse
+// Glimmer, delphi-3bda, 2026-10-16). The checks assume the default,
+// TRON_PLAN_WEIGHTED_DISABLE unset.
+TEST_CASE(
+    "attention plan weights pages by path and spreads pending pages", "[attention]") {
+  constexpr size_t head_size = 128;
+  constexpr size_t n_heads = 4;
+  constexpr size_t n_kv_heads = 2;
+  constexpr llm_configuration llm_config{.type = model_type::llama,
+      .dim = n_heads * head_size,
+      .hidden_dim = 1024,
+      .n_layers = 1,
+      .n_heads = n_heads,
+      .n_kv_heads = n_kv_heads,
+      .vocab_size = 128,
+      .head_size = head_size,
+      .attention_scale = 0x1.6a09e6p-4f,
+      .n_experts = 1,
+      .n_shared_experts = 1,
+      .n_routed_experts_chosen = 0,
+      .rope_scaling_strategy = rope_scaling::simple};
+  using model_t =
+      model<llm<llm_config, make_llm_executor<false, tensor, tensor, tensor>>>;
+  using page_t = model_t::page;
+  // Eight full pages. The queries are the tokens of the last page, so pages 0
+  // to 6 are whole for every query and page 7 is the causal diagonal: every
+  // query scores part of it. Pages 0 to 5 are ready (written in earlier
+  // forwards), pages 6 and 7 are pending (written in this forward).
+  constexpr size_t num_pages = 8;
+  constexpr size_t n_ready_pages = 6;
+  constexpr size_t n_q = page_t::page_size;
+  constexpr size_t num_kv_tokens = num_pages * page_t::page_size;
+  constexpr size_t first_q_token = num_kv_tokens - n_q;
+  auto model =
+      std::make_unique<model_t>(std::filesystem::path{}, json(json::value_t::object));
+  model_t::book book(num_pages, 1);
+  std::vector<page_t*> pages;
+  for (size_t i = 0; i < num_pages; ++i) {
+    pages.push_back(book.page_of(i * page_t::page_size));
+    pages.back()->set_lo(0, i * page_t::page_size);
+    for (size_t tok = 0; tok < page_t::page_size; ++tok)
+      book.increment_tokens_used();
+    pages.back()->set_offset_bound(page_t::page_size);
+  }
+  model_t::state state(*model, model_config{.max_layers = 1});
+  state.resize(n_q);
+  state.pages.items = std::span<page_t* const>(pages);
+  indexed_vector<token_job_id, token_id> jobs;
+  for (size_t i = 0; i < n_q; ++i)
+    jobs.push_back(token_id(first_q_token + i));
+  state.token_jobs = jobs;
+  std::vector<uint32_t> positions(num_kv_tokens);
+  for (size_t i = 0; i < num_kv_tokens; ++i)
+    positions[i] = i;
+  state.token_positions.items = std::span<const uint32_t>(positions);
+  // Causal visibility: query q sees the tokens at positions up to
+  // first_q_token + q. Each later position drops the lowest remaining query.
+  ranged_mask mask;
+  {
+    mask_t<ranged_mask_capacity> sw{};
+    for (size_t q = 0; q < n_q; ++q)
+      sw.insert(q);
+    mask.add_range(token_id(0), token_id(first_q_token + 1), sw, {});
+    for (size_t q = 0; q + 1 < n_q; ++q) {
+      sw.erase(q);
+      mask.add_range(
+          token_id(first_q_token + q + 1), token_id(first_q_token + q + 2), sw, {});
+    }
+  }
+  state.query_mask = &mask;
+
+  latch_arena latches;
+  with_latch_arena latch_guard(latches);
+  std::vector<token_job_id> items;
+  for (size_t i = 0; i < n_q; ++i)
+    items.emplace_back(i);
+  model_t::batch q_batch(state, std::move(items), latches, 0);
+  q_batch.plans.resize(state.attention_plan_profiles.size());
+  q_batch.reset_channels(0, 0);
+
+  std::array<std::vector<page_id>, 2> batch_pages;
+  for (size_t i = 0; i < num_pages; ++i)
+    batch_pages[i >= n_ready_pages].emplace_back(page_id(i));
+  std::array<std::vector<work_estimate_t>, 2> page_work;
+  std::array<std::vector<std::pair<uint32_t, uint32_t>>, 2> page_qrange;
+  const int full_causal = std::numeric_limits<int>::max();
+  auto estimate = [&](bool use_hw, bool amx_on) {
+    // estimate_work adds to the counts it finds: start from empty vectors, as
+    // the production caller does.
+    page_work = {};
+    page_qrange = {};
+    work_estimate_t total;
+    state.estimate_work(q_batch.items, batch_pages, page_work, page_qrange, total,
+        full_causal, n_heads, n_kv_heads, use_hw, amx_on);
+    return total;
+  };
+  // Every query visits every page for both KV heads. The last query sees all
+  // of the diagonal page, through 64 one-token ranges: the dotter scores the
+  // whole page, so that visit is AVX full, like the kernel's path stats.
+  constexpr int64_t visits = n_q * n_kv_heads;
+  constexpr int64_t diagonal_full_visits = n_kv_heads;
+  constexpr int64_t diagonal_partial_visits = visits - diagonal_full_visits;
+  const work_estimate_t& dense_page = page_work[1][0];    // page 6
+  const work_estimate_t& partial_page = page_work[1][1];  // page 7
+
+  // With the AMX path on, the whole pages are AMX dense and the diagonal page
+  // is AVX partial. The partial page scores fewer K tokens than the dense page
+  // but costs more time, and the plan must charge it that way.
+  work_estimate_t total = estimate(/*use_hw=*/false, /*amx_on=*/true);
+  for (int pending : {0, 1}) {
+    for (size_t p = 0; p < page_work[pending].size(); ++p) {
+      CAPTURE(pending, p);
+      CHECK(page_work[pending][p].scaled_vs == visits);
+      const bool diagonal = pending == 1 && p == 1;
+      CHECK(page_work[pending][p].amx_dense_visits == (diagonal ? 0 : visits));
+      CHECK(page_work[pending][p].avx_full_visits ==
+            (diagonal ? diagonal_full_visits : 0));
+      CHECK(page_work[pending][p].avx_partial_visits ==
+            (diagonal ? diagonal_partial_visits : 0));
+    }
+  }
+  CHECK(partial_page.k_dot_products < dense_page.k_dot_products);
+  CHECK(partial_page.work() > dense_page.work());
+  CHECK(dense_page.work() == amx_dense_visit_cost * visits);
+  const int64_t diagonal_cost = avx_partial_page_visit_cost * diagonal_partial_visits +
+                                avx_full_page_visit_cost * diagonal_full_visits;
+  CHECK(partial_page.work() == diagonal_cost);
+  constexpr int64_t n_whole_pages = num_pages - 1;
+  CHECK(total.work() == n_whole_pages * dense_page.work() + partial_page.work());
+
+  // With the AMX path off every whole page is an AVX full page: the costs
+  // are all equal, so only the two-pass placement acts on such a model.
+  estimate(/*use_hw=*/false, /*amx_on=*/false);
+  CHECK(dense_page.amx_dense_visits == 0);
+  CHECK(dense_page.avx_full_visits == visits);
+  CHECK(dense_page.work() == avx_full_page_visit_cost * visits);
+  CHECK(partial_page.work() == diagonal_cost);
+
+  // With hardware attention the pending pass never takes the AMX path: the
+  // pending whole page counts as AVX while the ready whole pages stay dense.
+  estimate(/*use_hw=*/true, /*amx_on=*/true);
+  CHECK(page_work[0][n_ready_pages - 1].amx_dense_visits == visits);
+  CHECK(dense_page.amx_dense_visits == 0);
+  CHECK(dense_page.avx_full_visits == visits);
+
+  // The plan: four workers of equal speed, two per KV head. The pending pages
+  // of a KV head must land on the same workers as its ready pages, one each,
+  // instead of both on the last worker of the head's block.
+  estimate(/*use_hw=*/false, /*amx_on=*/true);
+  constexpr size_t n_workers = 4;
+  constexpr size_t workers_per_kv_head = n_workers / n_kv_heads;
+  const std::vector<float> worker_cumsum{0.25f, 0.5f, 0.75f, 1.0f};
+  auto& plan = q_batch.plans[attention_plan_id(0)];
+  plan.ready_kv_plan.resize(n_workers);
+  plan.pending_kv_plan.resize(n_workers);
+  plan.n_sections.assign(n_kv_heads, 0);
+  state.finish_sw_plan(
+      &q_batch, plan, batch_pages, page_work, page_qrange, worker_cumsum, n_kv_heads);
+  for (size_t kv_head = 0; kv_head < n_kv_heads; ++kv_head) {
+    CAPTURE(kv_head);
+    std::vector<size_t> ready_workers, pending_workers;
+    for (size_t worker = 0; worker < n_workers; ++worker) {
+      for (const kv_section& s : plan.ready_kv_plan[worker])
+        if (s.kv_head == kv_head) ready_workers.push_back(worker);
+      for (const kv_section& s : plan.pending_kv_plan[worker])
+        if (s.kv_head == kv_head) pending_workers.push_back(worker);
+    }
+    std::vector<size_t> block;
+    for (size_t w = 0; w < workers_per_kv_head; ++w)
+      block.push_back(kv_head * workers_per_kv_head + w);
+    CHECK(ready_workers == block);
+    CHECK(pending_workers == block);
+    // One ready and one pending section per worker of the block; no query
+    // split (every worker already holds several page tasks).
+    CHECK(plan.n_sections[kv_head] == 2 * workers_per_kv_head);
+  }
+}
+
 // book::try_create — the fallible KV-book factory (memory_pressure_governor
