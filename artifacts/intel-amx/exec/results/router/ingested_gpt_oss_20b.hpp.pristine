  void visit_named_tensors(const auto& visit, tron_maybe_unused int max_layers = -1, tron_maybe_unused bool tie_word_embeddings = false) {
    if constexpr (wcls_is_compensated) {
      auto e = tron::compensated_tensor(wcls);
      visit(e, hardware::tensor_placement_request{"lm_head"});
    } else {
      visit(wcls, hardware::tensor_placement_request{"lm_head"});
    }
    {
      visit(model_embed_tokens_weight, hardware::tensor_placement_request{"model.embed_tokens"});
    }
    {
      visit(input_layernorm_weight, hardware::tensor_placement_request{"model.layers.0.input_layernorm"});
    }
    for (size_t e = 0; e < 32; e += 1) {
      visit(mlp_experts____down_proj[expert_id(e)], hardware::tensor_placement_request{fmt::format("model.layers.0.mlp.experts.{}.down_proj", e), expert_coordinate{moe_router_id{0}, expert_id(e)}});
    }
    for (size_t e = 0; e < 32; e += 1) {
      visit(mlp_experts____down_proj_bias[expert_id(e)], hardware::tensor_placement_request{fmt::format("model.layers.0.mlp.experts.{}.down_proj_bias", e)});
