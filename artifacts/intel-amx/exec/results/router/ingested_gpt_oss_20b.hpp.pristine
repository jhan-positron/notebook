      attn_elapsed += outer_state.template run_attention_job<tron::attention_geometry{64, tron::kv_geometry{8, 64}}, 19>(q_batch->outer_batch, rope, q_batch->rope_channel_1, sdpa, q_batch->sdpa_channel, worker_ix, n_attn_workers);
      outer_state.wait_attention_job(q_batch->outer_batch, worker_ix);
      outer_state.help_drain_gof(4);
      attn_elapsed += outer_state.template run_attention_job<tron::attention_geometry{64, tron::kv_geometry{8, 64}}, 20>(q_batch->outer_batch, rope, q_batch->rope_channel_1, sdpa, q_batch->sdpa_channel, worker_ix, n_attn_workers);
      outer_state.wait_attention_job(q_batch->outer_batch, worker_ix);
      outer_state.help_drain_gof(4);
      attn_elapsed += outer_state.template run_attention_job<tron::attention_geometry{64, tron::kv_geometry{8, 64}}, 21>(q_batch->outer_batch, rope, q_batch->rope_channel_1, sdpa, q_batch->sdpa_channel, worker_ix, n_attn_workers);
      outer_state.wait_attention_job(q_batch->outer_batch, worker_ix);
      outer_state.help_drain_gof(4);
      attn_elapsed += outer_state.template run_attention_job<tron::attention_geometry{64, tron::kv_geometry{8, 64}}, 22>(q_batch->outer_batch, rope, q_batch->rope_channel_1, sdpa, q_batch->sdpa_channel, worker_ix, n_attn_workers);
      outer_state.wait_attention_job(q_batch->outer_batch, worker_ix);
      outer_state.help_drain_gof(4);
      attn_elapsed += outer_state.template run_attention_job<tron::attention_geometry{64, tron::kv_geometry{8, 64}}, 23>(q_batch->outer_batch, rope, q_batch->rope_channel_1, sdpa, q_batch->sdpa_channel, worker_ix, n_attn_workers);
      if (worker_ix == 0) {
        outer_state.record_attention_time((attn_elapsed * n_attn_workers));
      }
    }
    size_t available_main_parallelism(tron_maybe_unused size_t n_tokens) const noexcept {
      return (n_tokens * 4);
    }
    void patch_logits(tron_maybe_unused auto& logits_in, tron_maybe_unused auto& logits_out) noexcept {
      logits_out.set(logits_in);
    }
    void patch_logits_in_place(tron_maybe_unused auto& logits) noexcept {

    }
    void kernel_index_rmsnorm(tron_maybe_unused plugin_batch* q_batch, tron_maybe_unused size_t worker_ix, tron_maybe_unused size_t n_workers) {
      {
        if (n_workers > 1 && worker_ix == 0) { return; }
        size_t n_actual_workers = (n_workers == 1) ? 1 : n_workers - 1;
        size_t actual_worker_ix = (n_workers == 1) ? 0 : worker_ix - 1;
        {
          TRACE_EVENT("model", "kernel_index_rmsnorm");
          for (size_t task = actual_worker_ix; task < q_batch->items.size(); task += n_actual_workers) {
            token_job_id ix = q_batch->items[task];
            embedding[ix] = model.model_embed_tokens_weight[outer_state.token_job_tokens[ix]];
            outer_state.log_intermediate(embedding[ix], 2880, ix, "Embedding");
            to_8[ix] = tron::rmsnorm(model.input_layernorm_weight, embedding[ix], 1.0e-5f);
            q_batch->to_8_channel.finish_writing_at(task);
          }
        }
      }
    }
    void kernel_add_rope(tron_maybe_unused plugin_batch* q_batch, tron_maybe_unused size_t worker_ix, tron_maybe_unused size_t n_workers) {
      {
        if (n_workers > 1 && worker_ix == 0) { return; }
        size_t n_actual_workers = (n_workers == 1) ? 1 : n_workers - 1;
        size_t actual_worker_ix = (n_workers == 1) ? 0 : worker_ix - 1;
        {
          TRACE_EVENT("model", "kernel_add_rope first wait");
          if (actual_worker_ix < q_batch->items.size()) {
            q_batch->linear_channel.start_reading_at(actual_worker_ix);
          }
        }
        {
          TRACE_EVENT("model", "kernel_add_rope");
          for (size_t task = actual_worker_ix; task < q_batch->items.size(); task += n_actual_workers) {
            q_batch->linear_channel.start_reading_at(task);
            token_job_id ix = q_batch->items[task];
            linear_1[ix] = (linear[ix] + model.self_attn_q_proj_bias);
            outer_state.log_intermediate(linear_1[ix], 4096, ix, "WQ layer {}", 0);
            rope[ix] = tron::rope(outer_state.token_job_positions[ix], linear_1[ix], model.rope_config);
            q_batch->rope_channel_1.finish_writing_at(task);
          }
        }
      }
    }
