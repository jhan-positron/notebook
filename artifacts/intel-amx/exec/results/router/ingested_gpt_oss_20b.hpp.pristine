    void make_latches(latch_arena&) noexcept { }
    void run(tron_maybe_unused auto& q_batches) {
      TRON_ASSERT(q_batches.size() == 1, "Ingested models require --max-minibatches 1; see Note [Ingested Model Mini-batching] in TronCpp.hs");
      plugin_batch* q_batch = &(q_batches[0]->plugin_batch);
      // Decide the worker split and launch helpers and attention workers.
      // See Note [Plugin-owned worker launch] in model.hpp.
      thread_pool& tp = app_pool();
      const size_t n_main_helpers = outer_state.recommend_n_main_helpers();
      TRON_ASSERT(n_main_helpers <= tp.num_workers(),
          "generated plugin requested {} main helpers from an {}-worker "
          "application pool", n_main_helpers, tp.num_workers());
      TRON_ASSERT(n_main_helpers < tp.num_workers(),
          "generated attention requires at least one application-pool "
          "worker ({} helpers, {} pool workers)", n_main_helpers,
          tp.num_workers());
      const size_t n_workers = 1 + n_main_helpers;
      const size_t n_attn_workers = tp.num_workers() - n_main_helpers;
      outer_state.template assemble_attention_plan<tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}, tron::attention_geometry{64, tron::kv_geometry{8, 64}}>(n_attn_workers);
      for (auto& q_batch_ptr : q_batches)
        q_batch_ptr->reset_channels(n_attn_workers, n_workers);
      latch_trigger workers_trigger(n_main_helpers + n_attn_workers, "workers done");
      latch_ref workers_done(&workers_trigger);
      for (size_t i = 0; i < n_main_helpers; ++i)
        tp.enqueue_to(i, [this, &q_batches, &workers_done, i, n_workers]() {
          run_main_help(q_batches, 1 + i, n_workers);
          workers_done.count_down();
        });
      for (size_t i = 0; i < n_attn_workers; ++i)
        tp.enqueue_to(n_main_helpers + i,
            [this, &q_batches, &workers_done, i, n_attn_workers]() {
              run_attention_worker(q_batches, i, n_attn_workers);
