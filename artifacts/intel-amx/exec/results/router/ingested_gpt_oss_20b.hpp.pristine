  ingested_gpt_oss_20b_impl(json config, tron_maybe_unused int max_layers = -1)
  : rope_config(150000.0f, yarn_rope_scaling_params{32.0f, 1.3465736f, 32.0f, 1.0f, 4096.0f, false})
  {
    TRON_ASSERT(max_layers == -1 || max_layers == static_cast<int>(n_layers), "Ingest-generated models do not support partial runtime layer truncation: requested {} of {} layers; ingest a model with the requested layer count instead", max_layers, n_layers);
    json_enforce(config, "/quantization_config/desc_act"_json_pointer, permuted, permuted);
