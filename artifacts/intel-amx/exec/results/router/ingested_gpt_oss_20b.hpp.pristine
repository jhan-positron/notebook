    void kernel_add_swiglu(tron_maybe_unused plugin_batch* q_batch, tron_maybe_unused size_t worker_ix, tron_maybe_unused size_t n_workers) {
      {
        if (n_workers > 1 && worker_ix == 0) { return; }
        size_t n_actual_workers = (n_workers == 1) ? 1 : n_workers - 1;
        size_t actual_worker_ix = (n_workers == 1) ? 0 : worker_ix - 1;
        {
          TRACE_EVENT("model", "kernel_add_swiglu");
          for (size_t expert_ix = 0; expert_ix < routing->per_expert.size(); expert_ix += 1) {
            auto& entries = routing->per_expert[expert_id(expert_ix)];
            for (size_t j = actual_worker_ix; j < entries.size(); j += n_actual_workers) {
              auto [token, slot] = routing->expert_row(expert_id(expert_ix), expert_row_id(j));
              token_slot_id<4> ix(token, slot);
              q_batch->linear_channel_6.start_reading_at(ix);
              add[ix] = (linear_10[ix] + index_select_ev_1[ix]);
              if constexpr (!is_host) {
                tron::wide_swiglu(add[ix], swiglu[ix], 1.702f, 7.0f);
              } else {
                tron::host_swiglu(add[ix], swiglu[ix], 1.702f, 7.0f);
              }
              q_batch->swiglu_channel.finish_writing_at(ix);
            }
          }
        }
      }
    }
