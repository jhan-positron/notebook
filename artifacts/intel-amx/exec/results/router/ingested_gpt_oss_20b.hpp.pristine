  std::span<const float> attention_sink(tron::attention_sink_id id) const noexcept {
    if (id.i == 0) {
      return std::span<const float>{self_attn_sinks.data};
    }
    if (id.i == 1) {
      return std::span<const float>{self_attn_sinks_11.data};
    }
    if (id.i == 2) {
      return std::span<const float>{self_attn_sinks_16.data};
    }
    if (id.i == 3) {
      return std::span<const float>{self_attn_sinks_17.data};
    }
    if (id.i == 4) {
      return std::span<const float>{self_attn_sinks_18.data};
    }
    if (id.i == 5) {
      return std::span<const float>{self_attn_sinks_19.data};
    }
    if (id.i == 6) {
      return std::span<const float>{self_attn_sinks_20.data};
    }
    if (id.i == 7) {
      return std::span<const float>{self_attn_sinks_21.data};
    }
    if (id.i == 8) {
      return std::span<const float>{self_attn_sinks_22.data};
    }
    if (id.i == 9) {
      return std::span<const float>{self_attn_sinks_23.data};
    }
    if (id.i == 10) {
      return std::span<const float>{self_attn_sinks_1.data};
    }
    if (id.i == 11) {
      return std::span<const float>{self_attn_sinks_2.data};
    }
    if (id.i == 12) {
      return std::span<const float>{self_attn_sinks_3.data};
    }
    if (id.i == 13) {
      return std::span<const float>{self_attn_sinks_4.data};
    }
    if (id.i == 14) {
      return std::span<const float>{self_attn_sinks_5.data};
    }
    if (id.i == 15) {
      return std::span<const float>{self_attn_sinks_6.data};
    }
    if (id.i == 16) {
      return std::span<const float>{self_attn_sinks_7.data};
    }
    if (id.i == 17) {
