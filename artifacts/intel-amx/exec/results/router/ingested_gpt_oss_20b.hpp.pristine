        if (n_workers > 1 && worker_ix == 0) { return; }
        size_t n_actual_workers = (n_workers == 1) ? 1 : n_workers - 1;
        size_t actual_worker_ix = (n_workers == 1) ? 0 : worker_ix - 1;
        {
          TRACE_EVENT("model", "moe_blend");
          for (size_t task = actual_worker_ix; task < q_batch->items.size(); task += n_actual_workers) {
            token_job_id tok = q_batch->items[task];
            for (size_t slot = 0; slot < 4; slot += 1) {
              q_batch->add_channel.start_reading_at(token_slot_id<4>(tok, slot_id(slot)));
            }
            linear_7[tok] = blend_expr<2880, 4, btensor_t<2880>>(tok, topk_fst[tok], add_1);
          }
        }
      }
    }
  };
