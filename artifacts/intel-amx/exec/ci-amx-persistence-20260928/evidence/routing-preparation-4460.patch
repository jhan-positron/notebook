+-- | Assigns each routing-typed intermediate to the canonical Loopy
+-- name of the slot it shares. The canonical owner is the first user
+-- (by 'lbFirstWrite'); later users are assigned to that owner's
+-- planned routing field.
+newtype RoutingAssignment = RoutingAssignment (Map (Name Loopy) (Name Loopy))
+
+-- | Resolve a routing intermediate to the canonical owner of its
+-- shared slot. Total: canonical owners map to themselves, and names
+-- absent from the assignment (non-routing names, or dead routings,
+-- which are filtered out and declare their own 'MoeRoutingInfo') map
+-- to themselves. The owner is the field key when lowering materialises the plan.
+canonicalRouting :: RoutingAssignment -> Name Loopy -> Name Loopy
+canonicalRouting (RoutingAssignment m) name = M.findWithDefault name name m
