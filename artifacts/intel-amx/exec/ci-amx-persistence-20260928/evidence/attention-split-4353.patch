+                           static_cast<int64_t>(c.span) -
+                       total * static_cast<int64_t>(begin) /
+                           static_cast<int64_t>(c.span);
+              };
+              const work_estimate_t piece_work{
+                  share(work.k_dot_products), share(work.scaled_vs), work.kv_heads};
+              const int64_t cost = fixed_cost + piece_work.work();
