diff --git a/testlib/prompt.py b/testlib/prompt.py
index 3da2039..54c2338 100644
--- a/testlib/prompt.py
+++ b/testlib/prompt.py
@@ -29,6 +29,16 @@ class PromptGenerator:
         self.tokenizer = tokenizer
         self.convos = convos
 
+    def _token_count(self, convo: list[dict]) -> int:
+        # The same per-part count prune_convo uses (role header + text, the
+        # leading BOS token dropped).
+        n = 0
+        for part in convo:
+            role = ROLES[part['from']]
+            prefix = f"<|start_header_id|>{role}<|end_header_id|>\n"
+            n += len(self.tokenizer.encode(prefix + part["value"])[1:])
+        return n
+
     def prune_convo(self, convo: list[dict], prompt_length: int):
         encoded_len = 0
         pruned: list[dict] = []
@@ -68,7 +78,19 @@ class PromptGenerator:
             'value': f'[TIME: {fake_time}] You are a helpful assistant.'
         }
 
-        convo: list[dict] = self.convos[seed % len(self.convos)]['conversations']
-        convo.insert(0, system_prompt)
+        # Copy the stored list: the previous code inserted the system line into
+        # the stored conversation in place, so a second generate() call for the
+        # same seed in one process would see two system lines.
+        base: list[dict] = list(self.convos[seed % len(self.convos)]['conversations'])
+        # Concatenate the following conversations until the prompt is long
+        # enough. The shortest conversation is about 1500 tokens, so at
+        # prompt_length 1024 this loop never runs and the prompt is unchanged;
+        # above 2048 most single conversations are too short for prune_convo
+        # (jhan, l8b-levers campaign 2026-09-19).
+        k = 1
+        while self._token_count([system_prompt] + base) < prompt_length:
+            base = base + list(self.convos[(seed + k) % len(self.convos)]['conversations'])
+            k += 1
+        convo: list[dict] = [system_prompt] + base
         prompt = self.prune_convo(convo, prompt_length)
         return prompt
