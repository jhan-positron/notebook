import json
from transformers import AutoTokenizer, PreTrainedTokenizer
from pathlib import Path


local_dir = Path(__file__).parent


ROLES = {
    "system": "system",
    "user": "user",
    "human": "user",
    "gpt": "assistant",
    "bing": "assistant",
    "chatgpt": "assistant",
    "bard": "assistant",
}


class PromptGenerator:
    @classmethod
    def for_model(cls, model: str):
        with open(local_dir / 'sharegpt_1000.json') as f:
            convos = json.loads(f.read())
        tokenizer = AutoTokenizer.from_pretrained(model)
        return cls(convos, tokenizer)

    def __init__(self, convos: list, tokenizer: PreTrainedTokenizer):
        self.tokenizer = tokenizer
        self.convos = convos

    def prune_convo(self, convo: list[dict], prompt_length: int):
        encoded_len = 0
        pruned: list[dict] = []
        for part in convo:
            role = ROLES[part['from']]
            prefix = f"<|start_header_id|>{role}<|end_header_id|>\n"
            suffix = part["value"]
            encoded = self.tokenizer.encode(prefix + suffix)[1:]
            done = False
            if (encoded_len + len(encoded)) >= prompt_length:
                done = True
                encoded = encoded[:(prompt_length - encoded_len)]
            pruned.append({
                'role': role,
                'content': self.tokenizer.decode(encoded)[len(prefix):],
            })
            encoded_len += len(encoded)
            if done:
                break
        if encoded_len < prompt_length:
            raise ValueError(f'Prompt length {encoded_len} too short for configured length ({prompt_length})')
        return pruned

    def generate(
        self,
        prompt_length: int,
        seed: int,
    ) -> str:
        # Fake timestamp used to make prompts unique.
        ix = str(seed)
        ps = ix.rjust(max(6, int((len(ix) + 1) / 2 * 2)), '0')
        fake_time = f'{ps[0:2]}:{ps[2:4]}:{ps[4:6]}'
        fake_time = ':'.join([ps[i:i+2] for i in range(0, len(ps), 2)])

        system_prompt = {
            'from': 'system',
            'value': f'[TIME: {fake_time}] You are a helpful assistant.'
        }

        convo: list[dict] = self.convos[seed % len(self.convos)]['conversations']
        convo.insert(0, system_prompt)
        prompt = self.prune_convo(convo, prompt_length)
        return prompt
