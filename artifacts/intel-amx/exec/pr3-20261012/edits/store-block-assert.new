// 4 KiB is written. The write pattern differs. The block index is checked
// here, as store_row checks its token index. A block index at or above
// Rows / 16 would write into other panels and past the end of the plane.
template <size_t Rows, size_t Cols>
TRON(inline)
void store_block(k_vnni_view<bf16, Rows, Cols> dst,
    size_t c,
    __mmask16 present,
    const bf16* const rows[k_vnni::BLOCK_TOKENS_16]) noexcept {
  TRON_ASSERT_LT(c, Rows / k_vnni::BLOCK_TOKENS_16);
  bf16* const plane = detail::k_vnni_access::plane(dst);
