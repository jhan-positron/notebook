+# K (the attention keys) stored in the VNNI (Vector Neural Network Instructions)
+# pair-interleaved layout (option TRON_K_VNNI, top-level CMakeLists.txt, default
+# OFF). Note [K VNNI storage] in h/tron/models/kv_cache.hpp describes the layout.
+# The option is a layout change of the KV page (a fixed-size block of the
+# key/value cache). Every translation unit that touches a KV page must agree on
+# that layout. The definition is therefore PUBLIC.
+# The AMX (Intel Advanced Matrix Extensions) QK kernel (QK, the query-key
+# product) that reads the layout is in the dispatch translation unit above. The
+# option therefore requires TRON_AMX_DISPATCH.
+if(TRON_K_VNNI)
+  if(NOT TRON_AMX_DISPATCH)
+    message(FATAL_ERROR "TRON_K_VNNI requires TRON_AMX_DISPATCH=ON")
+  endif()
+  target_compile_definitions(tron PUBLIC TRON_K_VNNI)
+endif()
+
 add_dependencies(tron generate_model_defs)
 add_dependencies(tron generate_plugins_header)
 
@@ -330,6 +346,13 @@ if(TRON_AMX_DISPATCH)
   target_compile_definitions(tron_model_compile_config INTERFACE
     TRON_AMX_DISPATCH)
 endif()
+if(TRON_K_VNNI)
+  # The generated model objects compile kv_cache.hpp and model.hpp too. They
+  # must see the same K layout as the tron library (the TRON_K_VNNI block on
+  # the tron target above).
+  target_compile_definitions(tron_model_compile_config INTERFACE
+    TRON_K_VNNI)
+endif()
 if(TRON_PAGE_SHARE_COUNTERS)
