diff --git a/h/tron/tensor/k_vnni.hpp b/h/tron/tensor/k_vnni.hpp
new file mode 100644
index 00000000000..68867a1327f
--- /dev/null
+++ b/h/tron/tensor/k_vnni.hpp
@@ -0,0 +1,435 @@
+#pragma once
+// This file defines typed access to the K plane stored in the VNNI layout
+// (TRON_K_VNNI): an owner that holds the bytes (k_vnni_tensor), a matrix view
+// that knows the address formula (k_vnni_view), the index map and its
+// constants (namespace k_vnni), and the vector operations that move whole token
+// rows in and out (store_row, load_row, store_block, copy_token). The AVX-512
+// score reader of this layout is in h/tron/kernels/k_vnni.hpp. Who writes and
+// reads the layout is described in Note [K VNNI storage] (kv_cache.hpp).
+//
+// Words used here: AMX (Advanced Matrix Extensions) is the tile instruction
+// set of the CPU. AVX-512 (Advanced Vector Extensions) is the CPU's 512-bit
+// vector instruction set. bf16 is the 16-bit brain floating-point format. VNNI
+// (Vector Neural Network Instructions) layout means that the two values of a
+// dimension pair of one token are stored next to each other. One 64-byte row
+// holds that dimension pair for 16 consecutive tokens. The VNNI layout is the
+// B-operand layout of the AMX tile multiply (TDPBF16PS). It is also the operand
+// layout of the AVX-512 pair dot product (VDPBF16PS). A KV page holds 64
+// tokens. The layout exists for 128-dimension heads only. A plane is K for one
+// KV head of one page.
+//
+// Plane layout (64 tokens x 128 dimensions of bf16 = 16 KiB, the same bytes as the
+// row-major plane), indexed by dimension step s (32 dimensions), token block c (16
+// tokens), dimension pair dp and token t:
+//   plane[(((s * 4 + c) * 16 + dp) * 16 + t) * 2 + j] == K[c * 16 + t][s * 32 + 2 * dp
+//   + j]
+// One (s, c) is one 1 KiB panel: 16 dimension-pair rows of 64 bytes. A panel is
+// exactly one AMX B tile. Token i owns column (i % 16) of token block (i / 16)
+// in every panel. So tokens are written independently (no read-modify-write
+// between tokens, unlike the pair-interleaved V plane).
+//
+// Who may compute a packed address: the typed operations in this header, and
+// the two layout-specific score kernels (k_vnni::qk_group and
+// amx_attn_h128g4::qk_vnni_128x4), which reach the plane through
+// detail::k_vnni_access. Cache code, the model, hardware staging and the tests
+// use the typed operations or the page accessors built on them (page::set_k_row,
+// page::get_k_row, page::set_k_block, page::k_packed). book::fill_random is the
+// one documented exception: it fills a whole kv_block without interpreting
+// coordinates.
+
+#include <concepts>
+#include <cstddef>
+#include <cstdint>
+#include <immintrin.h>
+#include <type_traits>
+
+#include "common/assert.hpp"
+#include "common/attributes.hpp"
+#include "common/numerics/bf16.hpp"
+#include "tron/simd/auto.hpp"  // defines TRON_CHUNK_SIZE for the 16-lane guard below
+#include "tron/tensor/kv_cache_fwd.hpp"
+#include "tron/tensor/seq.hpp"
+#include "tron/tensor/view.hpp"
+
+namespace tron {
+
+namespace k_vnni {
+
+inline constexpr size_t PAGE_TOKENS_64 = 64;
+inline constexpr size_t HEAD_SIZE_128 = 128;
+// The two values of one dimension pair share one 32-bit lane.
+inline constexpr size_t PAIR_2 = 2;
+inline constexpr size_t DWORD_BYTES_4 = 4;
+// One 64-byte line holds one dimension pair of 16 consecutive tokens.
+inline constexpr size_t LINE_BYTES_64 = 64;
+inline constexpr size_t BLOCK_TOKENS_16 = LINE_BYTES_64 / (PAIR_2 * sizeof(bf16));
+inline constexpr size_t TOKEN_BLOCKS_4 = PAGE_TOKENS_64 / BLOCK_TOKENS_16;
+// One dimension step = 32 dimensions = 16 dimension pairs: the depth of one AMX
+// tile multiply.
+inline constexpr size_t STEP_DIMS_32 = 32;
+inline constexpr size_t STEP_PAIRS_16 = STEP_DIMS_32 / PAIR_2;
+inline constexpr size_t DIM_STEPS_4 = HEAD_SIZE_128 / STEP_DIMS_32;
+// One pair row = one 64-byte line = 32 bf16 = 16 dwords.
+inline constexpr size_t ROW_ELEMS_32 = LINE_BYTES_64 / sizeof(bf16);
+inline constexpr size_t ROW_DWORDS_16 = LINE_BYTES_64 / DWORD_BYTES_4;
+// One panel = 16 dimension-pair rows x 16 tokens x 2 paired values (1 KiB).
+inline constexpr size_t PANEL_ELEMS_512 = STEP_PAIRS_16 * BLOCK_TOKENS_16 * PAIR_2;
+inline constexpr size_t PANEL_BYTES_1024 = PANEL_ELEMS_512 * sizeof(bf16);
+inline constexpr size_t PANEL_DWORDS_256 = PANEL_BYTES_1024 / DWORD_BYTES_4;
+inline constexpr size_t N_PANELS_16 = DIM_STEPS_4 * TOKEN_BLOCKS_4;
+// The 16 lanes of one token block, all present.
+inline constexpr __mmask16 FULL_BLOCK_0XFFFF = 0xffffu;
+// 32-bit lanes of one 512-bit register (the transpose below is LANES x LANES).
+inline constexpr size_t LANES_16 = LINE_BYTES_64 / DWORD_BYTES_4;
+// Width of a bf16: a bf16 shifted up by this many bits is the exact fp32.
+inline constexpr int BF16_BITS_16 = 16;
+// The high half of a dword: the odd value of a dimension pair as an fp32 bit pattern.
+inline constexpr uint32_t HIGH_HALF_0XFFFF0000 = 0xffff0000u;
+static_assert(BLOCK_TOKENS_16 == 16 && TOKEN_BLOCKS_4 == 4 && STEP_PAIRS_16 == 16 &&
+                  DIM_STEPS_4 == 4 && ROW_ELEMS_32 == 32 && ROW_DWORDS_16 == 16 &&
+                  PANEL_ELEMS_512 == 512 && PANEL_BYTES_1024 == 1024 &&
+                  PANEL_DWORDS_256 == 256 && N_PANELS_16 == 16 && LANES_16 == 16,
+    "every constant's name states its value");
+static_assert(N_PANELS_16 * PANEL_ELEMS_512 == PAGE_TOKENS_64 * HEAD_SIZE_128,
+    "the VNNI plane is a permutation of the row-major plane: same element count");
+static_assert(BLOCK_TOKENS_16 == LANES_16 && STEP_PAIRS_16 == LANES_16,
+    "the block save transposes 16 token rows onto the 16 pair rows of a panel");
+
+// The layout gate. TRON_K_VNNI (CMake option) switches the K plane of every
+// 128-dimension head to the VNNI layout. Every other head size keeps the row-major
+// plane. The gate is a property of the storage geometry, not of the query
+// type or of the AMX availability. So every reader and writer of a slot sees
+// the same layout.
+#ifdef TRON_K_VNNI
+template <size_t head_size>
+inline constexpr bool layout_on = head_size == HEAD_SIZE_128;
+#else
+template <size_t head_size>
+inline constexpr bool layout_on = false;
+#endif
+
+// Element index of K[token][dim] inside the plane (the formula of the header
+// comment).
+constexpr size_t index(size_t token, size_t dim) noexcept {
+  const size_t s = dim / STEP_DIMS_32, c = token / BLOCK_TOKENS_16,
+               dp = (dim % STEP_DIMS_32) / PAIR_2, t = token % BLOCK_TOKENS_16,
+               j = dim % PAIR_2;
+  return (((s * TOKEN_BLOCKS_4 + c) * STEP_PAIRS_16 + dp) * BLOCK_TOKENS_16 + t) *
+             PAIR_2 +
+         j;
+}
+
+}  // namespace k_vnni
+
+namespace detail {
+// The one route from a packed K view to its plane address, for the typed
+// operations below, the two layout-specific score kernels (k_vnni::qk_group,
+// amx_attn_h128g4::qk_vnni_128x4) and the test-only book::fill_random, the
+// documented exception (Note [K VNNI storage] in kv_cache.hpp).
+struct k_vnni_access;
+}  // namespace detail
+
+// Byte alignment of one packed K plane: every pair row is one 64-byte line, and
+// the AMX QK kernel reads the plane in 64-byte tile rows.
+inline constexpr size_t K_PLANE_ALIGNMENT_64 = 64;
+// One plane: 64 tokens x 128 dimensions of bf16.
+inline constexpr size_t K_PLANE_BYTES_16384 =
+    k_vnni::PAGE_TOKENS_64 * k_vnni::HEAD_SIZE_128 * sizeof(bf16);
+static_assert(K_PLANE_BYTES_16384 == 16384, "the constant's name states its value");
+
+template <typename T>
+concept k_vnni_element = std::same_as<T, bf16> || std::same_as<T, const bf16>;
+
+// A packed K plane of [Rows tokens * Cols dimensions]. One element is reached
+// through at(token, dim). Whole token rows move through the operations below
+// (store_row, load_row, store_block, copy_token). Views come only from an owner
+// (k_vnni_tensor::as_view). A writable view (bf16) converts to a read-only one
+// (const bf16), never the reverse. There is no public pointer constructor, no
+// data() accessor, no operator[] and no pointer conversion: a bare pointer does
+// not say which layout it points at.
+template <typename T, size_t Rows, size_t Cols>
+struct k_vnni_view final {
+  static_assert(k_vnni_element<T>, "a packed K plane holds bf16 or const bf16");
+  // The index map (k_vnni::index) is written for 4 token blocks and 4 dimension
+  // steps. So the packed K layout exists for one shape.
+  static_assert(Rows == k_vnni::PAGE_TOKENS_64 && Cols == k_vnni::HEAD_SIZE_128,
+      "the K VNNI layout exists for 64-token pages of 128-dimension heads only");
+
+  // Writable-to-read-only conversion. Rebinding a view copies it; the owner
+  // must outlive every view.
+  template <typename U>
+    requires(std::is_const_v<T> && std::same_as<U, std::remove_const_t<T>>)
+  TRON(inline)
+  k_vnni_view(k_vnni_view<U, Rows, Cols> other) noexcept
+  : data_(other.data_) {}
+
+  // Bounds-checked element (token, dim). Writing through it does not mark the
+  // token complete (page::mark_k_complete does that).
+  TRON(nodiscard, inline, pure)
+  T& at(size_t token, size_t dim) noexcept {
+    TRON_ASSERT_LT(token, Rows);
+    TRON_ASSERT_LT(dim, Cols);
+    return data_[k_vnni::index(token, dim)];
+  }
+
+  TRON(nodiscard, inline, pure)
+  const bf16& at(size_t token, size_t dim) const noexcept {
+    TRON_ASSERT_LT(token, Rows);
+    TRON_ASSERT_LT(dim, Cols);
+    return data_[k_vnni::index(token, dim)];
+  }
+
+private:
+  friend struct k_vnni_tensor<Rows, Cols>;
+  friend struct detail::k_vnni_access;
+  template <typename U, size_t R, size_t C>
+  friend struct k_vnni_view;
+
+  TRON(inline)
+  explicit k_vnni_view(T* data) noexcept
+  : data_(data) {}
+
+  T* data_;
+};
+
+// Owns one packed K plane: exactly one 64-byte-aligned bf16 array, no separate
+// allocation and no initialization (the cache's DMA allocation creates the
+// kv_blocks that hold it; see Note [KV block lifetime] in kv_cache.hpp).
+// Trivial to construct, copy and destroy; copying an owner copies the plane
+// (page::copy_storage_slot copies a whole page as `dst_block.k = src_block.k`).
+// as_view() on a temporary is deleted: a view must not outlive its owner.
+template <size_t Rows, size_t Cols>
+struct alignas(K_PLANE_ALIGNMENT_64) k_vnni_tensor final {
+  static_assert(Rows == k_vnni::PAGE_TOKENS_64 && Cols == k_vnni::HEAD_SIZE_128,
+      "the K VNNI layout exists for 64-token pages of 128-dimension heads only");
+
+  TRON(nodiscard, inline)
+  k_vnni_view<bf16, Rows, Cols> as_view() & noexcept TRON(this_lifetimebound)
+  {
+    return k_vnni_view<bf16, Rows, Cols>(data_);
+  }
+
+  TRON(nodiscard, inline)
+  k_vnni_view<const bf16, Rows, Cols> as_view() const& noexcept TRON(this_lifetimebound)
+  {
+    return k_vnni_view<const bf16, Rows, Cols>(data_);
+  }
+
+  k_vnni_view<bf16, Rows, Cols> as_view() && = delete;
+  k_vnni_view<const bf16, Rows, Cols> as_view() const&& = delete;
+
+private:
+  alignas(K_PLANE_ALIGNMENT_64) bf16 data_[Rows * Cols];
+};
+static_assert(
+    sizeof(k_vnni_tensor<k_vnni::PAGE_TOKENS_64, k_vnni::HEAD_SIZE_128>) ==
+            K_PLANE_BYTES_16384 &&
+        alignof(k_vnni_tensor<k_vnni::PAGE_TOKENS_64, k_vnni::HEAD_SIZE_128>) ==
+            K_PLANE_ALIGNMENT_64,
+    "the owner is the plane: the same bytes as the row-major K plane, 64-byte aligned");
+
+namespace detail {
+struct k_vnni_access final {
+  // The plane's first element: panel (step 0, block 0), pair row 0, token 0.
+  template <typename T, size_t Rows, size_t Cols>
+  TRON(nodiscard, inline, pure)
+  static T* plane(k_vnni_view<T, Rows, Cols> k) noexcept {
+    return k.data_;
+  }
+};
+}  // namespace detail
+
+// Contiguous transfer rows for page::set_k_row / page::get_k_row: one token's
+// head_size bf16 values in dimension order, not packed storage. The caller's
+// alignment and DMA flags travel with the row: the K row operations load and
+// store the row with unaligned vector instructions, so they do not require
+// VIEW_ALIGNED_TRUE (unlike the packed V rows).
+template <size_t Cols, bool Aligned = VIEW_ALIGNED_TRUE, bool Dma = VIEW_DMA_FALSE>
+using const_k_row_view = const_view<bf16, Aligned, Dma, seq<Cols>, sseq<1>>;
+
+template <size_t Cols, bool Aligned = VIEW_ALIGNED_TRUE, bool Dma = VIEW_DMA_FALSE>
+using k_row_view = view<bf16, Aligned, Dma, seq<Cols>, sseq<1>>;
+
+// The helpers neither check alignment nor copy data: the flags state what the
+// caller knows about its buffer.
+template <size_t Cols, bool Aligned = VIEW_ALIGNED_TRUE, bool Dma = VIEW_DMA_FALSE>
+TRON(nodiscard, inline)
+const_k_row_view<Cols, Aligned, Dma> k_source_row(const bf16* row) noexcept {
+  return const_k_row_view<Cols, Aligned, Dma>{row};
+}
+
+// A row that already is a rank-1 bf16 view keeps its own flags (the model's K
+// buffer rows come from slice<>, which carries the buffer's alignment and DMA
+// flags).
+template <size_t Cols, bool Aligned, bool Dma, ptrdiff_t Stride>
+  requires(Stride == 1)
+TRON(nodiscard, inline)
+const_k_row_view<Cols, Aligned, Dma> k_source_row(
+    view<bf16, Aligned, Dma, seq<Cols>, sseq<Stride>> row) noexcept {
+  return const_k_row_view<Cols, Aligned, Dma>{row};
+}
+
+template <size_t Cols, bool Aligned = VIEW_ALIGNED_TRUE, bool Dma = VIEW_DMA_FALSE>
+TRON(nodiscard, inline)
+k_row_view<Cols, Aligned, Dma> k_destination_row(bf16* row) noexcept {
+  return k_row_view<Cols, Aligned, Dma>{row};
+}
+
+// The operations below are AVX-512 code. As for packed V, the classes above
+// exist in every build (declarations naming them must compile), the
+// operations only in the 16-lane build.
+#if TRON_CHUNK_SIZE == 16
+
+namespace k_vnni::detail {
+// The byte address of dimension pair 0 of dimension step s for token `token`. The pair
+// rows dp = 0..15 of that panel follow at 64-byte steps.
+TRON(inline)
+char* pair_base(bf16* plane, size_t s, size_t token) noexcept {
+  const size_t c = token / BLOCK_TOKENS_16, t = token % BLOCK_TOKENS_16;
+  return reinterpret_cast<char*>(plane) +
+         ((s * TOKEN_BLOCKS_4 + c) * PANEL_DWORDS_256 + t) * DWORD_BYTES_4;
+}
+TRON(inline)
+const char* pair_base(const bf16* plane, size_t s, size_t token) noexcept {
+  const size_t c = token / BLOCK_TOKENS_16, t = token % BLOCK_TOKENS_16;
+  return reinterpret_cast<const char*>(plane) +
+         ((s * TOKEN_BLOCKS_4 + c) * PANEL_DWORDS_256 + t) * DWORD_BYTES_4;
+}
+// Dword offsets of the 16 pair rows of one panel (64 bytes = 16 dwords apart).
+TRON(inline)
+__m512i pair_row_offsets() noexcept {
+  constexpr int ROW_STRIDE_16 = int(ROW_DWORDS_16);
+  return _mm512_set_epi32(15 * ROW_STRIDE_16, 14 * ROW_STRIDE_16, 13 * ROW_STRIDE_16,
+      12 * ROW_STRIDE_16, 11 * ROW_STRIDE_16, 10 * ROW_STRIDE_16, 9 * ROW_STRIDE_16,
+      8 * ROW_STRIDE_16, 7 * ROW_STRIDE_16, 6 * ROW_STRIDE_16, 5 * ROW_STRIDE_16,
+      4 * ROW_STRIDE_16, 3 * ROW_STRIDE_16, 2 * ROW_STRIDE_16, 1 * ROW_STRIDE_16, 0);
+}
+// In-place transpose of a 16 x 16 matrix of 32-bit lanes. On return r[i]
+// holds lane i of every input register (input register t in lane t). Four
+// stages of two-register shuffles, 64 shuffles in all.
+TRON(inline)
+void transpose_16x16_epi32(__m512i (&r)[LANES_16]) noexcept {
+  // Selectors of _mm512_shuffle_i32x4: the even 128-bit quarters of both
+  // inputs (0x88) or the odd quarters (0xdd).
+  constexpr int EVEN_QUARTERS_0X88 = 0x88;
+  constexpr int ODD_QUARTERS_0XDD = 0xdd;
+  __m512i t[LANES_16];
+  for (size_t i = 0; i < LANES_16 / 2; ++i) {
+    t[2 * i] = _mm512_unpacklo_epi32(r[2 * i], r[2 * i + 1]);
+    t[2 * i + 1] = _mm512_unpackhi_epi32(r[2 * i], r[2 * i + 1]);
+  }
+  for (size_t i = 0; i < LANES_16 / 4; ++i) {
+    r[4 * i] = _mm512_unpacklo_epi64(t[4 * i], t[4 * i + 2]);
+    r[4 * i + 1] = _mm512_unpackhi_epi64(t[4 * i], t[4 * i + 2]);
+    r[4 * i + 2] = _mm512_unpacklo_epi64(t[4 * i + 1], t[4 * i + 3]);
+    r[4 * i + 3] = _mm512_unpackhi_epi64(t[4 * i + 1], t[4 * i + 3]);
+  }
+  for (size_t i = 0; i < LANES_16 / 4; ++i) {
+    t[i] = _mm512_shuffle_i32x4(r[i], r[i + 4], EVEN_QUARTERS_0X88);
+    t[i + 4] = _mm512_shuffle_i32x4(r[i], r[i + 4], ODD_QUARTERS_0XDD);
+    t[i + 8] = _mm512_shuffle_i32x4(r[i + 8], r[i + 12], EVEN_QUARTERS_0X88);
+    t[i + 12] = _mm512_shuffle_i32x4(r[i + 8], r[i + 12], ODD_QUARTERS_0XDD);
+  }
+  for (size_t i = 0; i < LANES_16 / 2; ++i) {
+    r[i] = _mm512_shuffle_i32x4(t[i], t[i + 8], EVEN_QUARTERS_0X88);
+    r[i + 8] = _mm512_shuffle_i32x4(t[i], t[i + 8], ODD_QUARTERS_0XDD);
+  }
+}
+}  // namespace k_vnni::detail
+
+// Store one token's 128-dimension K row into a packed plane. This takes 4
+// scatters of 16 dwords (one dimension pair each), one per dimension step. Only
+// this token's 64 pair slots are written. So several threads may store
+// different tokens of one plane at the same time (Note [Shared block save] in
+// model.hpp). The row is read with unaligned loads.
+template <size_t Rows, size_t Cols, bool Aligned, bool Dma>
+TRON(inline)
+void store_row(k_vnni_view<bf16, Rows, Cols> dst,
+    size_t token,
+    const_k_row_view<Cols, Aligned, Dma> src) noexcept {
+  bf16* const plane = detail::k_vnni_access::plane(dst);
+  const bf16* const row = src.data;
+  const __m512i offsets = k_vnni::detail::pair_row_offsets();
+  for (size_t s = 0; s < k_vnni::DIM_STEPS_4; ++s) {
+    const __m512i pairs = _mm512_loadu_si512(row + s * k_vnni::STEP_DIMS_32);
+    _mm512_i32scatter_epi32(k_vnni::detail::pair_base(plane, s, token), offsets, pairs,
+        k_vnni::DWORD_BYTES_4);
+  }
+}
+
+// Load one token's 128-dimension K row out of a packed plane (the inverse of
+// store_row). This takes 4 gathers of 16 dwords. The row is written with
+// unaligned stores.
+template <size_t Rows, size_t Cols, bool Aligned, bool Dma>
+TRON(inline)
+void load_row(k_vnni_view<const bf16, Rows, Cols> src,
+    size_t token,
+    k_row_view<Cols, Aligned, Dma> dst) noexcept {
+  const bf16* const plane = detail::k_vnni_access::plane(src);
+  bf16* const row = dst.data;
+  const __m512i offsets = k_vnni::detail::pair_row_offsets();
+  for (size_t s = 0; s < k_vnni::DIM_STEPS_4; ++s) {
+    const __m512i pairs = _mm512_i32gather_epi32(
+        offsets, k_vnni::detail::pair_base(plane, s, token), k_vnni::DWORD_BYTES_4);
+    _mm512_storeu_si512(row + s * k_vnni::STEP_DIMS_32, pairs);
+  }
+}
+
+// Store the K rows of up to 16 tokens of one token block c (tokens c * 16 + t
+// for the bits t set in `present`) into a packed plane with full-line stores.
+// For each of the 4 dimension steps, the 16 rows' 16 dimension pairs (one
+// 64-byte load per row) are transposed in registers into the panel's 16 pair
+// rows. Each pair row is then written as one 64-byte store (masked to the
+// present tokens' lanes when the block is partial). The absent tokens' slots
+// are not written. rows[t] points at the 128 bf16 of token t, one native row
+// in dimension order (not packed storage). It may be null for an absent
+// token. Compared with store_row per token, a full block issues 64 stores of
+// whole lines instead of 64 scatters, each writing 4 bytes into 16 lines
+// (every one of the block's 64 lines receives 16 partial writes). The same
+// 4 KiB is written. The write pattern differs.
+template <size_t Rows, size_t Cols>
+TRON(inline)
+void store_block(k_vnni_view<bf16, Rows, Cols> dst,
+    size_t c,
+    __mmask16 present,
+    const bf16* const rows[k_vnni::BLOCK_TOKENS_16]) noexcept {
+  bf16* const plane = detail::k_vnni_access::plane(dst);
+  for (size_t s = 0; s < k_vnni::DIM_STEPS_4; ++s) {
+    __m512i r[k_vnni::BLOCK_TOKENS_16];
+    for (size_t t = 0; t < k_vnni::BLOCK_TOKENS_16; ++t) {
+      r[t] = ((present >> t) & 1u)
+                 ? _mm512_loadu_si512(rows[t] + s * k_vnni::STEP_DIMS_32)
+                 : _mm512_setzero_si512();
+    }
+    k_vnni::detail::transpose_16x16_epi32(r);
+    bf16* panel = plane + (s * k_vnni::TOKEN_BLOCKS_4 + c) * k_vnni::PANEL_ELEMS_512;
+    if (present == k_vnni::FULL_BLOCK_0XFFFF) {
+      for (size_t dp = 0; dp < k_vnni::STEP_PAIRS_16; ++dp) {
+        _mm512_storeu_si512(panel + dp * k_vnni::ROW_ELEMS_32, r[dp]);
+      }
+    } else {
+      for (size_t dp = 0; dp < k_vnni::STEP_PAIRS_16; ++dp) {
+        _mm512_mask_storeu_epi32(panel + dp * k_vnni::ROW_ELEMS_32, present, r[dp]);
+      }
+    }
+  }
+}
+
+// Copy one token between packed K planes (or within one plane): the token's
+// row is gathered into a 64-byte-aligned local row (load_row) and scattered
+// into its destination column (store_row). Tokens own disjoint slots, so no
+// other token of the destination is touched.
+template <size_t Rows, size_t Cols>
+TRON(inline)
+void copy_token(k_vnni_view<bf16, Rows, Cols> dst,
+    size_t dst_token,
+    k_vnni_view<const bf16, Rows, Cols> src,
+    size_t src_token) noexcept {
+  alignas(K_PLANE_ALIGNMENT_64) bf16 row[Cols];
+  load_row(src, src_token, k_destination_row<Cols>(row));
+  store_row(dst, dst_token, k_source_row<Cols>(row));
+}
+
+#endif  // TRON_CHUNK_SIZE == 16
+
+}  // namespace tron
diff --git a/h/tron/tensor/kv_cache_fwd.hpp b/h/tron/tensor/kv_cache_fwd.hpp
new file mode 100644
index 00000000000..ca1e59d164b
--- /dev/null
+++ b/h/tron/tensor/kv_cache_fwd.hpp
@@ -0,0 +1,68 @@
+#pragma once
+// Forward declarations of the typed KV-cache tensor views. This header has no
+// intrinsics and no SIMD definitions, so intrinsics-free headers such as
+// h/tron/kernels/amx_attn_iface.hpp can name the views in kernel signatures.
+// The packed V definitions live in h/tron/tensor/v_vnni.hpp, the packed K
+// definitions in h/tron/tensor/k_vnni.hpp. The native K aliases are defined
+// below and name the view types of h/tron/tensor/view.hpp. See Note [VNNI
+// Packed V layout] in v_vnni.hpp and Note [K VNNI storage] in kv_cache.hpp.
+
+#include <cstddef>
+#include <utility>
+
+namespace tron {
+
+struct bf16;
+
+template <typename T, bool aligned, bool dma, typename Dim, typename Stride>
+struct view;
+
+template <typename T, bool aligned, bool dma, typename Dim, typename Stride>
+struct const_view;
+
+// Values for the aligned and dma template flags of view and const_view
+// (view.hpp, and views.hpp for the dma flag).
+inline constexpr bool VIEW_ALIGNED_TRUE = true;
+inline constexpr bool VIEW_DMA_FALSE = false;
+
+// Packed V types:
+// - v_vnni_tensor holds one bf16 array of [Rows tokens * Cols dimensions]. The
+//   array starts at an address that is a multiple of 64 bytes.
+// - v_vnni_view refers to that array and computes where each token's values are.
+// The view owns no memory. T = bf16 allows writes, and T = const bf16 is
+// read-only.
+template <size_t Rows, size_t Cols>
+struct v_vnni_tensor;
+template <typename T, size_t Rows, size_t Cols>
+struct v_vnni_view;
+
+// Packed K types (TRON_K_VNNI, Note [K VNNI storage] in kv_cache.hpp):
+// - k_vnni_tensor holds one bf16 array of [Rows tokens * Cols dimensions] in the
+//   K VNNI layout of h/tron/tensor/k_vnni.hpp. The array starts at an address
+//   that is a multiple of 64 bytes.
+// - k_vnni_view refers to that array and computes where each (token, dim) is.
+// The view owns no memory. T = bf16 allows writes, and T = const bf16 is
+// read-only.
+template <size_t Rows, size_t Cols>
+struct k_vnni_tensor;
+template <typename T, size_t Rows, size_t Cols>
+struct k_vnni_view;
+
+// Native K: the existing row-major plane view of the KV cache (kv_block::k_view),
+// spelled with its explicit strides so this header needs no default argument
+// from views.hpp. The aliases name the layout at kernel boundaries; native K
+// keeps its existing storage and view types.
+template <size_t Rows, size_t Cols>
+using native_k_view = view<bf16,
+    VIEW_ALIGNED_TRUE,
+    VIEW_DMA_FALSE,
+    std::integer_sequence<size_t, Rows, Cols>,
+    std::integer_sequence<ptrdiff_t, Cols, 1>>;
+template <size_t Rows, size_t Cols>
+using const_native_k_view = const_view<bf16,
+    VIEW_ALIGNED_TRUE,
+    VIEW_DMA_FALSE,
+    std::integer_sequence<size_t, Rows, Cols>,
+    std::integer_sequence<ptrdiff_t, Cols, 1>>;
+
+}  // namespace tron
diff --git a/h/tron/tensor/v_vnni.hpp b/h/tron/tensor/v_vnni.hpp
new file mode 100644
index 00000000000..b7d4e3e2a49
--- /dev/null
+++ b/h/tron/tensor/v_vnni.hpp
@@ -0,0 +1,410 @@
+#pragma once
+// This file defines typed access to the packed V plane of the KV cache: an owner
+// that holds the bytes (v_vnni_tensor), a matrix view that knows the address formula
+// (v_vnni_view), and the vector operations that move whole token rows in and
+// out (append_v_row, load_row, copy_token). See Note [VNNI Packed V layout].
+//
+// Words used here: A plane is V for one KV head of one 64-token page.
+// AVX-512 and AVX2 are the 512-bit and the 256-bit x86 vector instruction families;
+// they give the 16-lane and the 8-lane build. A lane is one 32-bit slot of a vector
+// register, here holding one bf16 pair. A chunk is one register of chunk_size fp32
+// values (16 or 8). A pair is two adjacent tokens (2p, 2p + 1). A pair chunk is the
+// 64-byte load that holds one chunk of both tokens of a pair (32 bf16).
+
+#include <concepts>
+#include <cstddef>
+#include <immintrin.h>
+#include <type_traits>
+
+#include "common/assert.hpp"
+#include "common/attributes.hpp"
+#include "common/numerics/bf16.hpp"
+#include "common/numerics/fp16.hpp"
+#include "tron/simd/auto.hpp"
+#include "tron/simd/types.hpp"
+#include "tron/tensor/kv_cache_fwd.hpp"
+#include "tron/tensor/seq.hpp"
+#include "tron/tensor/view.hpp"
+
+// Note [VNNI Packed V layout]
+// ~~~~~~~~~~~~~~~~~~~~~~~~~~~
+// In the 16-lane (AVX-512) build the V plane of a kv_block stores token pairs
+// interleaved: for each dimension d, the values of tokens 2p and 2p + 1 sit
+// next to each other. With D dimensions per token, element (token, d) is at
+//
+//   plane[(token / 2) * (2 * D) + 2 * d + token % 2]      (in bf16 elements)
+//
+// so one "pair row" of 2 * D bf16 holds two whole tokens. One 64-byte vector
+// load at pair_base + 2 * 16 * i yields dims [16 * i, 16 * i + 16) of both tokens.
+// In every 32-bit lane the even token sits in the low 16 bits and the odd token
+// in the high 16 bits. That is the VNNI layout (named after Intel's Vector
+// Neural Network Instructions): the B-operand layout of the bf16 dot product
+// instructions (VDPBF16PS and the AMX tile multiply). The weighted sum
+// (detail::scaled_v_expr in kv_cache.hpp) and the AMX PV kernel
+// (amx_attn_h128g4::weights_times_v_128x4) therefore read the plane in place.
+//
+// The 8-lane (AVX2) build keeps V row-major and does not use these types for
+// storage. The classes are still defined there, so that declarations naming
+// them (the AMX kernel signatures and their CPU fakes) compile. The vector
+// operations exist only at 16 lanes.
+//
+// Who may compute a packed address: the typed operations in this header, and
+// the two layout-specific kernels named above, which reach the plane through
+// detail::v_vnni_access. Cache code, the model, hardware staging and the tests
+// use the typed operations or the page accessors built on them (page::set_v,
+// page::get_v, page::append_v, page::v_packed). book::fill_random is the one
+// documented exception: it fills a whole kv_block without interpreting
+// coordinates.
+//
+// Writing rules are the cache's: see Note [Zero-Initialized V Slots] in
+// kv_cache.hpp. In short, appending an even token also zeroes its odd partner,
+// and appending an odd token merges into an initialized pair. Direct element
+// writes through a view (at()) do neither; they serve fixtures.
+
+namespace tron {
+
+namespace detail {
+// The one route from a packed view to its plane address, for the two
+// layout-specific kernels (Note [VNNI Packed V layout]) and the operations below.
+struct v_vnni_access;
+}  // namespace detail
+
+// Two tokens share one pair row of the packed plane.
+inline constexpr size_t V_PAIR_TOKENS_2 = 2;
+
+// Byte alignment of one packed V plane. In the 16-lane build every pair chunk is
+// one 64-byte vector load, and the AMX PV kernel reads the plane in 64-byte tile
+// rows. Fixed for both lane counts (chunk_alignment is 32 bytes at 8 lanes).
+inline constexpr size_t V_PLANE_ALIGNMENT_64 = 64;
+
+// page::set_v and page::get_v have always required head_size % 32 == 0. The
+// moved loops step one chunk (16 dims) at a time and do not need it. The
+// constraint stays so that the accepted row widths do not change.
+inline constexpr size_t V_ROW_WIDTH_MULTIPLE_32 = 32;
+
+// Width of one stored bf16 value: the shift that moves a value between the
+// low (even token) and the high (odd token) half of a 32-bit lane.
+inline constexpr unsigned BF16_BITS_16 = 16;
+
+// Lane masks selecting the odd (high half) or the even (low half) token.
+inline constexpr int V_ODD_TOKEN_LANE_MASK_0XFFFF0000 = static_cast<int>(0xffff0000u);
+inline constexpr int V_EVEN_TOKEN_LANE_MASK_0X0000FFFF = 0x0000ffff;
+
+template <typename T>
+concept v_vnni_element = std::same_as<T, bf16> || std::same_as<T, const bf16>;
+
+// A packed V plane of [Rows tokens * Cols dimensions]. One element is reached
+// through at(token, dim). Whole token rows move through the operations below
+// (append_v_row, load_row, copy_token). Views come only from an owner
+// (v_vnni_tensor::as_view). A writable view (bf16) converts to a read-only one
+// (const bf16), never the reverse. There is no public pointer constructor, no
+// data() accessor and no pointer conversion: a bare pointer does not say which
+// layout it points at.
+template <typename T, size_t Rows, size_t Cols>
+struct v_vnni_view final {
+  static_assert(v_vnni_element<T>, "a packed V plane holds bf16 or const bf16");
+  static_assert(Rows > 0 && Rows % V_PAIR_TOKENS_2 == 0,
+      "packed V pairs tokens, so a plane has an even number of rows");
+  static_assert(
+      Cols > 0 && Cols % chunk_size == 0, "a packed V row spans whole SIMD chunks");
+
+  // Writable-to-read-only conversion. Rebinding a view copies it; the owner
+  // must outlive every view.
+  template <typename U>
+    requires(std::is_const_v<T> && std::same_as<U, std::remove_const_t<T>>)
+  TRON(inline)
+  v_vnni_view(v_vnni_view<U, Rows, Cols> other) noexcept
+  : data_(other.data_) {}
+
+  // Bounds-checked element (token, dim). Writing through it neither clears the
+  // pair partner nor marks the token complete (page::mark_v_complete does
+  // that); see Note [Zero-Initialized V Slots].
+  TRON(nodiscard, inline, pure)
+  T& at(size_t token, size_t dim) noexcept {
+    TRON_ASSERT_LT(token, Rows);
+    TRON_ASSERT_LT(dim, Cols);
+    return pair_base(token)[V_PAIR_TOKENS_2 * dim + token % V_PAIR_TOKENS_2];
+  }
+
+  TRON(nodiscard, inline, pure)
+  const bf16& at(size_t token, size_t dim) const noexcept {
+    TRON_ASSERT_LT(token, Rows);
+    TRON_ASSERT_LT(dim, Cols);
+    return pair_base(token)[V_PAIR_TOKENS_2 * dim + token % V_PAIR_TOKENS_2];
+  }
+
+private:
+  friend struct v_vnni_tensor<Rows, Cols>;
+  friend struct detail::v_vnni_access;
+  template <typename U, size_t R, size_t C>
+  friend struct v_vnni_view;
+
+  TRON(inline)
+  explicit v_vnni_view(T* data) noexcept
+  : data_(data) {}
+
+  // First element of the pair row holding `token`: the address formula of
+  // Note [VNNI Packed V layout].
+  TRON(nodiscard, inline, pure)
+  T* pair_base(size_t token) const noexcept {
+    return data_ + (token / V_PAIR_TOKENS_2) * (V_PAIR_TOKENS_2 * Cols);
+  }
+
+  T* data_;
+};
+
+// Owns one packed V plane: exactly one 64-byte-aligned bf16 array, no separate
+// allocation and no initialization (the cache's DMA allocation creates the
+// kv_blocks that hold it; see Note [KV block lifetime] in kv_cache.hpp).
+// Trivial to construct, copy and destroy; copying an owner copies the plane.
+// as_view() on a temporary is deleted: a view must not outlive its owner.
+template <size_t Rows, size_t Cols>
+struct alignas(V_PLANE_ALIGNMENT_64) v_vnni_tensor final {
+  static_assert(Rows > 0 && Rows % V_PAIR_TOKENS_2 == 0,
+      "packed V pairs tokens, so a plane has an even number of rows");
+  static_assert(
+      Cols > 0 && Cols % chunk_size == 0, "a packed V row spans whole SIMD chunks");
+
+  TRON(nodiscard, inline)
+  v_vnni_view<bf16, Rows, Cols> as_view() & noexcept TRON(this_lifetimebound)
+  {
+    return v_vnni_view<bf16, Rows, Cols>(data_);
+  }
+
+  TRON(nodiscard, inline)
+  v_vnni_view<const bf16, Rows, Cols> as_view() const& noexcept TRON(this_lifetimebound)
+  {
+    return v_vnni_view<const bf16, Rows, Cols>(data_);
+  }
+
+  v_vnni_view<bf16, Rows, Cols> as_view() && = delete;
+  v_vnni_view<const bf16, Rows, Cols> as_view() const&& = delete;
+
+private:
+  alignas(V_PLANE_ALIGNMENT_64) bf16 data_[Rows * Cols];
+};
+
+namespace detail {
+struct v_vnni_access final {
+  // The plane's first element: pair row 0, token 0, dim 0.
+  template <typename T, size_t Rows, size_t Cols>
+  TRON(nodiscard, inline, pure)
+  static T* plane(v_vnni_view<T, Rows, Cols> v) noexcept {
+    return v.data_;
+  }
+
+  // First element of the pair row holding `token`. No bounds check here: this
+  // is the route of the bulk save/load/copy operations, whose callers (the
+  // page methods) already index inside the page, and page::set_v never checked
+  // it either. Checked element access goes through at().
+  template <typename T, size_t Rows, size_t Cols>
+  TRON(nodiscard, inline, pure)
+  static T* pair_base(v_vnni_view<T, Rows, Cols> v, size_t token) noexcept {
+    return v.pair_base(token);
+  }
+};
+}  // namespace detail
+
+// Contiguous, aligned transfer rows for set_v/get_v, not packed V storage.
+template <typename T, size_t Cols, bool Dma = VIEW_DMA_FALSE>
+using const_v_row_view = const_view<T, VIEW_ALIGNED_TRUE, Dma, seq<Cols>, sseq<1>>;
+
+template <typename T, size_t Cols, bool Dma = VIEW_DMA_FALSE>
+using v_row_view = view<T, VIEW_ALIGNED_TRUE, Dma, seq<Cols>, sseq<1>>;
+
+// The caller must provide Cols elements aligned to chunk_alignment.
+// These helpers neither check alignment nor copy data.
+template <size_t Cols, bool Dma = VIEW_DMA_FALSE, typename T>
+TRON(nodiscard, inline)
+const_v_row_view<T, Cols, Dma> v_source_row(const T* row) noexcept {
+  return const_v_row_view<T, Cols, Dma>{row};
+}
+
+template <size_t Cols, bool Dma = VIEW_DMA_FALSE, typename T>
+TRON(nodiscard, inline)
+v_row_view<T, Cols, Dma> v_destination_row(T* row) noexcept {
+  return v_row_view<T, Cols, Dma>{row};
+}
+
+#if TRON_CHUNK_SIZE == 16
+
+// Element types a packed V row may be appended from and loaded into.
+template <typename Source>
+concept v_vnni_source = std::same_as<Source, bf16> || std::same_as<Source, fp16> ||
+                        std::same_as<Source, float>;
+template <typename Destination>
+concept v_vnni_destination =
+    std::same_as<Destination, bf16> || std::same_as<Destination, float>;
+
+// Write one token's row into a packed plane from a contiguous, 64-byte-aligned
+// source row. An even token writes its row and zeroes its odd partner in one
+// pass, without reading the destination; an odd token merges into the
+// initialized pair and keeps its even partner (Note [Zero-Initialized V Slots]
+// in kv_cache.hpp). bf16 input keeps its bits. fp16 and float inputs become
+// fp32 and keep their upper 16 bits (truncation, no NaN correction), exactly as
+// page::set_v always did. The `aligned` flag of `src` is a precondition:
+// wrapping a pointer does not make it aligned.
+template <size_t Rows, size_t Cols, v_vnni_source Source, bool Dma>
+  requires(Cols % V_ROW_WIDTH_MULTIPLE_32 == 0)
+TRON(inline)
+void append_v_row(v_vnni_view<bf16, Rows, Cols> dst,
+    size_t token,
+    const_v_row_view<Source, Cols, Dma> src) noexcept {
+  bf16* v_ptr = detail::v_vnni_access::pair_base(dst, token);
+  const Source* vout_ptr = src.data;
+  if (token % V_PAIR_TOKENS_2 == 0) {
+    // The odd half of every lane is written as zero: see Note [Zero-Initialized
+    // V Slots] in kv_cache.hpp.
+    for (size_t i = 0; i < Cols; i += chunk_size) {
+      bf16x32 even;  // _ 7 _ 6 _ 5 _ 4 _ 3 _ 2 _ 1 _ 0
+      if constexpr (std::same_as<Source, bf16>) {
+        bf16x16 lo = _mm256_load_epi32(vout_ptr + i);  // 7 6 5 4 3 2 1 0
+        even = _mm512_cvtepu16_epi32(lo);
+      } else if constexpr (std::same_as<Source, fp16>) {
+        fp16x16 lo_fp16 = _mm256_load_epi32(vout_ptr + i);  // 7 6 5 4 3 2 1 0
+        fp32x16 lo_fp32 = _mm512_cvtph_ps(lo_fp16);         // 7 6 5 4 3 2 1 0
+        even = _mm512_srli_epi32(_mm512_castps_si512(lo_fp32), BF16_BITS_16);
+      } else {
+        fp32x16 lo_fp32 = _mm512_load_ps(vout_ptr + i);  // 7 6 5 4 3 2 1 0
+        even = _mm512_srli_epi32(_mm512_castps_si512(lo_fp32), BF16_BITS_16);
+      }
+      _mm512_store_si512(v_ptr + i * V_PAIR_TOKENS_2, even);
+    }
+  } else if constexpr (std::same_as<Source, bf16>) {
+    // Load even; interleave with odd; and store.
+    const __m512i lo_16_of_32 = _mm512_set1_epi32(V_EVEN_TOKEN_LANE_MASK_0X0000FFFF);
+    for (size_t i = 0; i < Cols; i += chunk_size) {
+      bf16x16 hi = _mm256_load_epi32(vout_ptr + i);  // f e d c b a 9 8
+      // f _ e _ d _ c _ b _ a _ 9 _ 8 _
+      bf16x32 odd = _mm512_slli_epi32(_mm512_cvtepu16_epi32(hi), BF16_BITS_16);
+      // _ 7 _ 6 _ 5 _ 4 _ 3 _ 2 _ 1 _ 0
+      bf16x32 even = _mm512_load_si512(v_ptr + i * V_PAIR_TOKENS_2);
+      // f 7 e 6 d 5 c 4 b 3 a 2 9 1 8 0
+      bf16x32 both = _mm512_ternarylogic_epi32(
+          odd, even, lo_16_of_32, _MM_TERNLOG_A | (_MM_TERNLOG_B & _MM_TERNLOG_C));
+      _mm512_store_si512(v_ptr + i * V_PAIR_TOKENS_2, both);
+    }
+  } else {
+    // Load even; interleave with odd; and store.
+    const __m512i hi_16_of_32 = _mm512_set1_epi32(V_ODD_TOKEN_LANE_MASK_0XFFFF0000);
+    for (size_t i = 0; i < Cols; i += chunk_size) {
+      bf16x32 odd;  // f _ e _ d _ c _ b _ a _ 9 _ 8 _
+      if constexpr (std::same_as<Source, fp16>) {
+        fp16x16 hi_fp16 = _mm256_load_epi32(vout_ptr + i);  // f e d c b a 9 8
+        fp32x16 hi_fp32 = _mm512_cvtph_ps(hi_fp16);         // f e d c b a 9 8
+        odd = _mm512_castps_si512(hi_fp32);
+      } else {
+        fp32x16 hi_fp32 = _mm512_load_ps(vout_ptr + i);  // f e d c b a 9 8
+        odd = _mm512_castps_si512(hi_fp32);
+      }
+      // _ 7 _ 6 _ 5 _ 4 _ 3 _ 2 _ 1 _ 0
+      bf16x32 even = _mm512_load_si512(v_ptr + i * V_PAIR_TOKENS_2);
+      // f 7 e 6 d 5 c 4 b 3 a 2 9 1 8 0
+      bf16x32 both = _mm512_ternarylogic_epi32(even, odd, hi_16_of_32,
+          (_MM_TERNLOG_A & ~_MM_TERNLOG_C) | (_MM_TERNLOG_B & _MM_TERNLOG_C));
+      _mm512_store_si512(v_ptr + i * V_PAIR_TOKENS_2, both);
+    }
+  }
+}
+
+// Read one token's row out of a packed plane into a contiguous, 64-byte-aligned
+// destination row: as fp32 (the stored bits become the upper half of every
+// value, lower half zero) or as the stored bf16 bits (one narrowing per chunk,
+// no conversion). The `aligned` flag of `dst` is a precondition.
+template <size_t Rows, size_t Cols, v_vnni_destination Destination, bool Dma>
+  requires(Cols % V_ROW_WIDTH_MULTIPLE_32 == 0)
+TRON(inline)
+void load_row(v_vnni_view<const bf16, Rows, Cols> src,
+    size_t token,
+    v_row_view<Destination, Cols, Dma> dst) noexcept {
+  const bf16* v_ptr = detail::v_vnni_access::pair_base(src, token);
+  Destination* vout_ptr = dst.data;
+  if (token % V_PAIR_TOKENS_2 == 0) {
+    for (size_t i = 0; i < Cols; i += chunk_size) {
+      // f 7 e 6 d 5 c 4 b 3 a 2 9 1 8 0
+      bf16x32 both = _mm512_load_si512(v_ptr + i * V_PAIR_TOKENS_2);
+      // 7 6 5 4 3 2 1 0
+      if constexpr (std::same_as<Destination, float>) {
+        fp32x16 lo_fp32 = _mm512_castsi512_ps(_mm512_slli_epi32(both, BF16_BITS_16));
+        _mm512_store_ps(vout_ptr + i, lo_fp32);
+      } else {
+        __m256i lo = _mm512_cvtepi32_epi16(both);
+        _mm256_store_si256(reinterpret_cast<__m256i*>(vout_ptr + i), lo);
+      }
+    }
+  } else {
+    const __m512i hi_16_of_32 = _mm512_set1_epi32(V_ODD_TOKEN_LANE_MASK_0XFFFF0000);
+    for (size_t i = 0; i < Cols; i += chunk_size) {
+      // f 7 e 6 d 5 c 4 b 3 a 2 9 1 8 0
+      bf16x32 both = _mm512_load_si512(v_ptr + i * V_PAIR_TOKENS_2);
+      // f e d c b a 9 8
+      if constexpr (std::same_as<Destination, float>) {
+        fp32x16 hi_fp32 = _mm512_castsi512_ps(_mm512_and_si512(both, hi_16_of_32));
+        _mm512_store_ps(vout_ptr + i, hi_fp32);
+      } else {
+        __m256i hi = _mm512_cvtepi32_epi16(_mm512_srli_epi32(both, BF16_BITS_16));
+        _mm256_store_si256(reinterpret_cast<__m256i*>(vout_ptr + i), hi);
+      }
+    }
+  }
+}
+
+// Copy one token between packed planes (or within one plane), any parity to
+// any parity. An even destination writes the row and zeroes its odd partner
+// without reading the destination; an odd destination merges into the
+// initialized pair. Use it only on a destination pair the caller is filling
+// fresh: an even copy discards whatever the odd slot held (Note
+// [Zero-Initialized V Slots] in kv_cache.hpp).
+template <size_t Rows, size_t Cols>
+TRON(inline)
+void copy_token(v_vnni_view<bf16, Rows, Cols> dst,
+    size_t dst_token,
+    v_vnni_view<const bf16, Rows, Cols> src,
+    size_t src_token) noexcept {
+  const bf16* src_pair = detail::v_vnni_access::pair_base(src, src_token);
+  bf16* dst_pair = detail::v_vnni_access::pair_base(dst, dst_token);
+  const __m512i hi_16_of_32 = _mm512_set1_epi32(V_ODD_TOKEN_LANE_MASK_0XFFFF0000);
+  if (src_token % V_PAIR_TOKENS_2 == 0) {
+    if (dst_token % V_PAIR_TOKENS_2 == 0) {
+      // src=[a b]; store [0 b]. See Note [Zero-Initialized V Slots].
+      for (size_t i = 0; i < Cols; i += chunk_size) {
+        bf16x32 a_b = _mm512_load_si512(src_pair + i * V_PAIR_TOKENS_2);
+        bf16x32 zero_b = _mm512_andnot_si512(hi_16_of_32, a_b);
+        _mm512_store_si512(dst_pair + i * V_PAIR_TOKENS_2, zero_b);
+      }
+    } else {
+      // Load src=[a b] and dst=[c d]; store [b d].
+      for (size_t i = 0; i < Cols; i += chunk_size) {
+        bf16x32 a_b = _mm512_load_si512(src_pair + i * V_PAIR_TOKENS_2);
+        bf16x32 c_d = _mm512_load_si512(dst_pair + i * V_PAIR_TOKENS_2);
+        bf16x32 b_zero = _mm512_slli_epi32(a_b, BF16_BITS_16);
+        bf16x32 b_d = _mm512_ternarylogic_epi32(
+            b_zero, c_d, hi_16_of_32, _MM_TERNLOG_A | (_MM_TERNLOG_B & ~_MM_TERNLOG_C));
+        _mm512_store_si512(dst_pair + i * V_PAIR_TOKENS_2, b_d);
+      }
+    }
+  } else {
+    if (dst_token % V_PAIR_TOKENS_2 == 0) {
+      // src=[a b]; store [0 a]. See Note [Zero-Initialized V Slots].
+      for (size_t i = 0; i < Cols; i += chunk_size) {
+        bf16x32 a_b = _mm512_load_si512(src_pair + i * V_PAIR_TOKENS_2);
+        bf16x32 zero_a = _mm512_srli_epi32(a_b, BF16_BITS_16);
+        _mm512_store_si512(dst_pair + i * V_PAIR_TOKENS_2, zero_a);
+      }
+    } else {
+      // Load src=[a b] and dst=[c d]; store [a d].
+      for (size_t i = 0; i < Cols; i += chunk_size) {
+        bf16x32 a_b = _mm512_load_si512(src_pair + i * V_PAIR_TOKENS_2);
+        bf16x32 c_d = _mm512_load_si512(dst_pair + i * V_PAIR_TOKENS_2);
+        bf16x32 a_zero = _mm512_and_si512(hi_16_of_32, a_b);
+        bf16x32 a_d = _mm512_ternarylogic_epi32(
+            a_zero, c_d, hi_16_of_32, _MM_TERNLOG_A | (_MM_TERNLOG_B & ~_MM_TERNLOG_C));
+        _mm512_store_si512(dst_pair + i * V_PAIR_TOKENS_2, a_d);
+      }
+    }
+  }
+}
+
+#endif  // TRON_CHUNK_SIZE == 16
+
+}  // namespace tron
