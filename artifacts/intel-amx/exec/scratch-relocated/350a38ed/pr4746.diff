+// The K store of save_k (Note [Shared block save] in model.hpp): the grouping
+// of a minibatch's tokens into page blocks, and the window that shares the
+// store with helper threads. The shapes a pass can present are all here: a
+// run that starts in the middle of a 16-token block, a run that crosses a
+// block boundary and one that crosses a page boundary, a whole block, a
+// token alone in its block, and jobs without KV work inside and after a run.
+// Every stored row must equal its source row bit for bit. Every other row of
+// the book must be untouched. With TRON_K_VNNI off the same test runs the
+// row-major store. No window opens then.
+TEST_CASE("save_k stores every token's K row once, grouped by page block, alone or "
+          "with helper threads",
+    "[kv_data][k_vnni]") {
+  using k_vnni::HEAD_SIZE_128;
+  constexpr size_t N_HEADS_16 = 16;
+  constexpr size_t DIM_2048 = HEAD_SIZE_128 * N_HEADS_16;
+  constexpr size_t HIDDEN_DIM_1024 = 1024;
+  constexpr size_t N_LAYERS_2 = 2;
+  constexpr size_t N_KV_HEADS_8 = 8;
+  constexpr size_t VOCAB_SIZE_32000 = 32000;
+  // The attention scale 1 / sqrt(128), as a hex float.
+  constexpr float ATTENTION_SCALE_0X1_6A09E6P_MINUS_4F = 0x1.6a09e6p-4f;
+  static_assert(DIM_2048 == 2048, "the constant's name states its value");
+  constexpr attention_geometry geometry{
+      N_HEADS_16, kv_geometry{N_KV_HEADS_8, HEAD_SIZE_128}};
+  constexpr llm_configuration llm_config{.type = model_type::llama,
+      .dim = DIM_2048,
+      .hidden_dim = HIDDEN_DIM_1024,
+      .n_layers = N_LAYERS_2,
+      .n_heads = N_HEADS_16,
+      .n_kv_heads = N_KV_HEADS_8,
+      .vocab_size = VOCAB_SIZE_32000,
+      .head_size = HEAD_SIZE_128,
+      .attention_scale = ATTENTION_SCALE_0X1_6A09E6P_MINUS_4F,
+      .n_experts = 1,
+      .n_shared_experts = 1,
+      .n_routed_experts_chosen = 0,
+      .rope_scaling_strategy = rope_scaling::simple};
+  using model_t =
+      model<llm<llm_config, make_llm_executor<false, tensor, tensor, tensor>>>;
+  using state_t = model_t::state;
+  using book_t = model_t::book;
+  using page_t = model_t::page;
+  using batch = model_t::batch;
+
+  std::unique_ptr<model_t> model =
+      std::make_unique<model_t>(std::filesystem::path{}, json(json::value_t::object));
+  constexpr size_t NUM_PAGES_3 = 3;
+  constexpr size_t NUM_KV_TOKENS_192 = NUM_PAGES_3 * page_t::page_size;
+  static_assert(NUM_KV_TOKENS_192 == 192, "the constant's name states its value");
+  constexpr uint32_t SEED_23 = 23;
+  std::mt19937 gen(SEED_23);
+  book_t bk(NUM_PAGES_3, N_LAYERS_2);
+  std::vector<page_t*> pages;
+  std::vector<page_t*> token_pages(NUM_KV_TOKENS_192);
+  for (size_t i = 0; i < NUM_PAGES_3; ++i) {
+    pages.push_back(bk.page_of(i * page_t::page_size));
+    pages.back()->set_lo(0, i * page_t::page_size);
+    for (size_t tok = 0; tok < page_t::page_size; ++tok) {
+      bk.increment_tokens_used();
+    }
+    pages.back()->set_offset_bound(page_t::page_size);
+  }
+  for (size_t tok = 0; tok < NUM_KV_TOKENS_192; ++tok) {
+    token_pages[tok] = bk.page_of(tok);
+  }
+
+  // The token jobs of the pass (token ids are the positions in the book).
+  std::vector<token_id> job_tokens;
+  std::vector<uint8_t> do_kv;
+  auto add = [&](size_t tok, bool kv) {
+    job_tokens.push_back(token_id(tok));
+    do_kv.push_back(kv ? 1 : 0);
+  };
+  // The token runs of the pass (a page holds 64 tokens, a block 16 tokens).
+  constexpr size_t FIRST_RUN_BEGIN_5 = 5;
+  constexpr size_t FIRST_RUN_END_21 = 21;
+  constexpr size_t NO_KV_TOKEN_8 = 8;
+  constexpr size_t WHOLE_BLOCK_BEGIN_48 = 48;
+  constexpr size_t WHOLE_BLOCK_END_64 = 64;
+  constexpr size_t PAGE_1_RUN_BEGIN_64 = 64;
+  constexpr size_t PAGE_1_RUN_END_72 = 72;
+  constexpr size_t LONE_TOKEN_100 = 100;
+  constexpr size_t PAGE_2_RUN_BEGIN_130 = 130;
+  constexpr size_t PAGE_2_RUN_END_136 = 136;
+  constexpr size_t TRAILING_NO_KV_TOKEN_21 = 21;
+  constexpr size_t KV_JOBS_46 = 46;  // 48 jobs minus the two without KV work
+  // Starts mid-block. Crosses blocks 0/1 of page 0. The job of token 8 has no
+  // KV work.
+  for (size_t tok = FIRST_RUN_BEGIN_5; tok < FIRST_RUN_END_21; ++tok) {
+    add(tok, tok != NO_KV_TOKEN_8);
+  }
+  // One whole block (block 3 of page 0).
+  for (size_t tok = WHOLE_BLOCK_BEGIN_48; tok < WHOLE_BLOCK_END_64; ++tok) {
+    add(tok, true);
+  }
+  // Page crossing 63 -> 64. Partial block 0 of page 1.
+  for (size_t tok = PAGE_1_RUN_BEGIN_64; tok < PAGE_1_RUN_END_72; ++tok) {
+    add(tok, true);
+  }
+  // Alone in block 2 of page 1. This case takes the per-token scatter path.
+  add(LONE_TOKEN_100, true);
+  // Page 2.
+  for (size_t tok = PAGE_2_RUN_BEGIN_130; tok < PAGE_2_RUN_END_136; ++tok) {
+    add(tok, true);
+  }
+  add(TRAILING_NO_KV_TOKEN_21, false);  // a trailing job without KV work
+  const size_t n_items = job_tokens.size();
+  REQUIRE(n_items == 48);  // more than 16. So the window can open.
+
+  state_t state(*model, model_config{.max_layers = N_LAYERS_2});
+  state.resize(n_items);
+  state.pages.items = std::span<page_t* const>(pages);
+  state.token_pages.items = std::span<page_t* const>(token_pages);
+  indexed_vector<token_job_id, token_id> jobs;
+  for (token_id t : job_tokens) {
+    jobs.push_back(t);
+  }
+  state.token_jobs = jobs;
+  state.token_jobs_do_kv.items = std::span<const uint8_t>(do_kv);
+  // Finite bf16 patterns per (job, element). No two rows share a pattern. A row
+  // stored at the wrong token position or in the wrong slot is then detected.
+  constexpr size_t KV_WIDTH_1024 = N_KV_HEADS_8 * HEAD_SIZE_128;
+  static_assert(KV_WIDTH_1024 == 1024, "the constant's name states its value");
+  constexpr uint32_t PATTERN_BASE_0X3800 = 0x3800u;
+  constexpr uint32_t PATTERN_SPAN_0X0800 = 0x0800u;
+  constexpr uint32_t JOB_STRIDE_4099 = 4099u;
+  constexpr uint32_t ELT_STRIDE_17 = 17u;
+  auto source_bits = [](size_t job, size_t elt) {
+    const size_t mix = job * JOB_STRIDE_4099 + elt * ELT_STRIDE_17;
+    return static_cast<uint16_t>(PATTERN_BASE_0X3800 + mix % PATTERN_SPAN_0X0800);
+  };
+  for (size_t job = 0; job < n_items; ++job) {
+    for (size_t elt = 0; elt < KV_WIDTH_1024; ++elt) {
+      state.plugin_state.kouts[token_job_id(job)][elt] =
+          bf16::from_bits(source_bits(job, elt));
+    }
+  }
+
+  latch_arena latches;
+  with_latch_arena latch_guard(latches);
+  std::vector<token_job_id> items;
+  for (size_t i = 0; i < n_items; ++i) {
+    items.push_back(token_job_id(i));
+  }
+  batch q_batch(state, std::move(items), latches, 0);
+  q_batch.reset_channels(0, 0);
+  // The active operation 0 of layer 0 (validate_operation compares the
+  // descriptor with it).
+  const attention_operation_descriptor operation = state.active_attention_operations[0];
+  REQUIRE(operation.writes_kv);
+  const kv_slot_id slot = operation.binding.kv_slot;
+
+  // Snapshot of every K row of the slot, to prove the untouched rows stay.
+  auto snapshot = [&] {
+    std::vector<std::array<uint16_t, HEAD_SIZE_128>> rows(
+        NUM_KV_TOKENS_192 * N_KV_HEADS_8);
+    alignas(64) std::array<bf16, HEAD_SIZE_128> row;
+    for (size_t tok = 0; tok < NUM_KV_TOKENS_192; ++tok) {
+      page_t* page = bk.page_of(tok);
+      const int offset = page->offset_in_page(token_id(tok));
+      for (size_t kv_head = 0; kv_head < N_KV_HEADS_8; ++kv_head) {
+        page->get_k_row(
+            slot, kv_head, offset, k_destination_row<HEAD_SIZE_128>(row.data()));
+        for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+          rows[tok * N_KV_HEADS_8 + kv_head][d] = row[d].to_bits();
+        }
+      }
+    }
+    return rows;
+  };
+  auto check = [&](std::vector<std::array<uint16_t, HEAD_SIZE_128>> const& before) {
+    constexpr int NO_JOB_MINUS_1 = -1;
+    std::vector<int> job_of_token(NUM_KV_TOKENS_192, NO_JOB_MINUS_1);
+    for (size_t job = 0; job < n_items; ++job) {
+      if (do_kv[job]) job_of_token[job_tokens[job].i] = static_cast<int>(job);
+    }
+    const auto after = snapshot();
+    size_t stored = 0, kept = 0;
+    for (size_t tok = 0; tok < NUM_KV_TOKENS_192; ++tok) {
+      for (size_t kv_head = 0; kv_head < N_KV_HEADS_8; ++kv_head) {
+        auto const& got = after[tok * N_KV_HEADS_8 + kv_head];
+        if (job_of_token[tok] < 0) {
+          REQUIRE(got == before[tok * N_KV_HEADS_8 + kv_head]);
+          ++kept;
+          continue;
+        }
+        const size_t job = static_cast<size_t>(job_of_token[tok]);
+        for (size_t d = 0; d < HEAD_SIZE_128; ++d) {
+          const uint16_t want = source_bits(job, kv_head * HEAD_SIZE_128 + d);
+          if (got[d] != want) {
+            FAIL("token " << tok << " kv_head " << kv_head << " dim " << d
+                          << ": stored 0x" << std::hex << got[d] << " expected 0x"
+                          << want);
+          }
+        }
+        ++stored;
+      }
+    }
+    REQUIRE(stored == KV_JOBS_46 * N_KV_HEADS_8);
+    REQUIRE(kept == (NUM_KV_TOKENS_192 - KV_JOBS_46) * N_KV_HEADS_8);
+  };
+
+  SECTION("one thread: the grouping stores every row and touches nothing else") {
+    bk.fill_random(gen);
+    const auto before = snapshot();
+    state.template save_k<geometry>(&q_batch, operation, state.plugin_state.kouts);
+    check(before);
+    REQUIRE(q_batch.k_store_window.opened.load() == 0);
+  }
+
+  SECTION("three threads: the helpers share the window and every row lands once") {
+    bk.fill_random(gen);
+    const auto before = snapshot();
+    constexpr size_t N_WORKERS_3 = 3;
+    std::vector<std::thread> helpers;
+    for (size_t worker_ix = 1; worker_ix < N_WORKERS_3; ++worker_ix) {
+      helpers.emplace_back([&, worker_ix] {
+        state.template save_k_helper<geometry>(
+            &q_batch, operation, state.plugin_state.kouts, worker_ix, N_WORKERS_3);
+      });
+    }
+    state.template save_k<geometry>(
+        &q_batch, operation, state.plugin_state.kouts, N_WORKERS_3);
+    for (auto& h : helpers) {
+      h.join();
+    }
+    check(before);
+    if constexpr (k_vnni::layout_on<HEAD_SIZE_128>) {
+      auto const& w = q_batch.k_store_window;
+      REQUIRE(w.opened.load() == 1);
+      REQUIRE(w.finished.load() == N_WORKERS_3 - 1);
+      // The work units cover the items in order, and every unit was claimed.
+      // The exact cut is not a contract: the writers only need that a unit
+      // never crosses a page, a 16-token page block or a change of
+      // token_jobs_do_kv (batch::k_store_window), so that two units never
+      // write the same token lanes and a unit that fills its block may use
+      // whole-line stores.
+      REQUIRE(w.n_units >= 1);
+      REQUIRE(w.unit_start[0] == 0);
+      REQUIRE(w.unit_start[w.n_units] == n_items);
+      REQUIRE(w.next_unit.load() >= w.n_units);
+      for (size_t u = 0; u < w.n_units; ++u) {
+        const size_t begin = w.unit_start[u];
+        const size_t end = w.unit_start[u + 1];
+        CAPTURE(u, begin, end);
+        REQUIRE(begin < end);
+        // The job's token position, its page and its 16-token block.
+        auto token_of = [&](size_t item) {
+          return job_tokens[q_batch.items[item].i].i;
+        };
+        auto block_of = [&](size_t tok) {
+          return (tok % page_t::page_size) / k_vnni::BLOCK_TOKENS_16;
+        };
+        const bool unit_kv = do_kv[q_batch.items[begin].i] != 0;
+        const page_t* unit_page = unit_kv ? token_pages[token_of(begin)] : nullptr;
+        const size_t unit_block = unit_kv ? block_of(token_of(begin)) : 0;
+        for (size_t t = begin; t < end; ++t) {
+          CAPTURE(t);
+          REQUIRE((do_kv[q_batch.items[t].i] != 0) == unit_kv);
+          if (unit_kv) {
+            REQUIRE(token_pages[token_of(t)] == unit_page);
+            REQUIRE(block_of(token_of(t)) == unit_block);
+          }
+        }
+      }
+    } else {
+      REQUIRE(q_batch.k_store_window.opened.load() == 0);
+    }
+  }
+}
