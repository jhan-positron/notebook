+#if TRON_CHUNK_SIZE == 16
+// The typed packed-V operations (h/tron/tensor/v_vnni.hpp) carry the bodies
+// that used to live in page::set_v / page::get_v, and page::v_packed exposes
+// the plane as a typed view. This case pins the contracts a move can
+// silently change and the value tests above (finite random data compared as
+// floats) cannot see:
+// - a bf16 source row is stored bit for bit, infinities and NaNs included;
+// - fp16 and float source rows become fp32 and keep their upper 16 bits:
+//   truncation, no rounding, no NaN correction, so a float NaN whose payload
+//   sits only in the discarded bits stores as infinity (the generic
+//   fp32s_to_bf16s conversion would keep it a NaN when TRON_IGNORE_NAN is off);
+// - get_v returns the stored bits, as bf16 or as the upper half of each fp32;
+// - at() on page::v_packed returns the stored bits of every token, so the
+//   address formula holds for both parities.
+TEST_CASE("packed V rows keep their bits through set_v, get_v and at()", "[kv_data]") {
+  static constexpr size_t HEAD_SIZE_64 = 64;
+  static constexpr size_t N_SLOTS_1 = 1;
+  static constexpr size_t X_BYTES_0 = 0;
+  static constexpr size_t N_PAGES_1 = 1;
+  // Base of the distinct bit patterns: exponent field 0x78 (see pattern below).
+  static constexpr uint16_t PATTERN_BASE_0X3C00 = 0x3c00;
+  // The token pairs that carry the special or converted rows in the sections.
+  static constexpr size_t SPECIALS_EVEN_TOKEN_2 = 2;
+  static constexpr size_t SPECIALS_ODD_TOKEN_3 = 3;
+  static constexpr size_t FLOAT_ROW_EVEN_TOKEN_4 = 4;
+  static constexpr size_t FLOAT_ROW_ODD_TOKEN_5 = 5;
+  static constexpr size_t FP16_ROW_EVEN_TOKEN_6 = 6;
+  static constexpr size_t FP16_ROW_ODD_TOKEN_7 = 7;
+  constexpr kv_geometry geometry{1, HEAD_SIZE_64};
+  using book_t = uniform_kv_cache<N_SLOTS_1, geometry, X_BYTES_0>;
+  using page_t = book_t::page_t;
+  constexpr kv_slot_id slot = test_kv_slot<book_t>(0);
+  book_t bk(N_PAGES_1);
+  page_t* page = bk.page_of(0);
+
+  // Distinct finite bf16 bit patterns per (token, dim): a wrong pair or parity
+  // cannot pass by coincidence. Exponent field 0x78..0x97, never 0xff.
+  auto pattern = [](size_t token, size_t dim) {
+    return static_cast<uint16_t>(PATTERN_BASE_0X3C00 + token * HEAD_SIZE_64 + dim);
+  };
+  auto as_bits = [](float x) { return std::bit_cast<uint32_t>(x); };
+
+  // Every token written from a bf16 row, so the whole plane is defined.
+  for (size_t token = 0; token < page_t::page_size; ++token) {
+    alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> row;
+    for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+      row[dim] = bf16::from_bits(pattern(token, dim));
+    }
+    page->set_v(slot, 0, token, v_source_row<HEAD_SIZE_64>(row.data()));
+  }
+
+  SECTION("bf16 rows round-trip bit for bit, as bf16 and as fp32") {
+    // Special values on an even and on an odd token: +inf, -inf, a quiet NaN
+    // with payload, and negative zero. No denormal: the process may run with
+    // denormals-are-zero set, and scalar bf16 copies in the test itself would
+    // then flush it, which says nothing about the packed path.
+    constexpr std::array<uint16_t, 4> specials{0x7f80u, 0xff80u, 0x7fc1u, 0x8000u};
+    auto special_row = [&](size_t token, std::array<bf16, HEAD_SIZE_64>& row) {
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        row[dim] = bf16::from_bits(
+            dim < specials.size() ? specials[dim] : pattern(token, dim));
+      }
+    };
+    alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> row;
+    special_row(SPECIALS_EVEN_TOKEN_2, row);
+    page->set_v(slot, 0, SPECIALS_EVEN_TOKEN_2, v_source_row<HEAD_SIZE_64>(row.data()));
+    // The even append must zero its odd partner (Note [Zero-Initialized V
+    // Slots]): token 3 still held its pattern from the fill above. Token 2
+    // carries 0xff80 and 0x8000 (sign bit set), so a sign-extending even path
+    // would leave 0xffff in the partner here.
+    {
+      alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> partner;
+      page->get_v(slot, 0, SPECIALS_ODD_TOKEN_3,
+          v_destination_row<HEAD_SIZE_64>(partner.data()));
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        CAPTURE(dim);
+        REQUIRE(partner[dim].to_bits() == 0);
+      }
+    }
+    special_row(SPECIALS_ODD_TOKEN_3, row);
+    page->set_v(slot, 0, SPECIALS_ODD_TOKEN_3, v_source_row<HEAD_SIZE_64>(row.data()));
+    for (size_t token = 0; token < page_t::page_size; ++token) {
+      alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> back;
+      page->get_v(slot, 0, token, v_destination_row<HEAD_SIZE_64>(back.data()));
+      alignas(chunk_alignment) std::array<float, HEAD_SIZE_64> back_f32;
+      page->get_v(slot, 0, token, v_destination_row<HEAD_SIZE_64>(back_f32.data()));
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        const uint16_t expected =
+            (token == SPECIALS_EVEN_TOKEN_2 || token == SPECIALS_ODD_TOKEN_3) &&
+                    dim < specials.size()
+                ? specials[dim]
+                : pattern(token, dim);
+        CAPTURE(token, dim);
+        REQUIRE(back[dim].to_bits() == expected);
+        REQUIRE(
+            as_bits(back_f32[dim]) == static_cast<uint32_t>(expected) << BF16_BITS_16);
+      }
+    }
+  }
+
+  SECTION("float rows truncate to their upper 16 bits, without NaN correction") {
+    // fp32 bit pattern -> stored bf16 bits under truncation. The second entry
+    // would round to 0x3f81 under round-to-nearest; the third would stay a NaN
+    // (0x7f81) under the generic conversion's NaN correction.
+    constexpr std::array<std::pair<uint32_t, uint16_t>, 5> cases{{
+        {0x3f800000u, 0x3f80u},  // 1.0
+        {0x3f80ffffu, 0x3f80u},  // just below the next bf16 value
+        {0x7f800001u, 0x7f80u},  // NaN with payload only in the low bits -> +inf
+        {0x7fc00000u, 0x7fc0u},  // quiet NaN, payload survives
+        {0xbf818000u, 0xbf81u},  // exact tie: truncation keeps the odd value
+    }};
+    for (size_t token : {FLOAT_ROW_EVEN_TOKEN_4, FLOAT_ROW_ODD_TOKEN_5}) {
+      alignas(chunk_alignment) std::array<float, HEAD_SIZE_64> row;
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        row[dim] = std::bit_cast<float>(
+            dim < cases.size()
+                ? cases[dim].first
+                : static_cast<uint32_t>(pattern(token, dim)) << BF16_BITS_16);
+      }
+      page->set_v(slot, 0, token, v_source_row<HEAD_SIZE_64>(row.data()));
+      alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> back;
+      page->get_v(slot, 0, token, v_destination_row<HEAD_SIZE_64>(back.data()));
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        CAPTURE(token, dim);
+        REQUIRE(back[dim].to_bits() ==
+                (dim < cases.size() ? cases[dim].second : pattern(token, dim)));
+      }
+    }
+    // The odd write (token 5) must not have disturbed its even partner.
+    alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> partner;
+    page->get_v(slot, 0, FLOAT_ROW_EVEN_TOKEN_4,
+        v_destination_row<HEAD_SIZE_64>(partner.data()));
+    for (size_t dim = 0; dim < cases.size(); ++dim) {
+      REQUIRE(partner[dim].to_bits() == cases[dim].second);
+    }
+  }
+
+  SECTION("fp16 rows convert through fp32 and truncate") {
+    // fp16 value -> stored bf16 bits. 65504 (the largest fp16) is 0x477fe000
+    // as fp32: truncation keeps 0x477f, rounding would give 0x4780.
+    constexpr std::array<std::pair<float, uint16_t>, 4> cases{{
+        {1.0f, 0x3f80u},
+        {65504.0f, 0x477fu},
+        {-0.00006103515625f, 0xb880u},  // -2^-14, the smallest fp16 normal
+        {0.5f, 0x3f00u},
+    }};
+    auto fp16_row = [&](size_t token, std::array<fp16, HEAD_SIZE_64>& row) {
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        row[dim] =
+            fp16(dim < cases.size() ? cases[dim].first
+                                    : float(bf16::from_bits(pattern(token, dim))));
+      }
+    };
+    auto check_row = [&](size_t token) {
+      alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> back;
+      page->get_v(slot, 0, token, v_destination_row<HEAD_SIZE_64>(back.data()));
+      for (size_t dim = 0; dim < cases.size(); ++dim) {
+        CAPTURE(token, dim);
+        REQUIRE(back[dim].to_bits() == cases[dim].second);
+      }
+    };
+    alignas(chunk_alignment) std::array<fp16, HEAD_SIZE_64> row;
+    fp16_row(FP16_ROW_EVEN_TOKEN_6, row);
+    page->set_v(slot, 0, FP16_ROW_EVEN_TOKEN_6, v_source_row<HEAD_SIZE_64>(row.data()));
+    // The even append must zero its odd partner: token 7 still held its
+    // pattern from the fill above, and token 6 carries -2^-14 (sign bit set).
+    {
+      alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> partner;
+      page->get_v(slot, 0, FP16_ROW_ODD_TOKEN_7,
+          v_destination_row<HEAD_SIZE_64>(partner.data()));
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        CAPTURE(dim);
+        REQUIRE(partner[dim].to_bits() == 0);
+      }
+    }
+    check_row(FP16_ROW_EVEN_TOKEN_6);
+    fp16_row(FP16_ROW_ODD_TOKEN_7, row);
+    page->set_v(slot, 0, FP16_ROW_ODD_TOKEN_7, v_source_row<HEAD_SIZE_64>(row.data()));
+    check_row(FP16_ROW_ODD_TOKEN_7);
+    check_row(FP16_ROW_EVEN_TOKEN_6);  // the odd append kept its even partner
+  }
+
+  SECTION("token copies keep bits in all four parity combinations") {
+    // book::append copies token by token (page::append_v -> copy_token). A
+    // destination that starts at an even token copies even<-even and odd<-odd;
+    // one that starts at an odd token copies odd<-even and even<-odd. The
+    // specials sit on source tokens 2 and 3, so a wrong half-lane merge in any
+    // parity branch changes bits here, which the float comparisons of the
+    // append cases above cannot see.
+    constexpr std::array<uint16_t, 4> specials{0x7f80u, 0xff80u, 0x7fc1u, 0x8000u};
+    auto source_bits = [&](size_t token, size_t dim) {
+      return (token == SPECIALS_EVEN_TOKEN_2 || token == SPECIALS_ODD_TOKEN_3) &&
+                     dim < specials.size()
+                 ? specials[dim]
+                 : pattern(token, dim);
+    };
+    const size_t dst_tokens = GENERATE(EVEN_START_DST_TOKENS_2, ODD_START_DST_TOKENS_3);
+    const size_t src_tokens = page_t::page_size - dst_tokens;
+    book_t dst_book(N_PAGES_1);
+    book_t src_book(N_PAGES_1);
+    alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> row;
+    for (size_t token = 0; token < dst_tokens; ++token) {
+      dst_book.increment_tokens_used();
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        row[dim] = bf16::from_bits(pattern(token, dim));
+      }
+      dst_book.page_of(0)->set_v(
+          slot, 0, token, v_source_row<HEAD_SIZE_64>(row.data()));
+    }
+    for (size_t token = 0; token < src_tokens; ++token) {
+      src_book.increment_tokens_used();
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        row[dim] = bf16::from_bits(source_bits(token, dim));
+      }
+      src_book.page_of(0)->set_v(
+          slot, 0, token, v_source_row<HEAD_SIZE_64>(row.data()));
+    }
+    dst_book.append(src_book);
+    REQUIRE(dst_book.size() == page_t::page_size);
+    for (size_t token = 0; token < page_t::page_size; ++token) {
+      alignas(chunk_alignment) std::array<bf16, HEAD_SIZE_64> back;
+      dst_book.page_of(0)->get_v(
+          slot, 0, token, v_destination_row<HEAD_SIZE_64>(back.data()));
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        const uint16_t expected = token < dst_tokens
+                                      ? pattern(token, dim)
+                                      : source_bits(token - dst_tokens, dim);
+        CAPTURE(dst_tokens, token, dim);
+        REQUIRE(back[dim].to_bits() == expected);
+      }
+    }
+  }
+
+  SECTION("at() reads the packed plane by (token, dim)") {
+    auto const plane = page->template v_packed<geometry>(slot, 0);
+    for (size_t token = 0; token < page_t::page_size; ++token) {
+      for (size_t dim = 0; dim < HEAD_SIZE_64; ++dim) {
+        CAPTURE(token, dim);
+        REQUIRE(plane.at(token, dim).to_bits() == pattern(token, dim));
+      }
+    }
+  }
+}
+#endif  // TRON_CHUNK_SIZE == 16
