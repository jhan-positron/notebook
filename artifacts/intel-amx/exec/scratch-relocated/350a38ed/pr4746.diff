+  auto const q = state.plugin_state.qs_roped[token_job_id(0)].as_view();
+  constexpr int SLIDING_WINDOW_1024 = 1024;
+  constexpr bool WAS_VALID_FALSE = false;
+  constexpr bool RUN_VISIBLE_IN_SOFTWARE_FALSE = false;
+  auto const result =
+      state.self_attn_state.apply_page_tok<geometry>(WAS_VALID_FALSE, *page, operation,
