lish a regression.","state":"COMMENTED","html_url":"https://github.com/positron-ai/tron/pull/4746#pullrequestreview-5396879413","pull_request_url":"https://api.github.com/repos/positron-ai/tron/pulls/4746","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/positron-ai/tron/pull/4746#pullrequestreview-5396879413"},"pull_request":{"href":"https://api.github.com/repos/positron-ai/tron/pulls/4746"}},"submitted_at":"2026-10-02T21:09:12Z","commit_id":"76ef81e2fc71f8430167709638e3c705eaaad6b3"},{"id":5398173500,"node_id":"PRR_kwDOKStajs8AAAABQcGXPA","user":{"login":"jhan-positron","id":277609589,"node_id":"U_kgDOEIv8dQ","avatar_url":"https://avatars.githubusercontent.com/u/277609589?v=4","gravatar_id":"","url":"https://api.github.com/users/jhan-positron","html_url":"https://github.com/jhan-positron","followers_url":"https://api.github.com/users/jhan-positron/followers","following_url":"https://api.github.com/users/jhan-positron/following{/other_user}","gists_url":"https://api.github.com/users/jhan-positron/gists{/gist_id}","starred_url":"https://api.github.com/users/jhan-positron/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jhan-positron/subscriptions","organizations_url":"https://api.github.com/users/jhan-positron/orgs","repos_url":"https://api.github.com/users/jhan-positron/repos","events_url":"https://api.github.com/users/jhan-positron/events{/privacy}","received_events_url":"https://api.github.com/users/jhan-positron/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"","state":"COMMENTED","html_url":"https://github.com/positron-ai/tron/pull/4746#pullrequestreview-5398173500","pull_request_url":"https://api.github.com/repos/positron-ai/tron/pulls/4746","author_association":"MEMBER","_links":{"html":{"href":"https://github.com/positron-ai/tron/pull/4746#pullrequestreview-5398173500"},"pull_request":{"href":"https://api.github.com/repos/positron-ai/tron/pulls/4746"}},"submitted_at":"202