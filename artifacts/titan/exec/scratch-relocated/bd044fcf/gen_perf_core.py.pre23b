#!/usr/bin/env python3
"""asimov-c1nano-perf.html: the C1-Nano core's latency, bandwidth, OCM and mesh numbers, with run 4 boot E
(the DSU L3 on) as the latest data, run 3 and boot C beside it. core_page() returns the HTML string;
gen_perf.main() writes it. Every number comes from gen_perf's data layer (the CSV files through gen_run3
and gen_run4); nothing is typed in except the cited platform facts from Jesse's README files.
The section order is prev/asimov-c1nano-perf.html's (sections 1 to 12)."""
import statistics
import gen_perf as p
from gen_perf import (kib, fmt, pct, table, fig, page, words, line_chart, dumbbell, strip, bars_h, mesh_map, dotplot, stacked_h,
                      hyp, gap, rng, dist, NODES, DSUS, NODE_OF_REGION, CPU_DSU, SLC_BYTES)
g = p.g; r4 = p.r4

# ---------------------------------------------------------------- lookups over the data layer
LV = {(d["size"], d["kind"]): d for d in p.LEVELS}
def lv(size, kind="repeat"): return LV[(size, kind)]
HIT = {h["size"]: h for h in p.HITSET}
L3_EST = statistics.mean(p.L3_HIT_EST.values())            # est. ns of one L3 hit, mean of the 256 and 384 KiB derivations
CORE_GHZ = g.CORE_GHZ                                       # core cycles per ns from the 4 KiB repeated row of run 3
READ_PATH, WRITE_PATH = 32 * CORE_GHZ, 16 * CORE_GHZ        # GB/s of the dual 128-bit read path and the 128-bit write path at that clock
ONE = {d["size"]: d for d in g.ONE}
RV = {(d["kernel"], d["size"]): d for d in p.READ_VARIANTS}
G8R = {(d["form"], d["kernel"], d["size"]): d for d in p.G8_ROWS}
CRB_PASS_NS = 4.2   # the CRB V3AE's per-pass fixed cost, the intercept of the per-pass read fit on CPU 3 (4.2 ns + bytes / 134.2 GB/s, residual 0.5 %) [follow-up-run-plan.md, "CRB check of the two forms", 2026-11-04]
WS = {d["size"]: d for d in p.WRITE_SMALL}
FLUSHED_E = lv(8388608, "flushed")["ns"]
SEQ_E, SEQ_C = p.SEQ_ROW["ns"]["E"], p.SEQ_ROW["ns"]["C"]
SMALL_RATIO = [d["ratio"] for d in p.LEVELS if d["kind"] == "repeat" and d["size"] <= 131072]
L3_SIZES3 = (196608, 262144, 393216)
E_PLAIN = {s: RV[("read", s)]["agg"]["E"] for s in p.RP_SIZES}; C_PLAIN = {s: RV[("read", s)]["agg"]["C"] for s in p.RP_SIZES}
RUN3_PLAIN = {s: RV[("read", s)]["run3"] for s in p.RP_SIZES}
ASM16_24 = [G8R[("asm", "read", s)]["agg"][x] for x in "CE" for s in (16384, 24576)]
MOVED = [d for d in p.REPEAT_E3 if abs(d["pct"]) >= 1.0]
ROUTE_BY_DIST = {}
for d in p.ROUTES: ROUTE_BY_DIST.setdefault(d["dist"], []).append(d)
E_SPARSE_CPU2 = [d for d in p.OCM_SPARSE if d["cpu"] == 2]
SPARSE_MINUS_DENSE_E = [d["E"]["best"] - d["E"]["dense"] for d in p.OCM_SPARSE]
ROUTE_E_VS_A = [d["E"]["best"] - d["A"]["best"] for d in p.ROUTES]
RUN3_LABEL = "run 3 (membench-jibin-004, the L3 off)"
# run 6 boot F1 (membench-jibin-011, 2026-11-06, commit 0c190a1, the L3 on, prefetchers on): run 3's whole command set repeated with the L3 on [gen_run6 through gen_perf]
F1 = p.F1; K1 = F1["core"]
ONE1 = {d["size"]: d for d in K1["ONE"]}
M1 = {(d["kernel"], d["size"], d["threads"]): d for d in K1["PAIR"] + K1["PERDSU"] + K1["ALL8"]}
PLACE1 = {q["cpus"]: q for q in K1["PLACE"]}
OCMBW1, ATTR1 = K1["OCMBW"], K1["ATTR"]
F1_LABEL = "run 6 boot F1 (membench-jibin-011, the L3 on)"
_m3 = lambda d: M1[(d["kernel"], d["size"], d["threads"])]["agg"]   # F1's aggregate of a run 3 multi-core row
_rd = lambda threads, size: next(d for d in g.PERDSU + g.ALL8 if d["kernel"] == "read" and d["size"] == size and d["threads"] == threads)
_LV1 = {(d["size"], d["kind"]): d["ns"] for d in K1["LV"]}; _LV3 = {(d["size"], d["kind"]): d["ns"] for d in g.LV4}
_dev = lambda sizes, kind="repeat": max(abs(_LV1[(sz, kind)] / _LV3[(sz, kind)] - 1) * 100 for sz in sizes)   # % of run 3, the largest over the sizes
F1_DEV = dict(l1l2=_dev((4096, 8192, 16384, 24576, 32768, 49152, 65536, 98304, 131072)), dram=_dev((6291456, 8388608, 16777216, 33554432), "fresh"), flushed=_dev((8388608,), "flushed"),
              m4=100 * (_LV1[(4194304, "fresh")] / _LV3[(4194304, "fresh")] - 1), l3=(min(_LV1[(sz, "fresh")] / _LV3[(sz, "fresh")] for sz in (524288, 786432, 1048576)), max(_LV1[(sz, "fresh")] / _LV3[(sz, "fresh")] for sz in (524288, 786432, 1048576))),
              writes=max(abs(ONE1[sz]["write"] / ONE[sz]["write"] - 1) * 100 for sz in ONE1))
PAIR_W_SMALL = {sz: M1[("write", sz, 2)]["agg"] / next(d for d in g.PAIR if d["kernel"] == "write" and d["size"] == sz)["run3"] for sz in (49152, 163840)}

# ---- section 7.1 and 8: the L1 pass arithmetic and the in-flight lanes
E_ASM = p.G8["E"][("asm", "read")]["rows"]                      # boot E, every pass inside one call: t_pass ns and agg GB/s by size
L1_RATE = p.G8_MARGINAL[("E", "asm")]                           # GB/s of the 8 KiB added between the 8 and 16 KiB passes
PASS_F = E_ASM[16384]["t_pass"] - 16384 / L1_RATE               # ns est. per pass that is not reading, at 16 KiB
E_PP = p.G8["E"][("per-pass", "read")]["rows"]
PASS_F_PP = E_PP[16384]["t_pass"] - 16384 / p.G8_MARGINAL[("E", "per-pass")]   # the same est. for the looped form's read passes
CRB_GHZ = 2.8   # the CRB V3AE clock [follow-up-run-plan.md, run 5c, 'V3AE at 2.8 GHz']
IDEAL = lambda size: size / READ_PATH                            # ns a pass would take at the read path's rate
L1_CHASE = lv(4096)["ns"]                                        # ns per dependent load in L1 (the 4 KiB chain)
IN_FLIGHT = FLUSHED_E / SEQ_E                                    # est. DRAM reads open at once on the sequential chain of boot E
SEQ_B = p.SEQ_ROW["ns"]["B"]
SEQ_GBPS = 64 / SEQ_E
LINE_NS = 64 / READ_PATH                                         # ns per 64-byte line at the read path's rate
def CNT(boot, row):
    """the refill counters of a boot's SEQ or FLUSHED row as table cells: L1 refills, L1 prefetch refills, demand L1 refills (derived), L2 refills, L2 refills for L1 prefetches, L3 read refills"""
    e = r4.BT[boot][row]["e"]
    return [f"{e['l1d_refill']:.4f}", f"{e['l1d_refill_hwprf']:.4f}", f"{e['l1d_refill'] - e['l1d_refill_hwprf']:.4f}", f"{e['l2d_refill']:.4f}", f"{e['l2d_refill_l1dhwprf']:.4f}", f"{e['l3d_refill_rd']:.4f}"]

def pass_fig(w=960):
    """section 7.1: the 8 and 16 KiB passes of boot E's single-call form, to scale, and their difference"""
    L, R, T, rh = 250, 20, 30, 30; tmax = 360.0
    rows = [("8 KiB pass", E_ASM[8192]["t_pass"]), ("16 KiB pass", E_ASM[16384]["t_pass"]), ("difference: the added 8 KiB", None)]
    svg = g.SVG(w, T + rh * 3 + 56); fx = lambda t: L + t / tmax * (w - L - R)
    for tk in range(0, 301, 50):
        svg.line(fx(tk), T - 6, fx(tk), T + rh * 3, g.C["grid"]); svg.text(fx(tk), T - 10, f"{tk}", 10, "middle", g.C["muted"])
    svg.text(w - R, T - 10, "ns", 10, "end", g.C["ink2"])
    seg = 8192 / L1_RATE
    for i, (label, t) in enumerate(rows):
        y = T + rh * i + 4; svg.text(L - 10, y + 15, label, 12, "end")
        if t is not None:
            svg.rect(fx(0), y, fx(PASS_F) - fx(0), rh - 8, g.C["s2"], f"not reading: {PASS_F:.1f} ns est. per pass")
            svg.text(fx(PASS_F / 2), y + 15, "F", 11, "middle", "#fff", "bold")
            n = 1 if label.startswith("8") else 2
            for k in range(n):
                x0 = fx(PASS_F + k * seg); svg.rect(x0 + 1, y, fx(PASS_F + (k + 1) * seg) - x0 - 2, rh - 8, g.C["s1"], f"8 KiB at {L1_RATE:.1f} GB/s: {seg:.1f} ns")
                svg.text((x0 + fx(PASS_F + (k + 1) * seg)) / 2, y + 15, f"8 KiB, {seg:.0f} ns", 11, "middle", "#fff")
            svg.text(fx(t) + 6, y + 15, f"{t:.1f} ns measured", 11, "start", g.C["ink2"])
        else:
            x0 = fx(PASS_F + seg); svg.rect(x0 + 1, y, fx(PASS_F + 2 * seg) - x0 - 2, rh - 8, g.C["s4"], f"{E_ASM[16384]['t_pass'] - E_ASM[8192]['t_pass']:.1f} ns for 8,192 bytes")
            svg.text((x0 + fx(PASS_F + 2 * seg)) / 2, y + 15, f"{E_ASM[16384]['t_pass'] - E_ASM[8192]['t_pass']:.1f} ns", 11, "middle", "#fff")
            svg.text(fx(PASS_F + 2 * seg) + 6, y + 15, f"8,192 B / {E_ASM[16384]['t_pass'] - E_ASM[8192]['t_pass']:.1f} ns = {L1_RATE:.1f} GB/s", 11, "start", g.C["ink2"])
    g.legend(svg, L, T + rh * 3 + 24, [("F: time of a pass that is not reading (est., the same in both passes)", g.C["s2"]), ("reading at the L1's rate", g.C["s1"]), ("the difference", g.C["s4"])], w)
    return svg.out()

def lanes_fig(w=960):
    """section 8: wall-clock lanes, durations to scale over the first 170 ns of each measurement"""
    L, R, T = 262, 20, 30; tmax = 170.0; svg_rows = []
    fx = lambda t: L + t / tmax * (w - L - R)
    lanes = [("random chain, flushed, boot E", "serial", FLUSHED_E, g.C["s2"], f"one DRAM read per load, {FLUSHED_E:.1f} ns. The next address is inside the line"),
             ("sequential chain, prefetchers off, boot B", "serial", SEQ_B, g.C["s2"], f"one DRAM read per load, {SEQ_B:.1f} ns. No prefetch is issued"),
             ("boot E prefetcher: DRAM reads in flight", "waterfall", None, g.C["s3"], f"a new read every {SEQ_E:.2f} ns, each {FLUSHED_E:.1f} ns long (est.), about {IN_FLIGHT:.0f} in flight (est.)"),
             ("sequential chain, boot E: the core loads", "ticks", SEQ_E, g.C["s1"], f"one load per {SEQ_E:.2f} ns, which is {L1_CHASE:.2f} ns of L1 time plus {SEQ_E - L1_CHASE:.2f} ns (derived)"),
             ("4 KiB chain in L1, dependent loads", "serial", L1_CHASE, g.C["s1"], f"one load per {L1_CHASE:.2f} ns ({p.CONTROLS['E']['p4k_cyc']:.2f} cycles). Each waits for the one before"),
             ("L1 read loop, independent loads", "stream", LINE_NS, g.C["s1"], f"computed, not measured: one 64-byte line per {LINE_NS:.1f} ns, two 16-byte loads every cycle")]
    heights = {"serial": 36, "waterfall": 3 * int(round(IN_FLIGHT)) + 18, "ticks": 36, "stream": 36}
    H = T + sum(heights[k] for _, k, _, _, _ in lanes) + 8 * len(lanes) + 20
    svg = g.SVG(w, H)
    for tk in range(0, 171, 25):
        svg.line(fx(tk), T - 6, fx(tk), H - 20, g.C["grid"]); svg.text(fx(tk), T - 10, f"{tk}", 10, "middle", g.C["muted"])
    svg.text(w - R, T - 10, "ns, to scale", 10, "end", g.C["ink2"])
    y = T
    for label, kind, dur, color, note in lanes:
        h = heights[kind]; svg.text(L - 10, y + 15, label, 11, "end")
        if kind == "serial":
            t = 0.0; i = 0
            while t < tmax:
                x0, x1 = fx(t), fx(min(t + dur, tmax)); svg.rect(x0 + 0.5, y + 4, max(x1 - x0 - 1, 1), 16, color, f"load {i + 1}: {dur:.2f} ns")
                if dur > 20 and t + dur <= tmax: svg.text((x0 + x1) / 2, y + 16, f"load {i + 1}, {dur:.1f} ns", 10, "middle", "#fff")
                t += dur; i += 1
        elif kind == "waterfall":
            n = int(round(IN_FLIGHT)); i = 0; t = 0.0
            while t < tmax:
                yy = y + 4 + 3 * (i % n); x0, x1 = fx(t), fx(min(t + FLUSHED_E, tmax))
                svg.rect(x0, yy, max(x1 - x0, 1), 2, color, f"read {i + 1}: issued at {t:.1f} ns, arrives at {t + FLUSHED_E:.1f} ns est.", rx=0)
                t += SEQ_E; i += 1
        elif kind == "ticks":
            t = 0.0; i = 0
            while t < tmax:
                x0 = fx(t); svg.rect(x0, y + 4, max(fx(t + L1_CHASE) - x0 - 0.5, 1), 16, color, f"load {i + 1}: {dur:.2f} ns", rx=0); t += dur; i += 1
        else:
            t = 0.0; i = 0
            while t < tmax:
                x0 = fx(t); svg.rect(x0, y + 4, max(fx(t + dur) - x0 - 0.6, 0.8), 16, color, f"line {i + 1}: {dur:.1f} ns", rx=0); t += dur; i += 1
        svg.text(L + 2, y + h - 2, note, 10, "start", g.C["ink2"])
        y += h + 6
    return svg.out()

def open_(s): return f'<span class="gap">open</span>{s}'

def sec_f1_vs_run3():
    """2.3: boot F1 against run 3. The setup facts are Jesse's F1 README's (Core rows against round three);
    every ratio is computed here from both folders' CSV files."""
    R3 = {(d["size"], d["kind"]): d for d in g.LV4}; R1 = {(d["size"], d["kind"]): d for d in K1["LV"]}
    sizes = lambda kind, lo, hi: [(sz, kind) for sz in sorted({k[0] for k in R1 if k[1] == kind}) if lo <= sz <= hi]
    lat = lambda keys: [R3[k]["ns"] / R1[k]["ns"] for k in keys]                        # above 1 = faster on F1
    ONE3 = {d["size"]: d for d in g.ONE}; big = sorted(sz for sz in ONE1 if sz > 16384)
    m3 = lambda k, sz, n: next(d for d in g.PAIR + g.PERDSU + g.ALL8 if d["kernel"] == k and d["size"] == sz and d["threads"] == n)["run3"]
    multi = lambda k, szs, n: [M1[(k, sz, n)]["agg"] / m3(k, sz, n) for sz in szs]
    KK = ("read", "write", "copy")
    groups = [
        ("Chains 4 to 128 KiB (L1, L2)", lat(sizes("repeat", 0, 131072))),
        ("Chains 192 to 384 KiB (the L3's sizes)", lat(sizes("repeat", 196608, 393216))),
        ("Fresh chains 512 KiB to 1 MiB", lat(sizes("fresh", 524288, 1048576))),
        ("Fresh chains 1.5 to 4 MiB (the SLC)", lat(sizes("fresh", 1572864, 4194304))),
        ("Fresh chains 6 to 32 MiB (DRAM)", lat(sizes("fresh", 6291456, 33554432))),
        ("Flushed 8 MiB chain", lat([(8388608, "flushed")])),
        ("4 KiB controls, CPUs 2, 4, 6, 8", [g.CTRL[c]["best"] / K1["CTRL"][c]["best"] for c in (2, 4, 6, 8)]),
        ("OCM, one line per page, per region, CPUs 2 to 8 (20 rows)", [g.OCM[c][r]["best"] / K1["OCM"][c][r]["best"] for c in K1["OCM"] for r in K1["OCM"][c]]),
        ("OCM, one line per page, all five regions, CPUs 2 to 8", [g.ALL5S[c]["best"] / K1["ALL5S"][c]["best"] for c in K1["ALL5S"]]),
        ("OCM, every line, all five regions, CPUs 2 to 8", [g.ALL5D[c]["best"] / K1["ALL5D"][c]["best"] for c in K1["ALL5D"]]),
        ("2 MiB SLC chains, CPUs 4, 6, 8", [g.SLC[c]["best"] / K1["SLC"][c]["best"] for c in (4, 6, 8)]),
        ("One core, 16 KiB: read, write, copy", [ONE1[16384][k] / ONE3[16384][k] for k in KK]),
        ("One core read, 48 KiB to 32 MiB", [ONE1[sz]["read"] / ONE3[sz]["read"] for sz in big]),
        ("One core write, 48 KiB to 32 MiB", [ONE1[sz]["write"] / ONE3[sz]["write"] for sz in big]),
        ("One core copy, 48 KiB to 32 MiB", [ONE1[sz]["copy"] / ONE3[sz]["copy"] for sz in big]),
        ("OCM read, one core, per region and all five", [OCMBW1["region"][r] / g.OCMBW["region"][r] for r in range(5)] + [OCMBW1["all5"] / g.OCMBW["all5"]]),
        ("OCM read, four cores", [OCMBW1["four"] / g.OCMBW["four"]]),
        ("OCM write, one core", [OCMBW1["write"] / g.OCMBW["write"]]),
        ("Pair (CPUs 2, 3), 16 KiB: read, write, copy", [M1[(k, 16384, 2)]["agg"] / m3(k, 16384, 2) for k in KK]),
        ("Pair, 48 and 160 KiB: read", multi("read", (49152, 163840), 2)),
        ("Pair, 48 and 160 KiB: write", multi("write", (49152, 163840), 2)),
        ("Pair, 48 and 160 KiB: copy", multi("copy", (49152, 163840), 2)),
        ("One core per cluster, 2 and 16 MiB: read", multi("read", (2097152, 16777216), 4)),
        ("One core per cluster, 2 and 16 MiB: write", multi("write", (2097152, 16777216), 4)),
        ("One core per cluster, 2 and 16 MiB: copy", multi("copy", (2097152, 16777216), 4)),
        ("All eight cores, 2 and 16 MiB: read", multi("read", (2097152, 16777216), 8)),
        ("All eight cores, 2 and 16 MiB: write", multi("write", (2097152, 16777216), 8)),
        ("All eight cores, 2 and 16 MiB: copy", multi("copy", (2097152, 16777216), 8)),
        ("Writer placement, six rows", [PLACE1[q]["agg"] / next(d["run3"] for d in g.PLACE if d["cpus"] == q) for q in PLACE1]),
    ]
    n_rows = sum(len(v) for _, v in groups)
    f_ratio = dotplot([dict(label=f"{name}" + ("" if "rows)" in name else f" ({len(v)})"), vals=[min(v), max(v)]) for name, v in groups],
                      ["lowest row of the group", "highest row of the group"], [g.C["muted"], g.C["s1"]], unit="ratio", xlim=(0.5, 3.0), rh=19, L=400)
    t_ratio = table(["Row group", "Rows", "Speed ratio, F1 over run 3", "Reading"],
                    [[name, len(v), f"{min(v):.2f}" if len(v) == 1 else f"{min(v):.2f} to {max(v):.2f}",
                      "unchanged" if max(abs(x - 1) for x in v) < 0.05 else "faster on F1" if min(v) > 1 else "slower on F1" if max(v) < 1 else "mixed"] for name, v in groups],
                    note=f"{n_rows} rows. Latency rows: run 3's best ns per load over F1's. Bandwidth rows: F1's best aggregate GB/s over run 3's. So above 1 is faster on F1 in every row. 'Unchanged' means every row of the group within 5 % [the CSV files of 011 and 004].")
    # the counter evidence
    l3s = (196608, 262144, 393216)
    l2_3 = [R3[(sz, "repeat")]["l2"] for sz in l3s]; l2_1 = [R1[(sz, "repeat")]["l2"] for sz in l3s]
    a2_3 = [R3[(sz, "repeat")]["l3"] for sz in l3s]; a2_1 = [R1[(sz, "repeat")]["l3"] for sz in l3s]
    sp_a2_3 = [q["l3"] for c in g.OCM for r in g.OCM[c] for q in g.OCM[c][r]["passes"]]; sp_a2_1 = [q["l3"] for c in K1["OCM"] for r in K1["OCM"][c] for q in K1["OCM"][c][r]["passes"]]
    sp_l2_3 = [q["l2"] for c in g.OCM for r in g.OCM[c] for q in g.OCM[c][r]["passes"]]; sp_l2_1 = [q["l2"] for c in K1["OCM"] for r in K1["OCM"][c] for q in K1["OCM"][c][r]["passes"]]
    c1, c3 = K1["CMN"]["dram-read-2M-cpu2"], g.CMN4["dram-read-2M-cpu2"]
    req_ratio = sum(c1["node"].values()) / sum(c3["node"].values()); life_ratio = c1["child"] / c3["child"]
    ctl_life = [K1["CMN"][f"control-cpu{c}"]["child"] / g.CMN4[f"control-cpu{c}"]["child"] for c in (2, 4, 6, 8)]
    e32, c32 = RV[("read", 33554432)]["e"]["E"], RV[("read", 33554432)]["e"]["C"]
    rd4 = M1[("read", 16777216, 4)]; rd8 = M1[("read", 16777216, 8)]
    per4 = (rd4["tmin"] / ONE1[33554432]["read"], rd4["tmax"] / ONE1[33554432]["read"])
    e_over_c = {sz: E_PLAIN[sz] / C_PLAIN[sz] for sz in (2097152, 33554432)}
    bd32 = (RV[("read", 33554432)]["agg"]["B"], RV[("read", 33554432)]["agg"]["D"])
    ratio = lambda name: next(v for n, v in groups if n == name)
    rd1 = ratio("One core read, 48 KiB to 32 MiB"); wr1 = ratio("One core write, 48 KiB to 32 MiB"); ch = ratio("Fresh chains 1.5 to 4 MiB (the SLC)") + ratio("Fresh chains 6 to 32 MiB (DRAM)")
    return f"""
<h3 id="f1vs3">2.3 Boot F1 against run 3: what differed, what moved, and the hypotheses</h3>
<p><b>Short version.</b> Boot F1 ran run 3's 67 core command lines in run 3's order, on boot E's firmware, where the one platform change that matters is the L3 of CPUs 2 to 9 in full mode. Every stream of independent reads got faster (1.2 to 2.9 times), while the dependent chains beyond the L3 (within 4 %), the one-core writes, the writer-placement rows and the controls (within 0.3 %) repeated run 3. The counters show the same number of refills per line and the same number of mesh requests per command, so the reads overlap more of their time rather than skipping the mesh, and the mechanism is a hypothesis with a test, not a measurement.</p>
<ul>
<li><b>What differed in the setup.</b> The table lists every difference between the two boots that Jesse's README names, and what was the same [Jesse's F1 README, Core rows against round three; Jesse's run 3 README, Platform facts].</li>
</ul>
{table(["Item", "Run 3 (membench-jibin-004)", "Boot F1 (membench-jibin-011)", "Can it move a core row?"], [
    ["Date, emulator boards", "2026-11-03, ga13pd02 boards 6 to 9", "2026-11-06, boards 18 to 21", "Same private image copy (membench-img-001); run-to-run noise only (section 4.8, boot A against run 3)"],
    ["SCP firmware (stages each cluster's L3 mode before its cores power on)", "0.48.0-nopcie.1: full L3 for cluster 0 only; the L3 of CPUs 2 to 9 snoop-filter-only, no lookup, no allocation", "0.48.0-nopcie-l3.1: full L3 for clusters 1 to 4 too; IMP_CLUSTERPWRSTAT_EL1 read 0x70 on CPU 2's cluster (not read on run 3)", "Yes: the one platform change. The register reading covers CPU 2's cluster only; clusters of CPUs 4 to 9 rest on the SCP's staging lines"],
    ["TF-A, kernel, OS image, device tree, huge pages, CPU layout", "TF-A 0.35.0, Linux 6.18.36, 256 huge pages of 2 MiB, CPUs 2 to 9 isolated, data prefetchers on", "the same files byte for byte (kernel Image sha256 equal)", "No"],
    ["cache-mem-perf commit and build", "ba834c0", "0c190a1 (five commits on b79dffa). chase: the same 34 instructions; k_read, k_write, k_copy byte for byte the same; pass and worker differ (new --asm-passes, --perf and CME paths). chase's 48 B loop sits inside one 64 B line on F1, across two on run 3", "The kernels are the same code. The pass and worker changes could move an L1-sized row by a few percent (the 16 KiB rows below). Boot E against boot C, one build, shows the read rise on its own"],
    ["Command lines", "run_asimov.sh and run_all.sh", "the same files byte for byte (sha256 equal): phases A, B, D and E are run 3's 67 command lines in the same order", "No"],
    ["Counter columns on the core latency rows", "cycles and L1, L2, L3 refills", "three more events (0x81BC, 0x81BD, 0x0111: the prefetch set, opened by default since the run 3 follow-up); the PMU has 21 counters, so nothing is multiplexed", "No (perf_cov 1.0000 on every row)"],
    ["/dev/ocm module", "an earlier build, no map lines, no clusterpwrstat file", "asimov-os 89cfd32's build: the same 4 KiB mapping, plus debug map lines and the clusterpwrstat file", "OCM rows only, through page placement"],
    ["Physical page placement", "unknown (no map lines)", "printed for each OCM process", "Each command is its own process on both boots, so its buffers need not sit on the same physical pages. The sparse OCM rows spread up to 60 % between passes inside one boot"],
    ["What ran before the core rows", "run_all.sh started directly", "the box's wrapper ran cme_test once on CPU 2 (about 0.012 s, exit 0), then run_all.sh; CPU 3 was online and idle during cme_test and went offline after the sysinfo step on both boots", "No: cme_test finished before any row, and both scripts ran on CPU 2 under SCHED_FIFO 10 (a fixed real-time priority) with RT throttling off"],
    ["Extra commands", "100 commands, 2.918 s of chip time", f"{F1['commands']} commands, {F1['chip_s']:.3f} s: run_cme.sh adds 37 CME commands after the core phases", "No: they ran after phases A to E"],
], note="Every cell is quoted from Jesse's two README files; nothing in this table is measured by this page.")}
<ul>
<li><b>How the commands ran.</b> With the folder names and the clock stamps set aside, F1's log.txt equals run 3's except for the 39 lines run_cme.sh adds, by diff. Under the mesh counters (which run for each whole command, chain build, flushes and unmap included), F1's core latency commands lived longer: the four counted 4 KiB controls {min(ctl_life):.2f} to {max(ctl_life):.2f} times run 3's lifetime, the 20 sparse OCM rows 1.24 to 1.60 times, while the counted 2 MiB read lived {life_ratio:.3f} times. These files do not show which part of each command grew; the timed passes inside them repeated run 3 (the controls) or got faster (the read) [cmn-counts.csv of 011 and 004; Jesse's F1 README, Mesh counts].</li>
<li><b>What moved.</b> The figure puts every row of the two boots into {len(groups)} groups and shows each group's lowest and highest speed ratio. A dot at 1.0 is a row that repeated run 3.</li>
</ul>
{fig(f_ratio, f"Every stream of independent reads got faster on F1, by {min(rd1):.2f} to {max(rd1):.2f} times for one core and up to {max(ratio('One core per cluster, 2 and 16 MiB: read')):.2f} times for four cores on four clusters; the L3-sized chains got faster (the L3 now serves them); every write, every control and every chain beyond the L3 repeated run 3.",
      f"Speed ratio of boot F1 over run 3 per row (latency rows: run 3's ns over F1's; bandwidth rows: F1's GB/s over run 3's), the lowest and the highest row of each group, best rows [the CSV files of 011 and 004]. The grid line at 1.0 is no change.")}
{t_ratio}
<ul>
<li><b>What the counters say about the L3-sized chains.</b> At 192 to 384 KiB the L2 refills per load are the same on both boots ({min(l2_3):.2f} to {max(l2_3):.2f} on run 3, {min(l2_1):.2f} to {max(l2_1):.2f} on F1), and the L3 read refills from outside the cluster (event 0xA2: a line that the L3 had to fetch from the mesh) fall from {min(a2_3):.2f} to {max(a2_3):.2f} per load to {min(a2_1):.2f} to {max(a2_1):.2f}. So the L2's misses are served inside the cluster on F1. That is the L3 holding the chain, a measurement [latency-dram-small.csv of 011 and 004].</li>
<li><b>What the counters say about the read streams.</b> Boot E against boot C (one build, the L3 the one change) read {e_over_c[2097152]:.2f} times at 2 MiB and {e_over_c[33554432]:.2f} at 32 MiB with the same refills per line (32 MiB: L1 {e32['l1d_refill']:.2f} and {c32['l1d_refill']:.2f}, L2 {e32['l2d_refill']:.2f} and {c32['l2d_refill']:.2f}, L2 refills caused by the L1 prefetcher {e32['l2d_refill_l1dhwprf']:.2f} and {c32['l2d_refill_l1dhwprf']:.2f}, L3 read refills {e32['l3d_refill_rd']:.4f} and {c32['l3d_refill_rd']:.4f}). On F1 the counted 2 MiB read put {req_ratio:.3f} times run 3's requests on the five home nodes while the command lived {life_ratio:.3f} times as long. So the L3 did not take these reads off the mesh: the same lines were fetched, by the same number of requests, in less time [bandwidth-read-prefetch.csv of 010 and 007; cmn-counts.csv of 011 and 004].</li>
<li><b>What the counters say about the OCM rows.</b> The sparse OCM passes count {statistics.mean(sp_a2_3):.2f} 0xA2 refills per load on run 3 and {statistics.mean(sp_a2_1):.2f} on F1 (means over the 140 passes of each boot), with the same L2 refills ({statistics.mean(sp_l2_3):.2f} and {statistics.mean(sp_l2_1):.2f}). So on F1 part of the OCM lines came from the L3, not from the region's home node. OCM is Normal write-back memory, so the L3 may hold its lines [latency-ocm-region&lt;r&gt;-cpu&lt;c&gt;.csv of 011 and 004].</li>
<li><b>What the multi-core rows add.</b> Four readers on four clusters each keep {per4[0] * 100:.0f} to {per4[1] * 100:.0f} % of F1's one-core rate at 16 MiB ({rd4['tmin']:.1f} to {rd4['tmax']:.1f} GB/s against {ONE1[33554432]['read']:.1f}), so four clusters do not share the limit. Eight readers, two per cluster, read {rd8['agg']:.1f} GB/s together, {rd8['agg'] / 8:.1f} each, so two readers in one cluster share about {rd8['agg'] / 4:.0f} GB/s est. per cluster, near one reader's rate [bandwidth-perdsu.csv, bandwidth-all8.csv of 011].</li>
</ul>
<ul>
<li><b>Hypotheses.</b> Each one names what supports it, what it has to explain, and the measurement that would confirm or reject it.</li>
<li>{hyp(" More reads in flight per cluster.")} With the L3 in full mode the cluster's miss handling goes through the L3 (the snoop-filter-only mode of run 3 passes every L2 miss to the mesh without an L3 lookup). If that path keeps more read requests open at once (in flight: issued and not yet returned), a stream of independent reads overlaps more of its DRAM time, while a chain of dependent loads has one load open and gains nothing, and a store stream is posted (the core does not wait for a store) and already overlaps. Fits: the same refills per line, the same mesh requests, chains beyond the L3 within 4 %, the one-core writes and the placement rows within 0.3 % (the multi-core writes of 2 MiB and above within 7 %), and the per-cluster limit the eight-reader row shows. The test: a count of the requests in flight at the DSU's mesh port around the same one-core read on an L3-on and an L3-off boot, if the mesh PMU offers such an event (to be checked in the CMN-S3 event list). The data on disk do not count requests in flight.</li>
<li>{hyp(" The prefetcher's requests are the ones that overlap more.")} The L2 refills caused by the L1 prefetcher are {e32['l2d_refill_l1dhwprf']:.2f} per line on E and {c32['l2d_refill_l1dhwprf']:.2f} on C, so the prefetcher issues the same number of requests per line on both; the counters do not say how many it keeps open at once. With the prefetchers off and the L3 off, boots B and D read {bd32[0]:.2f} and {bd32[1]:.2f} GB/s at 32 MiB, one line per DRAM latency. The test: run 3's one-core read lines with the prefetchers off on an L3-on boot (boot F2's firmware, which ran run_cme.sh only). A rate near {bd32[0]:.1f} GB/s would say the rise needs the prefetcher; a rate above it would say the L3 path overlaps demand misses on its own.</li>
<li>{hyp(" A per-cluster limit, not a per-core one.")} Four readers on four clusters scale one for one with one reader, and eight readers (two per cluster) get {rd8['agg'] / 4:.0f} GB/s est. per cluster. The test: two readers on two clusters against two readers in one cluster at 16 MiB, the same command otherwise; the pair row at 160 KiB ({M1[('read', 163840, 2)]['agg']:.1f} GB/s on F1 against {m3('read', 163840, 2):.1f} on run 3) is the nearest row on disk and sits in the L2 and L3, not DRAM.</li>
<li><span class="gap">ruled out</span> <b>The build.</b> k_read, k_write and k_copy are byte for byte the same in both builds, and boot E against boot C, one build, shows the read rise ({e_over_c[2097152]:.2f} and {e_over_c[33554432]:.2f} times) with the L3 as the one change. What the build may have moved: the 16 KiB rows, whose buffers fit the L1 (one core read {ratio('One core, 16 KiB: read, write, copy')[0]:.3f} times, write {ratio('One core, 16 KiB: read, write, copy')[1]:.3f}, the pair read {ratio('Pair (CPUs 2, 3), 16 KiB: read, write, copy')[0]:.3f}); run 3's README tied its own 16 KiB write shift to a rebuilt bandwidth, and pass differs again. Insufficient data: these files do not show why the 16 KiB rows moved [Jesse's F1 README, Core rows against round three; Jesse's run 3 README].</li>
<li><span class="gap">ruled out</span> <b>Boards or run-to-run noise.</b> The controls repeat within 0.3 %, the writes from 48 KiB on within {max(abs(x - 1) for x in wr1) * 100:.1f} %, the chains from 1.5 MiB on within {max(abs(x - 1) for x in ch) * 100:.1f} %, and the reps of the one-core read rows spread 1.8 % or less inside each boot. Boot E and boot C ran on other boards and show the same ratio.</li>
<li><span class="gap">partly</span> <b>Page placement on the OCM rows.</b> The /dev/ocm module differs and every process draws its own pages, so a single sparse cell (0.69 to 0.95 times) is within its own spread (up to 60 % between passes of one row). What placement cannot explain: all 20 cells faster, and the 0xA2 fall with the same L2 refills, which says the L3 served part of the loads. The test: the sparse rows with the L3 hit event (the hit set of boot E, section 5) on an L3-on boot.</li>
</ul>
"""
def level_cell(d):
    name = d["level"]
    if d["hit"] and d["size"] in L3_SIZES3: name += f"; {100 * d['hit']['l3_hit']:.0f} % L3 hits"
    return name

def core_page():
    # ---------------------------------------------------------------- 4.1 latency by level
    t1 = table(["Footprint", "Chase", "Boot E ns (L3 on)", "Run 3 ns (L3 off)", "Boot C ns (L3 off)", "E vs run 3", "E / C", "L1 refills", "L2 refills", "L3 read refills", "L3 read hits (hit set)", "Reads from (boot E)"],
               [[kib(d["size"]), d["kind"], fmt(d["ns"], 3), fmt(d["ns3"], 3), fmt(d["nsC"], 3), pct(d["ns"], d["ns3"]) if d["ns3"] else "-", f"{d['ratio']:.3f}",
                 fmt(d["e"]["l1d_refill"], 2), fmt(d["e"]["l2d_refill"], 2), fmt(d["e"]["l3d_refill_rd"], 2), fmt(d["hit"]["l3_hit"], 3) if d["hit"] else "-", level_cell(d)] for d in p.LEVELS],
               f"CPU 2, ns per load of the best pass with that pass's refills per load [latency-dram-small.csv, latency-dram-large.csv, latency-dram-flushed.csv, latency-dram-seq.csv of membench-jibin-010 (boot E), 004 (run 3) and 007 (boot C)]. "
               f"E vs run 3 is (boot E minus run 3) over run 3. E / C is boot E's time over boot C's: the two boots share the commit and the build, so the ratio isolates the L3. "
               f"The L3 read hits column is the hit set's count per load on boot E (another process, latency-dram-small-l3.csv), given where that row exists. The hit set is a repeated chase, so at 512 KiB it walked a repeated list ({HIT[524288]['ns']:.3f} ns) while the level row walked a fresh one. "
               f"Run 3 has no sequential row. Boot E's rows carry an L3 that holds data. The run 3 and boot C rows were measured with the L3 holding no data, so their 192 to 384 KiB rows are L2 hits mixed with reads from the SLC across the mesh.")
    t1b = table(["Footprint", "Boot E ns", "Boot C ns", "E / C", "E: L2 read hits", "E: L3 read hits", "E: L3 read refills", "E: L3 hits, lowest to highest rep", "C: L3 read hits"],
                [[kib(h["size"]), fmt(h["ns"], 3), fmt(h["nsC"], 3), f"{h['ns'] / h['nsC']:.3f}", fmt(h["l2_hit"], 4), fmt(h["l3_hit"], 4), fmt(h["l3_refill"], 4), f"{h['hit_rng'][0]:.4f} to {h['hit_rng'][1]:.4f}", fmt(h["hitC"], 4)] for h in p.HITSET],
                f"The L3 hit set: CPU 2 with CPU 3 offline, the repeated chase, best of 3 reps with that rep's counts per load [latency-dram-small-l3.csv of 010 and 007]. 0x81C5 L2 read hits, 0x81C6 L3 read hits, 0xA2 L3 read refills (lines filled from outside the cluster). "
                f"On boot E, L3 read accesses (0xA0) equal L3 read refills plus L3 read hits within {r4.E_L3['acc_minus_refill_minus_hit']:.4f} per load on every row. On boot C the hits read {r4.C_L3['hit_max']:.4f} in every row.")
    # ---------------------------------------------------------------- 4.2 OCM by region
    def rcell(d):
        return [p.cell_label(d["cpu"], d["region"]), f"{fmt(d['E']['best'], 2)} <span class='d'>(med {fmt(d['E']['median'], 2)})</span>", fmt(d["E"]["l3"], 3), fmt(d["E"]["pf"], 2),
                fmt(d["A"]["best"], 2), fmt(d["A"]["l3"], 3), fmt(d["C"]["best"], 2), fmt(d["B"]["best"], 2), fmt(d["run3_sparse"], 2), fmt(d["run2_dense"], 2), fmt(d["E_dense"], 2) if d["E_dense"] is not None else "-"]
    t2 = table(["Cell (distance)", "Boot E route, ns", "E: L3 read refills per load", "E: L2 prefetch refills per load", "Boot A route, ns (L3 off)", "A: L3 read refills per load", "Boot C route, ns", "Boot B route, ns (prefetchers off)", "Run 3 sparse, ns", "Boot F1 sparse, ns (L3 on, run 6)", "F1: L3 read refills per load", "Run 2 dense, ns", "Boot E dense (G2), ns"],
               [rcell(d)[:9] + [fmt(K1["OCM"][d["cpu"]][d["region"]]["best"], 3), fmt(K1["OCM"][d["cpu"]][d["region"]]["l3"], 2)] + rcell(d)[9:] for d in p.ROUTES],
               f"ns per load, best of 2 timed passes, with the median in brackets for boot E. A route row is the dense chase of one 256 KiB region (4,096 loads per pass) run under the mesh's crosspoint counters [latency-ocm-region&lt;r&gt;-route-cpu&lt;c&gt;.csv of 010, 005, 007 and 006]. "
               f"The refill columns are means over the two passes: 0xA2 L3 read refills (lines filled from outside the cluster) and 0x81BD L2 refills made by the hardware prefetchers. "
               f"Run 3's rows are its sparse chains (7 passes of 64 loads) and run 2's its dense chains, from their own files [latency-ocm-region&lt;r&gt;-cpu&lt;c&gt;.csv of 004 and 002]. The last column is boot E's dense chase of the same cell without the counters (CPUs 2 and 8 only). "
               f"Run 6 boot F1 repeated run 3's sparse rows from all four CPUs with the L3 on (the two F1 columns, best of 7 passes and the L3 read refills per load as the pass mean) [latency-ocm-region&lt;r&gt;-cpu&lt;c&gt;.csv of 011]: only {min(K1['OCM'][c][r]['l3'] for c in K1['OCM'] for r in range(5)):.2f} to {max(K1['OCM'][c][r]['l3'] for c in K1['OCM'] for r in range(5)):.2f} of their loads are read from the mesh (0xA2 per load); the rest are filled inside the cluster, by the L3 on this page's reading (hypothesis: these rows count no L3 hit event), so these values are below the true OCM latency, as boot E's are. CPUs 4 and 6 have route rows on run 4 only.")
    t2b = table(["CPU (DSU)", "Boot E dense (L3 on)", "E: L3 read refills per load (mean of the passes)", "Boot E sparse", "Boot F1 dense (L3 on, run 6)", "F1: L3 read refills per load", "Boot F1 sparse", "Boot A dense (L3 off)", "Boot C dense", "Boot B dense (prefetchers off)", "Boot D dense", "Run 3 dense", "Run 3 sparse", "Run 2 dense"],
                [[f"CPU {c} (DSU {CPU_DSU[c]})", fmt(p.ALL5[c]["E"]["dense"], 3), fmt(p.ALL5_DENSE_L3[c], 4), fmt(p.ALL5[c]["E"]["sparse"], 3), fmt(K1["ALL5D"][c]["best"], 3), fmt(K1["ALL5D"][c]["l3_mean"], 4), fmt(K1["ALL5S"][c]["best"], 3), fmt(p.ALL5[c]["A"]["dense"], 3), fmt(p.ALL5[c]["C"]["dense"], 3), fmt(p.ALL5[c]["B"]["dense"], 3), fmt(p.ALL5[c]["D"]["dense"], 3),
                  fmt(p.ALL5[c]["run3"]["dense"], 3), fmt(p.ALL5[c]["run3"]["sparse"], 3), fmt(p.ALL5[c]["run2"]["dense"], 3)] for c in (2, 8)]
                + [[f"CPU {c} (DSU {CPU_DSU[c]}), run 3 and F1 only", "-", "-", "-", fmt(K1["ALL5D"][c]["best"], 3), fmt(K1["ALL5D"][c]["l3_mean"], 4), fmt(K1["ALL5S"][c]["best"], 3), "-", "-", "-", "-", fmt(p.ALL5_RUN3_ALL[c]["dense"], 3), fmt(p.ALL5_RUN3_ALL[c]["sparse"], 3), fmt(g.ALL5_2[c]["best"], 3)] for c in (4, 6)],
                f"The all-five chains, ns per load, best pass: dense is run 2's chain over all five regions (20,480 loads, 2 passes), sparse one line per page (320 loads, 7 passes) [latency-ocm-all5-dense-cpu&lt;c&gt;.csv, latency-ocm-all5-cpu&lt;c&gt;.csv of 010, 011, 005, 007, 006, 008, 004 and 002]. "
                f"The ns columns are the best pass. The refill columns are the mean over the dense row's 2 passes. The dense all-five row from CPU 2 is the OCM number to quote: on boot E it keeps {p.ALL5_DENSE_L3[2]:.4f} L3 read refills per load (one fill from outside the cluster per load), so none of its loads is an L3 hit; run 6 boot F1 repeats it from all four CPUs ({min(K1['ALL5D'][c]['best'] for c in K1['ALL5D']):.2f} to {max(K1['ALL5D'][c]['best'] for c in K1['ALL5D']):.2f} ns, {min(K1['ALL5D'][c]['l3_mean'] for c in K1['ALL5D']):.4f} to {max(K1['ALL5D'][c]['l3_mean'] for c in K1['ALL5D']):.4f} L3 read refills per load).")
    t2c = table(["Distance (crosspoints)", "Cells", "Boot E route, mean ns", "Boot E range ns", "Boot A route, mean ns", "Boot A range ns", "Boot B route, mean ns", "Boot B range ns"],
                [[k, len(v)] + [x for b in "EAB" for x in (fmt(statistics.mean(d[b]["best"] for d in v), 2), f"{fmt(min(d[b]['best'] for d in v), 2)} to {fmt(max(d[b]['best'] for d in v), 2)}")] for k, v in sorted(ROUTE_BY_DIST.items())],
                f"The 20 route cells grouped by the assumed step count (|dx| + |dy| between the DSU's and the node's crosspoints). A range spans different cells, not repeats of one cell. The two cells at 5 crosspoints are both from CPU 8.")
    # ---------------------------------------------------------------- 4.3 one-core bandwidth by footprint
    def e_read(s):
        if s in p.RP_SIZES: return fmt(E_PLAIN[s], 2)
        return fmt(G8R[("per-pass", "read", s)]["agg"]["E"], 2) if ("per-pass", "read", s) in G8R else "-"
    def c_read(s):
        if s in p.RP_SIZES: return fmt(C_PLAIN[s], 2)
        return fmt(G8R[("per-pass", "read", s)]["agg"]["C"], 2) if ("per-pass", "read", s) in G8R else "-"
    def e_write(s): return fmt(WS[s]["agg"]["E"], 2) if s in WS else "-"
    t3 = table(["Buffer", "Boot F1 read GB/s (L3 on, run 6)", "Boot F1 write", "Boot F1 copy", "Run 3 read GB/s (L3 off)", "Run 3 write", "Run 3 copy", "Boot E read (L3 on)", "Boot C read (L3 off)", "Boot E write (run 3's program)", "Capacity reading, boot F1 and E (L3 on)", "Capacity reading, run 3 (L3 off): read and write; copy"],
               [[kib(d["size"]), fmt(ONE1[d["size"]]["read"]), fmt(ONE1[d["size"]]["write"]), fmt(ONE1[d["size"]]["copy"]), fmt(d["read"]), fmt(d["write"]), fmt(d["copy"]), e_read(d["size"]), c_read(d["size"]), e_write(d["size"]), p.bw_level_e(d["size"]), f"{g.bw_level(d['size'])}; {g.bw_level(2 * d['size'])}"] for d in g.ONE],
               f"One thread on CPU 2, best of 3 reps, GB = 1e9 bytes. Run 6 boot F1 ran run 3's one-core sweep with the L3 on [bandwidth-dram-1core.csv of 011]; run 3 measured with the L3 holding no data [bandwidth-dram-1core.csv of 004]. Copy reads one buffer and writes another of the same size, so its working set is twice the buffer size, and it counts bytes read plus written. "
               f"The boot E and C columns give the run 4 rows with the same kernel and buffer. The 16 KiB read is the G8 looped form (one call per pass) [bandwidth-l1-passes.csv of 010 and 007]. The 2 MiB and 32 MiB reads are the plain loop of the read variants [bandwidth-read-prefetch.csv of 010 and 007]. The writes are run 3's program on boot E at run 3's pass counts [bandwidth-write-small.csv of 010]. "
               f"With the L3 on the reads from 48 KiB up rise to {min(ONE1[s]['read'] for s in ONE1 if s >= 49152):.1f} to {max(ONE1[s]['read'] for s in ONE1 if s >= 49152):.1f} GB/s ({min(ONE1[s]['read'] / ONE[s]['read'] for s in ONE1 if s >= 49152):.2f} to {max(ONE1[s]['read'] / ONE[s]['read'] for s in ONE1 if s >= 49152):.2f} times run 3's), the writes stay at {min(ONE1[s]['write'] for s in ONE1):.1f} to {max(ONE1[s]['write'] for s in ONE1):.1f} GB/s, and copy follows the reads. The capacity readings are hypotheses: no bandwidth row carries counters that say which level served it.")
    g8w = {x: p.G8_FITS[(x, "per-pass", "write")] for x in "CE"}
    t3_notes = f"""<ul>
<li><b>The write rows are the full width of the core's write path.</b> The C1-Nano has one 128-bit write path from the core to its L1 memory system [Arm C1-Nano TRM, "Write path"]. That is 16 bytes per cycle. The latency rows put the core at {CORE_GHZ:.1f} GHz ({g._p4k['cyc']:.2f} cycles per {g._p4k['ns']:.3f} ns at 4 KiB), so the path carries {WRITE_PATH:.1f} GB/s. Every run 3 write row from 2 MiB to 32 MiB reads {min(d['write'] for d in g.ONE if d['size'] >= 2097152):.2f} to {max(d['write'] for d in g.ONE):.2f} GB/s. So the store stream runs at the path's width at every footprint, DRAM included, and the memory behind it is not the limit for one core. The G8 write rows of boots C and E fit the same path: {min(v['rate'] for (x, f, k), v in p.G8_FITS.items() if k == 'write'):.1f} to {max(v['rate'] for (x, f, k), v in p.G8_FITS.items() if k == 'write'):.1f} GB/s (section 7).</li>
<li><b>The rows below 2 MiB fall short of the path's width because of the test program, not the core.</b> Each pass of the store kernel carries a fixed cost: the G8 write fits measure it at {g8w['C']['a_ns']:.1f} ns (boot C) and {g8w['E']['a_ns']:.1f} ns (boot E) per pass with one call per pass, and {p.G8_FITS[('C', 'asm', 'write')]['a_ns']:.1f} and {p.G8_FITS[('E', 'asm', 'write')]['a_ns']:.1f} ns with every pass inside one assembly call [bandwidth-l1-passes.csv, bandwidth-l1-asmpasses.csv of 007 and 010]. A 16 KiB pass lasts {WS[16384]['ns_pass']['E']:.0f} ns on boot E, so that cost is {100 * g8w['E']['a_ns'] / WS[16384]['ns_pass']['E']:.0f} % of it and the row reads {WS[16384]['agg']['E']:.1f} GB/s. A 2 MiB pass lasts {2097152 / ONE[2097152]['write'] / 1000:.0f} us, where the cost is below 0.05 %. The same per-pass cost shapes the copy rows.</li>
<li><b>The read rows are not at the path's width.</b> The read path is dual 128-bit, 32 bytes per cycle or {READ_PATH:.1f} GB/s. Run 3's 16 KiB row, in L1, reads {ONE[16384]['read']:.1f} GB/s ({100 * ONE[16384]['read'] / READ_PATH:.0f} % of the path). The G8 rows of boots C and E show that the shortfall is a cost per pass of the loop, not the L1's rate (section 7). Every larger row is set by the level that serves it: run 3 read {ONE[33554432]['read']:.1f} GB/s from DRAM with the L3 off, and boot E reads {E_PLAIN[33554432]:.1f} GB/s with it on (boot C, same build, L3 off: {C_PLAIN[33554432]:.1f}).</li>
</ul>"""
    # ---------------------------------------------------------------- 4.4 to 4.6: run 3 only
    def one_ref(kernel, size):
        """the run 3 one-core row of the same kernel at the same per-thread buffer, else at the nearest larger one-core footprint"""
        exact = [d for d in g.ONE if d["size"] == size]
        d = exact[0] if exact else min((d for d in g.ONE if d["size"] > size), key=lambda d: d["size"])
        return d[kernel], d["size"]
    def ratio_cell(d):
        v, ref = one_ref(d["kernel"], d["size"])
        return f"{d['run3'] / v:.2f}x" + ("" if ref == d["size"] else f" <span class='d'>(one core at {kib(ref)})</span>")
    def per_core_cell(d):
        v, ref = one_ref(d["kernel"], d["size"])
        return f"{100 * d['run3'] / d['threads'] / v:.0f} %"
    def f1_per_core(d):
        """F1's aggregate per thread as a share of F1's one-core rate of the same kernel at the same (or the nearest larger) per-thread buffer"""
        exact = [s for s in ONE1 if s == d["size"]]; ref = exact[0] if exact else min(s for s in ONE1 if s > d["size"])
        return f"{100 * _m3(d) / d['threads'] / ONE1[ref][d['kernel']]:.0f} %"
    def mrows(rows, label): return [[label, d["kernel"], d["threads"], kib(d["size"]), fmt(_m3(d)), fmt(d["run3"]), pct(_m3(d), d["run3"]), f1_per_core(d), fmt(d["run2"]), ratio_cell(d), per_core_cell(d)] for d in rows]
    t4 = table(["Cores", "Kernel", "Threads", "Per thread", "Boot F1 GB/s (L3 on, run 6)", "Run 3 GB/s (L3 off)", "F1 vs run 3", "Per core, of F1's one-core rate", "Run 2 GB/s", "Run 3 / one core", "Per core, of run 3's one-core rate"], mrows(g.PAIR, "CPU 2 + 3 (one DSU)") + mrows(g.PERDSU, "CPUs 2, 4, 6, 8") + mrows(g.ALL8, "CPUs 2 to 9"),
               f"Run 6 boot F1 (the L3 on) and run 3 (the L3 off), the same command lines [bandwidth-pair.csv, bandwidth-perdsu.csv, bandwidth-all8.csv of 011, 004 and 002]. Best of 3 reps. Aggregate = total bytes over the slowest thread's time [bandwidth-pair.csv, bandwidth-perdsu.csv, bandwidth-all8.csv of 004 and 002]. Both runs on the same firmware. \"Run 3 / one core\" divides the run 3 aggregate by the run 3 one-core bandwidth of the same kernel at the same per-thread buffer (table 4.3); where no one-core row has that size (160 KiB, 16 MiB) the nearest larger one-core footprint is used and named, which serves from the same level. \"Per core, of one-core rate\" is the same ratio divided by the thread count: the share of its one-core rate each core kept. 100 % means the cores add up without interfering. Less means they share a limit.")
    _r4 = [d for d in g.PERDSU if d["kernel"] == "read" and d["size"] == 2097152][0]; _w4 = [d for d in g.PERDSU if d["kernel"] == "write" and d["size"] == 2097152][0]
    _r8 = [d for d in g.ALL8 if d["kernel"] == "read" and d["size"] == 2097152][0]; _one2m = ONE[2097152]
    t4_note = f"""<ul>
<li><b>Why the four-DSU rows keep 100 % on write but {per_core_cell(_r4)} on read (run 3, the L3 off).</b> The two streams hit different limits. A store stream is pinned at the core's own write path, {WRITE_PATH:.1f} GB/s, whatever is behind it: the four writers read {_w4['tmin']:.3f} to {_w4['tmax']:.3f} GB/s each, and 4 times {WRITE_PATH:.0f} is below the DRAM write ceiling that eight writers reach (table 4.4, {max(d['run3'] for d in g.ALL8 if d['kernel'] == 'write'):.0f} GB/s), so nothing shared is saturated. A read stream beyond L2 is bound by latency (a fixed number of lines in flight per core), and the aggregate is defined by the slowest thread: the four readers read {_r4['tmin']:.2f} to {_r4['tmax']:.2f} GB/s each against {_one2m['read']:.2f} for one core alone, so the fastest reader kept {100 * _r4['tmax'] / _one2m['read']:.1f} % of the one-core rate and the slowest {100 * _r4['tmin'] / _one2m['read']:.0f} %. The spread is a per-core property, not interference: with eight readers the per-thread range is {_r8['tmin']:.2f} to {_r8['tmax']:.2f} GB/s, nearly the same, and the aggregate doubles. {hyp(f" The slowest reader is the core farthest from the home nodes: the 2 MiB chase reads {g.SLC[2]['best']:.1f}, {g.SLC[4]['best']:.1f}, {g.SLC[6]['best']:.1f} and {g.SLC[8]['best']:.1f} ns from CPUs 2, 4, 6 and 8 on run 3, an {100 * (g.SLC[8]['best'] / g.SLC[2]['best'] - 1):.0f} % spread that matches the {100 * (_r4['tmax'] / _r4['tmin'] - 1):.0f} % spread in read rate. The program does not record which thread was slowest.")}</li>
<li><b>Where write loses instead.</b> In two groups of rows write keeps less than read: two writers in one DSU at 160 KiB, and eight writers at any size. There the writers share one path. For the pair it is the DSU's one mesh port. For the eight it is the DRAM write ceiling (section 8). A write stream is {WRITE_PATH:.0f} GB/s per core and a read stream beyond L2 was {min(d['read'] for d in g.ONE if d['size'] >= 2097152):.1f} to {max(d['read'] for d in g.ONE if d['size'] >= 2097152):.1f} GB/s on run 3. So writers fill a shared path about three times sooner than readers do. With the L3 on, one core reads {ONE1[33554432]['read']:.1f} GB/s from DRAM (section 7). Run 6 boot F1 ran these rows with the L3 on: the four-DSU readers rise from {_rd(4, 2097152)['run3']:.1f} to {_m3(_rd(4, 2097152)):.1f} GB/s at 2 MiB, the eight readers from {_rd(8, 2097152)['run3']:.1f} to {_m3(_rd(8, 2097152)):.1f}, and the write rows of 2 MiB and above stay within {max(abs(_m3(d) / d['run3'] - 1) * 100 for d in g.PAIR + g.PERDSU + g.ALL8 if d['kernel'] == 'write' and d['size'] >= 2097152):.1f} % (the F1 column above).</li>
</ul>"""
    t4b = table(["Writers (CPUs)", "DSUs used", "Boot F1 GB/s (L3 on, run 6)", "Run 3 GB/s (L3 off)", "F1 vs run 3", "Run 2 GB/s", "Per writer, F1"],
                [[q["cpus"].replace("-", ", "), ", ".join(str(d) for d in q["dsus"]), fmt(PLACE1[q["cpus"]]["agg"]), fmt(q["run3"]), pct(PLACE1[q["cpus"]]["agg"], q["run3"]), fmt(q["run2"]), f"{fmt(PLACE1[q['cpus']]['tmin'])} to {fmt(PLACE1[q['cpus']]['tmax'])}"] for q in g.PLACE],
                f"16 MiB per writer, one pass, best of 2 reps [bandwidth-write-cpus*.csv of 011, 004 and 002]. The six rows repeat within {max(abs(PLACE1[q['cpus']]['agg'] / q['run3'] - 1) * 100 for q in g.PLACE):.2f} % between run 3 and boot F1: the L3 does not change a write stream.")
    t5 = table(["Row", "Boot F1 GB/s (L3 on, run 6)", "Run 3 GB/s (L3 off)", "F1 vs run 3", "Run 2 GB/s", "Note"],
               [[f"Read OCM{r} from CPU 2 ({dist(2, NODE_OF_REGION[r])} xp)", fmt(OCMBW1["region"][r]), fmt(g.OCMBW["region"][r]), pct(OCMBW1["region"][r], g.OCMBW["region"][r]), fmt(g.OCMBW["region2"][r]), "256 KiB, flushed before, one pass"] for r in range(5)]
               + [["Read all five from CPU 2", fmt(OCMBW1["all5"]), fmt(g.OCMBW["all5"]), pct(OCMBW1["all5"], g.OCMBW["all5"]), fmt(g.OCMBW["all5_2"]), "1.25 MiB, flushed before, one pass"],
                  ["Read OCM1 to 4 from CPUs 2, 4, 6, 8", fmt(OCMBW1["four"]), fmt(g.OCMBW["four"]), pct(OCMBW1["four"], g.OCMBW["four"]), fmt(g.OCMBW["four2"]), "4 threads, one region each"],
                  ["Streaming write, all five, from CPU 2", fmt(OCMBW1["write"]), fmt(g.OCMBW["write"]), pct(OCMBW1["write"], g.OCMBW["write"]), fmt(g.OCMBW["write2"]), "8 passes over 1.25 MiB"]],
               f"Best of 3 reps [bandwidth-ocm-*.csv of 011, 004 and 002]. With the L3 on one core reads an OCM region at {min(OCMBW1['region']):.1f} to {max(OCMBW1['region']):.1f} GB/s, the same at every distance, against {min(g.OCMBW['region']):.1f} to {max(g.OCMBW['region']):.1f} with the L3 off; the streaming write does not move.")
    def _lvrow(size):
        e_r = fmt(E_PLAIN[size], 1) if size in p.RP_SIZES else fmt(G8R[("per-pass", "read", size)]["agg"]["E"], 1) if ("per-pass", "read", size) in G8R else "-"
        return [g.bw_level(size), f"{kib(size)} DRAM-address buffer, warm, {g._passes_one(size)} passes", fmt(ONE1[size]["read"]), fmt(ONE1[size]["write"]), fmt(ONE[size]["read"]), fmt(ONE[size]["write"]), e_r]
    t5b = table(["Level (capacity reading, hypothesis; run 3, L3 off)", "Row (one core, CPU 2)", "Boot F1 read GB/s (L3 on, run 6)", "Boot F1 write", "Run 3 read GB/s (L3 off)", "Run 3 write", "Boot E read GB/s (L3 on)"],
                [["Core, its own load and store paths", f"not a measured row: the TRM's dual 128-bit read path and single 128-bit write path at the {CORE_GHZ:.1f} GHz the latency rows show", f"{READ_PATH:.1f}", f"{WRITE_PATH:.1f}", f"{READ_PATH:.1f}", f"{WRITE_PATH:.1f}", "-"],
                 _lvrow(16384), _lvrow(49152), _lvrow(98304), _lvrow(262144), _lvrow(2097152),
                 ["OCM, one home node", "256 KiB, one region, flushed before, one pass; the five regions", f"{min(OCMBW1['region']):.1f} to {max(OCMBW1['region']):.1f}", "-", f"{min(g.OCMBW['region']):.1f} to {max(g.OCMBW['region']):.1f}", "-", "-"],
                 ["OCM, the five home nodes", "1.25 MiB, all five regions, flushed before; read one pass, write 8 passes", fmt(OCMBW1["all5"]), fmt(OCMBW1["write"]), fmt(g.OCMBW["all5"]), fmt(g.OCMBW["write"]), "-"],
                 _lvrow(33554432)],
                f"The boot F1 columns are {F1_LABEL} and the run 3 columns {RUN3_LABEL}, the same command lines: best of 3 reps, GB = 1e9 bytes. The first row is the core's own limit, computed from the Arm C1-Nano TRM's path widths (\"Read path: dual 128-bit\", \"Write path: 128-bit\") and the measured clock, not a bandwidth row. The level is read from the capacities, a hypothesis: no bandwidth row carries counters that say which level served it. "
                f"The DRAM-address rows are table 4.3's (many warm passes over one buffer). The OCM rows are table 4.6's (the buffer flushed from the core caches before the timed passes), so the two methods differ. "
                f"The boot E column gives the rows run 4 repeated with the L3 on: the 16 KiB G8 per-pass read and the plain 2 MiB and 32 MiB reads [bandwidth-l1-passes.csv, bandwidth-read-prefetch.csv of 010]. Run 6 boot F1 repeated the 256 KiB read row with the L3 on: {ONE1[262144]['read']:.1f} GB/s against run 3's {ONE[262144]['read']:.1f} [bandwidth-dram-1core.csv of 011]. Boot E's 256 KiB chase counts {lv(262144)['e']['l3d_refill_rd']:.2f} L3 read refills per load where run 3's counted {next(d['l3'] for d in g.LV4 if d['size'] == 262144):.2f}, so that row is read as an L3 row on the L3-on boots (a capacity reading: the bandwidth row carries no counters).")
    # ---------------------------------------------------------------- 4.7 attribution, 4.8 rows that moved
    t6 = table(["Row", "Own node, run 3", "Other four, mean", "Own / others", "Own node, boot F1 (L3 on, run 6)", "Own / others, F1", "Own node, run 2 (dense)", "Run 3 / run 2 own"],
               [[f"OCM{r} chain, CPU {c}", f"{g.ATTR[(c, r)]['own']:,}", f"{g.ATTR[(c, r)]['others_mean']:,.0f}", fmt(g.ATTR[(c, r)]["ratio"], 1), f"{ATTR1[(c, r)]['own']:,}", fmt(ATTR1[(c, r)]["ratio"], 1), f"{g.ATTR2[(c, r)]['own']:,}", fmt(g.ATTR[(c, r)]["own"] / g.ATTR2[(c, r)]["own"], 2)] for c in (2, 4, 6, 8) for r in range(5)],
               "Run 3, the L3 off, and run 6 boot F1, the L3 on (run 4 counted the crosspoints instead, section 11). Requests received per home node (hns_pocq_reqs_recvd_all) over the whole command [cmn-counts.csv of 011, 004 and 002]. A sparse row builds 8 chains, fills the region and flushes 7 times, so most of its requests are not the 448 timed loads.")
    t7 = table(["File", "Row", "Run 3 ns", "Boot E ns", "Boot E vs run 3"],
               [[d["file"], f"{kib(d['size'])} {d['mode'].replace('-best', '').replace('best', 'best')}", fmt(d["run3"], 3), fmt(d["run4"], 3), f"{d['pct']:+.2f} %"] for d in MOVED],
               f"Only the rows that moved 1 % or more are listed ({len(MOVED)} of {len(p.REPEAT_E3)}). The {len(p.REPEAT_E3)} rows are every best row that boot E and run 3 share by file name and footprint, core and CME, the round-trip controls set aside [the latency-*.csv and cme-latency-*.csv files of 010 and 004]. The CPU 2 control row is also set aside: run 3's latency-control-cpu2.csv holds {p.RUN3_CTRL2_BEST} best rows (one per command), so it has no single run 3 value. {p.N_WITHIN_E3[1]} are within 1 %, {p.N_WITHIN_E3[3]} within 3 % and {p.N_WITHIN_E3[5]} within 5 %. "
               f"The largest changes are the L3 rows (192 to 512 KiB) and the per-region OCM rows. Both are caused by the L3. The bandwidth files share no name between the two runs, so no bandwidth row is in this count. "
               f"Boot A against run 3, the same configuration (the L3 off, 4 KiB pages, prefetchers on), is the repeatability pair: of its {len(p.REPEAT_A3)} shared rows {p.N_WITHIN_A3[1]} are within 1 %, {p.N_WITHIN_A3[3]} within 3 % and {p.N_WITHIN_A3[5]} within 5 %, and the largest change is {p.REPEAT_A3[0]['pct']:+.2f} % ({p.REPEAT_A3[0]['file']}, {kib(p.REPEAT_A3[0]['size'])}) [asimov-c1nano-run4.html, section 3.9].")
    # ---------------------------------------------------------------- section 2 tables
    t12 = table(["Row"] + [f"Boot {x}" for x in p.BOOTS], [[lab] + [d[x] for x in p.BOOTS] for lab, d in p.FIVE],
                "Each row is the same command on every boot that has it [log.txt, latency-dram-small.csv, latency-dram-small-l3.csv, latency-dram-large.csv, latency-dram-seq.csv, bandwidth-read-prefetch.csv of 005 to 010]. The power status register is the box's two reads around the hit-set command, which cover CPU 2's cluster only [Jesse's boot E README, Coverage].")
    # ---------------------------------------------------------------- section 11: boot E route counters
    t10 = table(["Cell", "DSU crosspoint", "Data flits out of the DSU's crosspoint, boot E (e / w / n / s)", "Most at", "X-first would be", "Node crosspoint", "Data flits out of the node's crosspoint (e / w / n / s)", "Most at", "X-first would be", "Boot A: most at DSU, node"],
                [[p.cell_label(d["cpu"], d["region"]), f"{DSUS[CPU_DSU[d['cpu']]][0]},{DSUS[CPU_DSU[d['cpu']]][1]}", " / ".join(f"{d['E']['d_dsu'][k]:,}" for k in "ewns"), f"{d['E']['dom_dsu']} ({100 * d['E']['share_dsu']:.0f} %)", d["E"]["exp_dsu"],
                  f"{d['node']} ({NODES[d['node']][0]},{NODES[d['node']][1]})", " / ".join(f"{d['E']['d_node'][k]:,}" for k in "ewns"), f"{d['E']['dom_node']} ({100 * d['E']['share_node']:.0f} %)", d["E"]["exp_node"],
                  f"{d['A']['dom_dsu']} ({100 * d['A']['share_dsu']:.0f} %), {d['A']['dom_node']} ({100 * d['A']['share_node']:.0f} %)"] for d in p.ROUTES],
                f"Boot E's route rows: data flits transmitted in each direction over the whole command (the chain build, the flush, the passes and anything else on that crosspoint) [cmn-counts.csv of 010, labels route-ocm*-cpu*; boot A's from 005]. \"Most at\" is the direction with the most flits and its share of the four. \"X-first would be\" is the first link of a route that takes its X steps before its Y steps, from the two crosspoints' coordinates.")

    # ---------------------------------------------------------------- figures
    f_levels = line_chart([dict(name=f"run 3 ({p.RUN3['commit']}), the L3 off", color=g.C["muted"], pts=[(d["size"], d["ns3"], f"run 3 {kib(d['size'])} {d['kind']}: {d['ns3']:.3f} ns") for d in p.LEVELS if d["kind"] in ("repeat", "fresh")], short="run 3", dy=14),
                           dict(name=f"boot C ({p.PLATFORM['C']['commit']}), the L3 off", color=g.C["s3"], pts=[(d["size"], d["nsC"], f"boot C {kib(d['size'])} {d['kind']}: {d['nsC']:.3f} ns") for d in p.LEVELS if d["kind"] in ("repeat", "fresh")], short="boot C", dy=26, dash="5 4"),
                           dict(name=f"boot E ({p.PLATFORM['E']['commit']}), the L3 on", color=g.C["s1"], pts=[(d["size"], d["ns"], f"boot E {kib(d['size'])} {d['kind']}: {d['ns']:.3f} ns") for d in p.LEVELS if d["kind"] in ("repeat", "fresh")], short="boot E", dy=-8)],
                          marks=((32768, "L1 32 KiB"), (131072, "L2 128 KiB"), (262144, "L3 256 KiB (on, boot E)"), (SLC_BYTES, "SLC 3.75 MiB")), ylim=(0, 60), ticks_y=[0, 10, 20, 30, 40, 50, 60])
    hit_rows = []
    for s in (196608, 262144, 393216, 524288):
        for x in "CE":
            e = r4.EX[x]["l3"]["best"][s]["e"]
            hit_rows.append(dict(label=f"boot {x}, {kib(s)} ({r4.EX[x]['l3']['best'][s]['ns']:.1f} ns)", parts=[(e["l2d_hit_rd"], g.C["s1"], "L2 read hits (0x81C5)"), (e["l3d_hit_rd"], g.C["s3"], "L3 read hits (0x81C6)"), (e["l3d_refill_rd"], g.C["s2"], "L3 read refills from outside the cluster (0xA2)")]))
    f_hits = stacked_h(hit_rows, L=260, xlim=1.15)
    f_map = mesh_map(left=[("L1, 32 KiB per core", f"{lv(4096)['ns']:.1f} ns (4 KiB chase)", "#e9f1fb"),
                           ("L2, 128 KiB per DSU", f"{lv(131072)['ns']:.1f} ns (128 KiB chase)", "#e9f1fb"),
                           ("L3, 256 KiB per DSU (on, boot E)", f"hit about {L3_EST:.0f} ns est.; {HIT[196608]['ns']:.1f} ns at 192 KiB ({100 * HIT[196608]['l3_hit']:.0f} % hits)", "#e9f1fb"),
                           ("mesh: to the home node that owns the line", "the grid on the right; one step per crosspoint", "#f9f9f7"),
                           (["5 home nodes (HN-S)", "SLC 768 KiB each (12 ways), \"L4\" cache", "OCM 256 KiB each (4 ways), addressable SRAM"], f"{lv(2097152, 'fresh')['ns']:.1f} ns (2 MiB fresh chain, in the SLC)", "#fdeee6"),
                           ("DRAM, behind the home node (emulator)", f"{FLUSHED_E:.1f} ns (8 MiB flushed)", "#f1f1ee")],
                     node_labels={NODE_OF_REGION[r]: [f"CPU 2: {next(d for d in p.ROUTES if d['cpu'] == 2 and d['region'] == r)['E']['best']:.1f} ns"] for r in range(5)},
                     paths=[(1, NODE_OF_REGION[r], g.C["s2"], "") for r in range(5)])
    f_ocm = dumbbell([dict(label=p.cell_label(d["cpu"], d["region"]), a=d["A"]["best"], b=d["E"]["best"]) for d in p.ROUTES], names=("boot A route (L3 off)", "boot E route (L3 on)"), colors=(g.C["muted"], g.C["s1"]))
    f_sparse = dumbbell([dict(label=p.cell_label(d["cpu"], d["region"]), a=d["run3"]["best"], b=d["E"]["best"]) for d in p.OCM_SPARSE], names=("run 3 sparse (L3 off)", "boot E sparse (L3 on)"), colors=(g.C["muted"], g.C["s1"]))
    all5_names = [p.BOOT_SHORT[x] for x in "EACBD"] + ["run 3 (L3 off)"]; all5_cols = [p.BOOT_COL[x] for x in "EACBD"] + [g.C["ink2"]]
    f_all5 = dotplot([dict(label=f"CPU {c}: all five, {s} ({'20,480' if s == 'dense' else '320'} loads)", vals=[p.ALL5[c][x][s] for x in "EACBD"] + [p.ALL5[c]["run3"][s]]) for s in ("dense", "sparse") for c in (2, 8)],
                     all5_names, all5_cols, L=300, xlim=(24, 29))
    e_read_l1 = [(s, G8R[("per-pass", "read", s)]["agg"]["E"], f"boot E read {kib(s)} (G8 per-pass): {G8R[('per-pass', 'read', s)]['agg']['E']:.3f} GB/s") for s in p.G8_SIZES]
    e_read_dram = [(s, E_PLAIN[s], f"boot E plain read {kib(s)}: {E_PLAIN[s]:.3f} GB/s") for s in p.RP_SIZES]
    e_write_pts = [(s, G8R[("per-pass", "write", s)]["agg"]["E"], f"boot E write {kib(s)} (G8 per-pass): {G8R[('per-pass', 'write', s)]['agg']['E']:.3f} GB/s") for s in p.G8_SIZES] + [(d["size"], d["agg"]["E"], f"boot E write {kib(d['size'])} (run 3's program): {d['agg']['E']:.3f} GB/s") for d in p.WRITE_SMALL if d["size"] > 24576]
    f_bw1 = line_chart([dict(name="boot F1 read (L3 on, run 6)", color=g.C["s1"], pts=[(s, ONE1[s]["read"], f"boot F1 read {kib(s)}: {ONE1[s]['read']:.3f} GB/s") for s in sorted(ONE1)], short="F1 read", dy=-8),
                        dict(name="boot F1 write (L3 on, run 6)", color=g.C["s2"], pts=[(s, ONE1[s]["write"], f"boot F1 write {kib(s)}: {ONE1[s]['write']:.3f} GB/s") for s in sorted(ONE1)], short="F1 write", dy=-8),
                        dict(name="boot F1 copy, read + write bytes (L3 on, run 6)", color=g.C["s3"], pts=[(s, ONE1[s]["copy"], f"boot F1 copy {kib(s)}: {ONE1[s]['copy']:.3f} GB/s") for s in sorted(ONE1)], short="F1 copy", dy=-8),
                        dict(name="run 3 read (L3 off)", color=g.C["s1"], pts=[(d["size"], d["read"]) for d in g.ONE], dash="2 3", short="run 3 read", dy=14), dict(name="run 3 write (L3 off)", color=g.C["s2"], pts=[(d["size"], d["write"]) for d in g.ONE], dash="2 3", short=""),
                        dict(name="run 3 copy, read + write bytes (L3 off)", color=g.C["s3"], pts=[(d["size"], d["copy"]) for d in g.ONE], dash="2 3", short="run 3 copy", dy=14),
                        dict(name="boot E read (L3 on), G8 L1 rows", color=g.C["s7"], pts=e_read_l1, dash="5 4", short=""),
                        dict(name="boot E read (L3 on), plain loop", color=g.C["s7"], pts=e_read_dram, dash="5 4", short=""),
                        dict(name="boot E write (L3 on)", color=g.C["s4"], pts=e_write_pts, dash="5 4", short="")],
                       ylabel="GB/s, one thread on CPU 2 (solid: run 6 boot F1, the L3 on; dotted: run 3, the L3 off; dashed: boot E's rows)", marks=((32768, "L1 32 KiB"), (131072, "L2 128 KiB"), (262144, "L3 256 KiB (on)"), (SLC_BYTES, "SLC 3.75 MiB")), ylim=(0, 65), ticks_y=[0, 10, 20, 30, 40, 50, 60])
    f_read = dotplot([dict(label=f"{name}, {kib(s)}", vals=[RV[(k, s)]["agg"][x] for x in "EC"] + [RV[(k, s)]["run3"]]) for s in p.RP_SIZES for k, name in p.RP_KERNELS],
                     ["boot E (L3 on)", "boot C (L3 off)", "run 3 plain loop (L3 off)"], [g.C["s1"], g.C["s3"], g.C["muted"]], unit="GB/s", xlim=(0, 27))
    g8_names = [f"boot {x}, {f}" for x in "CE" for f in ("per-pass", "asm")]; g8_cols = [g.C["s3"], g.C["s7"], g.C["s1"], g.C["s2"]]
    f_g8 = dotplot([dict(label=f"{k}, {kib(s)}", vals=[G8R[(f, k, s)]["agg"][x] for x in "CE" for f in ("per-pass", "asm")]) for k in ("read", "write") for s in p.G8_SIZES], g8_names, g8_cols, unit="GB/s", xlim=(20, 66))
    wrows = [dict(label=f"{'CPU 2+3' if d['threads'] == 2 else 'CPUs 2,4,6,8' if d['threads'] == 4 else 'CPUs 2 to 9'} write {kib(d['size'])}", a=d["run3"], b=_m3(d)) for d in g.PAIR + g.PERDSU + g.ALL8 if d["kernel"] == "write"]
    wrows += [dict(label=f"writers {q['cpus'].replace('-', ',')} (DSUs {','.join(map(str, q['dsus']))})", a=q["run3"], b=PLACE1[q["cpus"]]["agg"]) for q in g.PLACE]
    f_write = dumbbell(wrows, unit="GB/s", names=("run 3 (L3 off)", "boot F1 (L3 on, run 6)"), colors=(g.C["muted"], g.C["s2"]))
    rrows = [dict(label=f"{'CPU 2+3' if d['threads'] == 2 else 'CPUs 2,4,6,8' if d['threads'] == 4 else 'CPUs 2 to 9'} {d['kernel']} {kib(d['size'])}", a=d["run3"], b=_m3(d)) for d in g.PAIR + g.PERDSU + g.ALL8 if d["kernel"] != "write"]
    f_multi = dumbbell(rrows, unit="GB/s", names=("run 3 (L3 off)", "boot F1 (L3 on, run 6)"), colors=(g.C["muted"], g.C["s1"]))
    sec23 = sec_f1_vs_run3()
    brows = [dict(label=f"OCM{r} from CPU 2 ({dist(2, NODE_OF_REGION[r])} xp)", a=g.OCMBW["region"][r], b=OCMBW1["region"][r]) for r in range(5)] + [dict(label="all five from CPU 2", a=g.OCMBW["all5"], b=OCMBW1["all5"]), dict(label="OCM1 to 4 from four CPUs", a=g.OCMBW["four"], b=OCMBW1["four"]), dict(label="streaming write, all five", a=g.OCMBW["write"], b=OCMBW1["write"])]
    f_ocmbw = dumbbell(brows, unit="GB/s", names=("run 3 (L3 off)", "boot F1 (L3 on, run 6)"), colors=(g.C["muted"], g.C["s1"]), xlim=(0, 90))
    crow = g.CMN4["ocm-region1-cpu2"]
    f_cmn = bars_h([dict(label=f"node {n} (OCM{NODES[n][2]})", v=crow["node"][n], color=g.C["s2"] if n == 160 else g.C["s1"]) for n in NODES], unit="requests")
    ratio_lo, ratio_hi = min(a["ratio"] for a in g.ATTR.values()), max(a["ratio"] for a in g.ATTR.values())

    # ---------------------------------------------------------------- numbers the text quotes
    PE, PC, PA, PB, PD = (p.PLATFORM[x] for x in "ECABD")
    g8_asm_hi = max(ASM16_24); g8_asm_lo = min(ASM16_24)
    read_resid = [v["resid_pct"] for (x, f, k), v in p.G8_FITS.items() if k == "read"]; write_resid = [v["resid_pct"] for (x, f, k), v in p.G8_FITS.items() if k == "write"]
    pf4 = {s: RV[("read-pf4", s)]["agg"] for s in p.RP_SIZES}
    walk_d = p.WALK_RATES["D"]
    gm = {k: v["gm"] for k, v in p.RATIOS.items()}
    n_e_route_below = sum(1 for d in p.ROUTES if d["E"]["l3"] < 0.8)
    g8_4k_spread = {x: 100 * (max(r4.G8[x][("per-pass", "read")]["rows"][4096]["reps"]) / min(r4.G8[x][("per-pass", "read")]["rows"][4096]["reps"]) - 1) for x in "CE"}   # % spread of the 5 reps
    mem_q = "message-to-jesse-round4.md"

    body = f"""
<div class="short"><p><b>Short version.</b> With the DSU L3 on (run 4 boot E), one core reads from its L1 in {lv(4096)['ns']:.1f} ns, from the L2 in {lv(131072)['ns']:.1f} ns, from an L3 hit in about {L3_EST:.0f} ns est., from the SLC in {lv(2097152, 'fresh')['ns']:.1f} ns and from DRAM in {FLUSHED_E:.1f} ns (every line flushed). One core reads DRAM at {E_PLAIN[33554432]:.1f} GB/s with the L3 on, against {C_PLAIN[33554432]:.1f} GB/s with it off (boot C, the same build). Tables 4.4 to 4.6 and section 9 give run 6 boot F1's values (the L3 on) beside run 3's (the L3 off); section 8 is run 3's only.</p></div>
<ul>
<li><b>The L3 step.</b> Runs 1 to 3 and boots A to D measured with the L3 of CPUs 2 to 9 holding no data (register 0x0, 0 L3 hits per load). Boot E's rebuilt SCP turns it on (register {PE['pwrstat'][0]}). The 192, 256 and 384 KiB chases (the hit-set rows) then read {HIT[196608]['ns']:.1f}, {HIT[262144]['ns']:.1f} and {HIT[393216]['ns']:.1f} ns with {100 * HIT[196608]['l3_hit']:.0f}, {100 * HIT[262144]['l3_hit']:.0f} and {100 * HIT[393216]['l3_hit']:.0f} % L3 hits per load, against {HIT[196608]['nsC']:.1f}, {HIT[262144]['nsC']:.1f} and {HIT[393216]['nsC']:.1f} ns on boot C (section 5).</li>
<li><b>Repeatability.</b> Of the {len(p.REPEAT_E3)} rows boot E and run 3 share, {p.N_WITHIN_E3[1]} agree within 1 % and {p.N_WITHIN_E3[5]} within 5 %. The rows that moved most are the L3 rows ({p.REPEAT_E3[0]['pct']:+.1f} % at {kib(p.REPEAT_E3[0]['size'])}) and the per-region OCM rows. Boot A against run 3, the same configuration, agrees within 1 % on {p.N_WITHIN_A3[1]} of {len(p.REPEAT_A3)} rows (section 4.8).</li>
<li><b>OCM.</b> The dense all-five chain from CPU 2 reads {p.ALL5[2]['E']['dense']:.2f} ns on boot E (run 3 {p.ALL5[2]['run3']['dense']:.2f}, boot A {p.ALL5[2]['A']['dense']:.2f}, boot C {p.ALL5[2]['C']['dense']:.2f}) with one L3 read refill per load. That is the OCM number to quote. On boot E only {p.ROUTE_L3_RNG['E'][0]:.2f} to {p.ROUTE_L3_RNG['E'][1]:.2f} of the loads in the per-region route rows are read from the mesh (L3 read refills per load). The other loads are served by the L3, so those rows are below the true OCM latency (section 6).</li>
<li><b>Run 6 boot F1 (the L3 on, 2026-11-06) ran run 3's whole command set.</b> The bandwidth rows with the L3 on: one core reads {ONE1[33554432]['read']:.1f} GB/s at 32 MiB (run 3 {ONE[33554432]['read']:.1f}), four cores on four DSUs read {_m3(_rd(4, 16777216)):.1f} GB/s together at 16 MiB each (run 3 {_rd(4, 16777216)['run3']:.1f}) and eight cores {_m3(_rd(8, 16777216)):.1f} (run 3 {_rd(8, 16777216)['run3']:.1f}); every write row of 2 MiB and above repeats run 3 within {max(abs(_m3(d) / d['run3'] - 1) * 100 for d in g.PAIR + g.PERDSU + g.ALL8 if d['kernel'] == 'write' and d['size'] >= 2097152):.1f} %, and the pair's 160 KiB write rises {100 * (PAIR_W_SMALL[163840] - 1):.0f} % (sections 7 and 9). One core reads an OCM region at {min(OCMBW1['region']):.1f} to {max(OCMBW1['region']):.1f} GB/s (run 3 {min(g.OCMBW['region']):.1f} to {max(g.OCMBW['region']):.1f}) and the OCM write stays at {OCMBW1['write']:.1f} (section 10). The memory model's delay is answered (section 2.2).</li>
<li><b>Bandwidth (boot E).</b> One core reads DRAM at {E_PLAIN[2097152]:.1f} GB/s (2 MiB) and {E_PLAIN[33554432]:.1f} GB/s (32 MiB) with the L3 on. In one assembly call the L1 reads {g8_asm_lo:.1f} to {g8_asm_hi:.1f} GB/s at 16 and 24 KiB, {100 * g8_asm_hi / READ_PATH:.0f} % of the {READ_PATH:.0f} GB/s read path, and writes fit the {WRITE_PATH:.0f} GB/s write path (section 7). Eight cores wrote {max(d['run3'] for d in g.ALL8 if d['kernel'] == 'write'):.0f} GB/s and one core read OCM at {min(g.OCMBW['region']):.1f} to {max(g.OCMBW['region']):.1f} GB/s per region on run 3, the L3 off (sections 9 and 10).</li>
</ul>

<h2 id="words">1. Words used here</h2>
{words(p.words_core())}

<h2 id="run">2. The run and the platform</h2>
<ul>
<li><b>Where and when.</b> Run 4 boot E ran on one emulated Asimov hemisphere on the GA13 Palladium (image hemi_rtws_tlm, RTL 0d9e214, release a10280100) on {PE['date']} UTC as one job: run_followup.sh at cache-mem-perf commit {PE['commit']}. {PE['chip_s']:.3f} s of chip time, {PE['commands']} commands, all exit 0 ({p.E['FAILED']} failed), 113 files back with matching checksums [Jesse's boot E README, Read first and The run].</li>
<li><b>Platform.</b> Boot A's, with one change: the SCP rebuilt as {PE['scp']} to stage the full-L3 operating mode (all slices, the whole L3 RAM open) for the clusters of CPUs 2 to 9 before they power on. The stock SCP stages it for cluster 0 only, so on runs 1 to 3 and boots A to D the L3 of CPUs 2 to 9 held no data. TF-A {PE['tfa']}, Linux 6.18.36, 256 huge pages of 2 MiB, /dev/ocm in 4 KiB pages ({len(p.E['MAPS'])} mappings, none with the contiguous hint), CPUs 2 to 9 isolated, CPU 3 offline for the whole script, the data prefetchers on. IMP_CLUSTERPWRSTAT_EL1 read {PE['pwrstat'][0]} before and {PE['pwrstat'][1]} after the hit-set command: the full-RAM encoding. That reading covers CPU 2's cluster only [Jesse's boot E README, The SCP and L3 power]. DRAM is an emulator memory, not LPDDR5X, so no DRAM number is silicon-like [the same README, DRAM caveat].</li>
<li><b>Counters.</b> The PMU driver reports {p.E['PMU_COUNTERS']} counters, so no group of six events was multiplexed: every counted row reads perf_cov 1.0000 ({len(p.E['COV_ROWS'])} latency rows and {p.BW_COV_ROWS_E} bandwidth rows) and no row carries a "# perf:" flag.</li>
<li><b>Controls.</b> The 4 KiB repeated chase reads {p.CONTROLS['E']['p4k']:.3f} ns ({p.CONTROLS['E']['p4k_cyc']:.2f} cycles) on boot E, {p.CONTROLS['run3']['p4k']:.3f} on run 3 and {min(p.CONTROLS[x]['p4k'] for x in p.BOOTS):.3f} to {max(p.CONTROLS[x]['p4k'] for x in p.BOOTS):.3f} on the five boots. The CME round trip reads {min(p.CONTROLS[x]['rt'][0] for x in p.BOOTS):.3f} to {max(p.CONTROLS[x]['rt'][1] for x in p.BOOTS):.3f} ns on every boot (run 3: {p.CONTROLS['run3']['rt'][0]:.3f} to {p.CONTROLS['run3']['rt'][1]:.3f}). The two uncounted 4 KiB controls read {p.CONTROLS['E']['ctrl'][2]:.3f} ns (CPU 2) and {p.CONTROLS['E']['ctrl'][8]:.3f} ns (CPU 8) on boot E [latency-dram-small.csv, cme-latency-*.csv, latency-control-cpu*.csv].</li>
<li><b>Run 3,</b> whose rows stay on this page where run 4 did not repeat them: membench-jibin-{p.RUN3['run_id']}, commit {p.RUN3['commit']}, SCP {p.RUN3['scp']}, TF-A {p.RUN3['tfa']}, {p.RUN3['date']}, {p.RUN3['chip_s']:.3f} s of chip time, {p.RUN3['commands']} commands, {p.RUN3['files']} CSV files, the L3 holding no data [Jesse's run 3 README].</li>
</ul>
<p><b>The five boots of run 4.</b> Each boot is one job with one firmware and program configuration. Boot C is the comparison that isolates the L3: the same commit and build as E with the L3 off. Boot A is the configuration closest to run 3. Boots B and D have the data prefetchers off.</p>
{t12}

<h3 id="changes">2.1 What changed from run 3 to run 4 boot E</h3>
<ul>
<li><b>The code</b> went from commit {p.RUN3['commit']} to {PE['commit']}. The latency program gained the prefetch, TLB, walk and hit events, the sequential chain, the route rows and the vary chain. The bandwidth program gained the read variants and the G8 rows. The flags of every repeated row are unchanged, so a repeated row's numbers compare [Jesse's boot E README, Against boot C; follow-up-run-plan.md].</li>
<li><b>The firmware.</b> One firmware component changed: the SCP, rebuilt to stage the full L3 for the clusters of CPUs 2 to 9. TF-A, the kernel and the OCM mapping are run 3's. So the L3 is the one platform difference between run 3's rows and boot E's, beside the run-to-run noise that boot A against run 3 measures (section 4.8).</li>
<li><b>Rows dropped.</b> The bandwidth set (the one-core sweep, multi-core DRAM, writer placement, OCM bandwidth) and the OCM, SLC and control rows of CPUs 4 and 6 did not run on run 4. Their numbers on this page are run 3's and are labelled so.</li>
<li><b>Rows added.</b> The L3 hit set (64 KiB to 512 KiB), the sequential 8 MiB chain, the one-core read variants at 2 MiB and 32 MiB, the G8 L1 rows, the TLB-set and walk rows of CPU 2, and the 20 route rows under the crosspoint counters.</li>
<li><b>Size.</b> Run 3 ran {p.RUN3['commands']} commands in {p.RUN3['chip_s']:.3f} s of chip time. Boot E ran {PE['commands']} commands in {PE['chip_s']:.3f} s [Jesse's READMEs of 004 and 010].</li>
</ul>

<h3 id="run6">2.2 Run 6 boot F1: run 3's command set with the L3 on</h3>
<ul>
<li><b>The boot.</b> membench-jibin-{F1['run_id']}, {F1['date']} UTC, commit {F1['commit']} (five commits on {PE['commit']}: the CME rows (the CME is the cluster's C1-SME2 streaming unit, one per DSU; its rows are on asimov-cme-perf.html) gain in-span timing (a second clock pair read inside the streaming-mode span) and the single-call forms, the core rows are run 3's command lines byte for byte) on boot E's firmware (SCP {F1['scp']}, TF-A {F1['tfa']}, the kernel and the /dev/ocm module byte for byte). The whole run_all.sh: {F1['commands']} commands, all exit 0, {F1['chip_s']:.3f} s of chip time, {F1['cov_rows']} counted rows all perf_cov 1.0000. IMP_CLUSTERPWRSTAT_EL1 read {F1['pwrstat'][0]} on CPU 2's cluster before and after the first CME L3-event command [Jesse's F1 README, Read first; log.txt of 011, lines 146 and 148]. Its CME rows are on asimov-cme-perf.html.</li>
<li><b>Controls and repeats.</b> The 4 KiB chain reads {p.CONTROLS['F1']['p4k']:.3f} ns ({p.CONTROLS['F1']['p4k_cyc']:.2f} cycles) and the uncounted controls {p.CONTROLS['F1']['ctrl'][2]:.3f} ns on CPU 2 and {p.CONTROLS['F1']['ctrl'][8]:.3f} on CPU 8. CPU 2's chains repeat boot E: {lv(196608)['ns']:.3f} / {lv(262144)['ns']:.3f} / {lv(393216)['ns']:.3f} ns at 192 / 256 / 384 KiB on E, {next(d['ns'] for d in K1['LV'] if d['size'] == 196608 and d['kind'] == 'repeat'):.3f} / {next(d['ns'] for d in K1['LV'] if d['size'] == 262144 and d['kind'] == 'repeat'):.3f} / {next(d['ns'] for d in K1['LV'] if d['size'] == 393216 and d['kind'] == 'repeat'):.3f} on F1; the L1 and L2 chains (4 to 128 KiB) hold within {F1_DEV['l1l2']:.1f} % of run 3, the DRAM chains from 6 to 32 MiB within {F1_DEV['dram']:.1f} %, the flushed row within {F1_DEV['flushed']:.1f} % and the one-core writes within {F1_DEV['writes']:.1f} %; the 4 MiB chain reads {F1_DEV['m4']:.1f} % above run 3 and the 512 KiB to 1 MiB chains {F1_DEV['l3'][0]:.2f} to {F1_DEV['l3'][1]:.2f} times it (the L3) [latency-dram-*.csv and bandwidth-dram-1core.csv of 011 and 004; Jesse's F1 README, Core rows].</li>
<li><b>What F1 adds to this page.</b> The one-core sweep, the multi-core DRAM rows, the writer-placement rows and the OCM bandwidth rows with the L3 on (tables 4.3 to 4.6, sections 7, 9 and 10), the sparse and all-five OCM chains from CPUs 4 and 6 (table 4.2), and the home-node counts around the same commands (table 4.7, section 11). F1's 2 MiB SLC chains from CPUs 4, 6 and 8 ({K1['SLC'][4]['best']:.1f}, {K1['SLC'][6]['best']:.1f} and {K1['SLC'][8]['best']:.1f} ns, run 3 {g.SLC[4]['best']:.1f}, {g.SLC[6]['best']:.1f} and {g.SLC[8]['best']:.1f}) are quoted here only [latency-dram-slc-cpu&lt;c&gt;.csv of 011 and 004].</li>
<li><b>The memory model's delay, answered.</b> The AP's DRAM (AP: the application processor, the Arm cores' side of the chip) is four Cadence AXI memory models (AXI: an Arm bus protocol), one per SMS lane (the four memory lanes that serve the AP), with every delay control at zero (read latency, write response, READY delays, burst gaps; no bandwidth or refresh scheduler). Even at zero the model answers 3 ns after it accepts a read. By Jesse's count of the RTL stages (RTL: the chip's hardware source; an inference, not a measurement) about 20 ns of the DRAM leg is fixed pipeline between the mesh's SN bridges (the SBSX nodes that connect the mesh to memory) and the memory, and the rest is inside the mesh. Nothing on the path models banks, rows or refresh, so the delay does not depend on address order, which is what boot B's address-order and random 8 MiB chains showed ({p.DRAM_MODEL['seq_B']:.3f} against {p.DRAM_MODEL['random_B']:.3f} ns, section 5) [Jesse's F1 README, The memory model behind the home node].</li>
</ul>
{sec23}
<h2 id="map">3. The hemisphere map</h2>
<p>The left column is the path one load takes from CPU 2 outward (cluster caches, then the mesh to the home node, with DRAM behind it), with boot E's chase time at the footprint that reads from each level. The grid is the mesh as the kernel's debugfs map prints it [sysinfo.txt, "arm-cmn mesh map"], with the five home nodes and the five DSU ports on their crosspoints. The dashed paths run from CPU 2's port to each OCM home node, horizontal first (a simplification: the real route is the mesh's choice). The label under each home node is CPU 2's best dense chase of that region on boot E (the route row, table 4.2).</p>
{fig(f_map, f"From CPU 2 on boot E, a dense OCM chase reads {min(d['E']['best'] for d in p.ROUTES if d['cpu'] == 2):.1f} to {max(d['E']['best'] for d in p.ROUTES if d['cpu'] == 2):.1f} ns by region, the SLC {lv(2097152, 'fresh')['ns']:.1f} ns and flushed DRAM {FLUSHED_E:.1f} ns.", f"The L3 box is new on this boot: on runs 1 to 3 it held no data. Hover a box or a dot for its details. The crosspoint of each box comes from the node ids and was checked against the map text by this script [sysinfo.txt].")}

