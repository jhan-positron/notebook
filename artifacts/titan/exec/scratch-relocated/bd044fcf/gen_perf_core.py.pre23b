           ("tables", "4. Summary tables", [("t41", "4.1 Latency by level"), ("t42", "4.2 OCM latency by region"), ("t43", "4.3 One-core bandwidth by footprint"), ("t44", "4.4 Multi-core DRAM bandwidth"),
