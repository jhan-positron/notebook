+class HemiAuxTimingWindow(unittest.TestCase):
+    """A Linux boot on an image with timed AUX lanes needs the caller's window.
+
+    The default window was measured with untimed AP system DRAM, and a build
+    with HEMI_GC_AUX_TIMING lands in the same directory as the default image.
+    """
+    TIMED = 'defines:  CMN_RESET_FULL_SEQ GC_BEHAV HEMI_GC_AUX_TIMING\n'
+    UNTIMED = 'defines:  CMN_RESET_FULL_SEQ GC_BEHAV\n'
+
+    def before_build(self, args):
+        return shell(LINUX_FIXTURE + PARSERS['run_emu.sh'] + LINUX_WINDOW
+                     + '\nprintf "BUILD_STARTS\\n"\n', args)
+
+    def before_launch(self, args, manifest):
+        with tempfile.TemporaryDirectory(prefix='hemi-aux-manifest-') as directory:
+            Path(directory, 'MANIFEST').write_text(manifest)
+            source = (f"BUILD_DIR={shlex.quote(directory)}; BUILD_CMD='fixture-build --build'\n"
+                      + LINUX_FIXTURE + PARSERS['run_emu.sh'] + LINUX_WINDOW
+                      + MANIFEST_CHECKS['run_emu.sh']
+                      + '\nprintf "LAUNCH %s\\n" "$RUN_CYCLES"\n')
+            return shell(source, args)
+
+    def assert_launched(self, result, cycles):
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn(f'LAUNCH {cycles}', result.stdout)
+
+    def assert_rejected(self, result, marker):
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertNotIn(marker, result.stdout)
+        self.assertIn('HEMI_GC_AUX_TIMING', result.stderr)
+        self.assertIn('explicit --run-cycles', result.stderr)
+
+    def test_timed_image_needs_an_explicit_window(self):
+        # No phase flag reuses the image and elaborates; --run-only reuses the snapshot.
+        for phase in ((), ('--run-only',)):
+            with self.subTest(phase=phase):
+                self.assert_launched(self.before_launch(phase, self.UNTIMED), DEFAULT_WINDOW)
+                self.assert_rejected(self.before_launch(phase, self.TIMED), 'LAUNCH')
+                self.assert_launched(
+                    self.before_launch((*phase, '--run-cycles', '1600000000'), self.TIMED),
+                    '1600000000')
+
+    def test_only_the_complete_define_marks_a_timed_image(self):
+        for defines, timed in (('HEMI_GC_AUX_TIMING=1 OTHER', True),
+                               ('OTHER\tHEMI_GC_AUX_TIMING', True),
+                               ('HEMI_GC_AUX_TIMING_EXTRA', False),
+                               ('OTHER_HEMI_GC_AUX_TIMING', False)):
+            with self.subTest(defines=defines):
+                result = self.before_launch((), f'defines: {defines}\n')
+                if timed:
+                    self.assert_rejected(result, 'LAUNCH')
+                else:
+                    self.assert_launched(result, DEFAULT_WINDOW)
+
+    def test_timed_build_without_a_window_stops_before_the_build(self):
+        build = ('--build', '--define', 'HEMI_GC_AUX_TIMING')
+        self.assert_rejected(self.before_build(build), 'BUILD_STARTS')
+        for extra in (('--run-cycles', '1600000000'), ('--build-only',)):
+            with self.subTest(extra=extra):
+                result = self.before_build((*build, *extra))
+                self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                self.assertIn('BUILD_STARTS', result.stdout)
+        # The image of a finished build is checked again before the launch.
+        self.assert_rejected(self.before_launch(('--build',), self.TIMED), 'LAUNCH')
+
+    def test_dispatch_tells_the_remote_who_chose_the_window(self):
+        # The dispatch always forwards --run-cycles; two hops cover a re-dispatch.
+        for args, allowed in (((), False), (('--run-cycles', '1600000000'), True)):
+            with self.subTest(args=args):
+                for _ in range(2):
+                    source = (LINUX_FIXTURE + PARSERS['run_emu.sh'] + LINUX_WINDOW
+                              + RUN_CYCLES_DISPATCH + '\nprintf "%s\\n" "$run_cycles_flags"\n')
+                    result = shell(source, args)
+                    self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+                    args = tuple(shlex.split(result.stdout.splitlines()[-1]))
+                    self.assertIn('--run-cycles', args)
+                    remote = self.before_launch(args, self.TIMED)
+                    if allowed:
+                        self.assert_launched(remote, '1600000000')
+                    else:
+                        self.assert_rejected(remote, 'LAUNCH')
+                    self.assert_launched(self.before_launch(args, self.UNTIMED),
+                                         args[args.index('--run-cycles') + 1])
+
+
 if __name__ == '__main__':
     unittest.main()
