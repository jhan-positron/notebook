+// PDJN dispatch-latency probe. When TRON_TXLAT_FILE is set, accumulate per-device
+// per-component latency aggregates (count/sum/max + log2 histogram of TSC deltas)
+// for the host->device dispatch path, dumped once at process exit:
+//   slot  = tx_wait_for_slots wait on act_slots_free
+//   cmd   = wait on mm_in_flight
+//   wcmd  = wait on wcmd FIFO words
+//   launch= tx_launch body (ring writes + doorbell)
+//   devlat= tx_launch end -> RX completion (device execute + completion path)
+// TX accumulators are written only by the device's TX thread, devlat only by its
+// RX thread; no synchronization needed. Off = one cached null check per call.
+namespace txlat {
+constexpr int kSlot = 0, kCmd = 1, kWcmd = 2, kLaunch = 3, kDevlat = 4;
+struct comp_agg {
+  uint64_t n, sum, mx;
+  uint64_t hist[40];
+};
+struct state_t {
+  comp_agg agg[8][5];
+  uint64_t t_launch_end[8][4096];
+  uint64_t rid[8][4096];
+};
+inline state_t* state() noexcept {
+  static state_t* s = [racy = 0]() -> state_t* {
+    (void)racy;
+    const char* p = std::getenv("TRON_TXLAT_FILE");
+    if (!p) return nullptr;
+    auto* st = new state_t();
+    static const char* path = p;
+    std::atexit([] {
+      FILE* f = std::fopen(path, "a");
+      if (!f) return;
+      static const char* names[5] = {"slot", "cmd", "wcmd", "launch", "devlat"};
+      state_t* st2 = state();
+      for (int d = 0; d < 8; ++d)
+        for (int c = 0; c < 5; ++c) {
+          comp_agg& a = st2->agg[d][c];
+          if (!a.n) continue;
+          std::fprintf(f, "dev%d %s n=%llu sum=%llu max=%llu hist=", d, names[c],
+              (unsigned long long)a.n, (unsigned long long)a.sum,
+              (unsigned long long)a.mx);
+          for (int b = 0; b < 40; ++b)
+            std::fprintf(f, "%s%llu", b ? "," : "", (unsigned long long)a.hist[b]);
+          std::fprintf(f, "\n");
+        }
+      std::fclose(f);
+    });
+    return st;
+  }();
+  return s;
+}
+inline void add(int dev, int comp, uint64_t dt) noexcept {
+  state_t* s = state();
+  if (!s || dev < 0 || dev >= 8) return;
+  comp_agg& a = s->agg[dev][comp];
+  ++a.n;
+  a.sum += dt;
+  if (dt > a.mx) a.mx = dt;
+  int b = 0;
+  while (dt > 1 && b < 39) { dt >>= 1; ++b; }
+  ++a.hist[b];
+}
