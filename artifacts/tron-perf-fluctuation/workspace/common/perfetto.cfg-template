duration_ms: 25000
# Stream the trace to disk during capture. Without this the whole buffer is
# drained over the consumer socket after the window ends, and the perfetto
# client's fixed 60 s drain budget cannot move this workload's trace volume
# (>500 MB) — the file gets truncated to driver-only slices.
write_into_file: true
file_write_period_ms: 2000
buffers { size_kb: 2097152 fill_policy: RING_BUFFER }

# The SDK names the producer after argv[0], so it registers as a bare name
# or a full path depending on how it was launched; list both so the
# override matches either way. Non-matching entries are ignored.
producers { producer_name: "runtron" shm_size_kb: 32768 }
producers { producer_name: "<full path to runtron>" shm_size_kb: 32768 }

incremental_state_config { clear_period_ms: 5000 }
data_sources {
  config {
    name: "track_event"
    target_buffer: 0
    track_event_config {
      enabled_categories: "scheduler"
      enabled_categories: "model"

# "matmul" seems having no event
#      enabled_categories: "matmul"

      enabled_categories: "driver"

# "sys" enables malloc counter; need SIGUSR1 to enable malloc_tracing_enabled
      enabled_categories: "sys"

#      enabled_categories: "hwattention"
#      enabled_categories: "hwattention-detail"
#      enabled_categories: "loading"
#      enabled_categories: "rinzler"


# uncomment ddriver-detail if needed
#      enabled_categories: "driver-detail"

# "gen" seems having no event
#      enabled_categories: "gen"

      disabled_categories: "*"
    }
  }
}

# Optional linux.perf CPU-sampling source. COMMENTED OUT: uncomment the block
# below to enable. Corrected structure, parse-tested against tracebox v57.2 on
# delphi-3bda 2026-08-14. Notes from that check:
#   - Each data source needs its OWN data_sources { config { ... } } wrapper;
#     a second config {} inside one data_sources block is a parse error.
#   - Text-proto takes decimal only (0x02 is a parse error).
#   - RawEvent has no pmu_name field; a PMU is addressed by numeric type: from
#     /sys/bus/event_source/devices/<pmu>/type.
#   - Timebase has no poll_period_ms; the read cadence knob is
#     ring_buffer_read_period_ms at the perf_event_config level.
#   - The original goal (RAPL energy-pkg via followers) is NOT possible on
#     delphi-3bda: no "power" PMU exists under /sys/bus/event_source/devices/.
#     Package energy comes from /sys/class/powercap/intel-rapl:0/energy_uj
#     (harness RAPLCAP=1) or the msrsamp tool instead.
#data_sources {
#  config {
#    name: "linux.perf"
#    perf_event_config {
#      timebase { counter: SW_CPU_CLOCK frequency: 100 }
#      ring_buffer_read_period_ms: 500
#    }
#  }
#}

# Optional per-CPU frequency polling (commented out; uncomment to enable).
# Purpose: see CPU frequency drops on the trace timeline, aligned with the
# model/driver spans. Parse-tested against tracebox v57.2 on delphi-3bda
# 2026-08-14. Under intel_pstate (3bda), scaling_cur_freq is the EFFECTIVE
# frequency derived from APERF/MPERF - the right "did it slow down" signal;
# the ftrace power/cpu_frequency tracepoint is unreliable under HWP.
# Frequency alone does not say WHY. For power-vs-thermal attribution, launch
# the campaign harness (deepdive-campaign.sh) with its knobs THROTTLELOG=1
# (harness reads/clears MSR 0x19C + 0x64F MSR_CORE_PERF_LIMIT_REASONS around
# each draw -> $out/throttle.txt) and RAPLCAP=1 (harness snapshots package
# energy via /sys/class/powercap -> $out/rapl.txt; the RAPL perf PMU is absent
# on 3bda's kernel). These are HARNESS env knobs on the harness.sh launch
# line, NOT runtron environment variables - runtron never sees them.
#data_sources {
#  config {
#    name: "linux.sys_stats"
#    sys_stats_config {
#      cpufreq_period_ms: 100
#    }
#  }
#}

