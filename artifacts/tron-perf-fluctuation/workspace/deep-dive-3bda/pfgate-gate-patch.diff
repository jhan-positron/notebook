     // Note [Plugin-owned worker launch].)
     void finalize_minibatches() {
       TRACE_EVENT("model", "finalize_minibatches");
+      // pfgate: defensive CLOSE — a parse batch (items.size() > 8) must not
+      // run with the window gate left open by a preceding decode step whose
+      // layer-0 close (decode-conditioned) never fired.
+      for (auto& q_batch : q_batches)
+        if (q_batch->items.size() > 8) {
+          trace_gate_set(false);
