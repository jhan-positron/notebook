diff --git a/h/tron/models/self_attention.hpp b/h/tron/models/self_attention.hpp
index 4b2a2cd83..d547cb419 100644
--- a/h/tron/models/self_attention.hpp
+++ b/h/tron/models/self_attention.hpp
@@ -12,6 +12,7 @@
 
 #include "common/assert.hpp"
 #include "common/numerics/fp16.hpp"
+#include "common/trace_gate.hpp"
 #include "common/util.hpp"
 #include "libpos.hpp"
 #include "spdlog/spdlog.h"
@@ -839,6 +840,11 @@ struct self_attention {
       const model_layer_id layer = binding.model_layer;
       uint64_t attn_elapsed = 0;
 
+      // pfgate: CLOSE the inter-fwd-pass trace window at the entry of the
+      // next step's first attention op. Decode batches only (items.size()
+      // <= 8); redundant stores across attention workers are harmless.
+      if (layer.i == 0 && outer_batch->items.size() <= 8) trace_gate_set(false);
+
       query_channel.start_reading(worker_ix);
       // One token is enough to wait on the fallback latch.
       query_channel.start_reading_at(0);
@@ -879,6 +885,11 @@ struct self_attention {
 
       // Sync all the attention workers so worker 0 measures the whole operation.
       outer_batch->attn_done_barrier.arrive_and_wait(n_attn_workers);
+      // pfgate: OPEN the inter-fwd-pass trace window at the end of the last
+      // layer's attention. Decode batches only; see CLOSE at layer-0 entry
+      // above and the defensive close in model.hpp finalize_minibatches.
+      if (layer.i + 1 == n_layers && outer_batch->items.size() <= 8)
+        trace_gate_set(true);
       attn_elapsed += hardware::system::rdtsc();
       return attn_elapsed;
     }
