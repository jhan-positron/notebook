# Auto-start SSH Agent
if [ -z "$SSH_AUTH_SOCK" ]; then
   export SSH_AUTH_SOCK="/tmp/ssh-agent-$(id -u).sock"
   ssh-add -l >/dev/null 2>&1
   if [ $? -eq 2 ]; then                 # 2 = no agent listening on that socket
      rm -f "$SSH_AUTH_SOCK"
      ssh-agent -a "$SSH_AUTH_SOCK" >/dev/null
      ssh-add ~/.ssh/id_ed25519 2>/dev/null
   fi
fi

export CODEX_HOME="$HOME/codex-home-${HOSTNAME}"
# Shared across hosts: keep existing containers working until each one is
# recreated with its Codex volume mounted at the new home-directory path.
if [[ "$HOSTNAME" == claude-* ]] &&
   mountpoint -q "/home/codex-home-${HOSTNAME}" &&
   ! mountpoint -q "$CODEX_HOME"; then
    export CODEX_HOME="/home/codex-home-${HOSTNAME}"
fi
# Keep sessions and databases per host, but install skills in shared storage.
if [[ "$(readlink "$CODEX_HOME/skills" 2>/dev/null)" != "$HOME/.codex/skills" ]]; then
    if ! python3 "$HOME/.local/bin/codex-share-skills" \
        --codex-home "$CODEX_HOME" --shared "$HOME/.codex/skills" --apply >/dev/null; then
        printf '%s\n' 'Could not link shared Codex skills; existing skills were preserved.' >&2
    fi
fi

export PATH="$HOME/.local/bin:$PATH"
